
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Finance Tracker</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/category.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/budget.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />  
    <link rel="stylesheet" href="~/css/transaction.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />



    @await RenderSectionAsync("Styles", required: false)

</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-wallet2 me-2"></i>Finance Tracker
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav"
                        aria-controls="navbarNav"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center" id="navbarLinks">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill me-1"></i>Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="AuthPage" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-primary ms-lg-2"
                               asp-controller="AuthPage"
                               asp-action="Register">
                                <i class="bi bi-person-plus-fill me-1"></i>Register
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        <div class="page-content">
            @RenderBody()
        </div>
    </main>
    <footer>
        <div class="container">
            <i class="bi bi-c-circle"></i>
            <span>2026 Finance Tracker</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            document.addEventListener("DOMContentLoaded", () => {
                const token = localStorage.getItem("token");
                const navbar = document.getElementById("navbarLinks");

                if (!token || !navbar) return;

                navbar.innerHTML = `
                            <li class="nav-item">
                                <a class="nav-link" href="/Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/TransactionPage">
                                    <i class="bi bi-receipt me-1"></i>Transactions
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/CategoryPage">
                                    <i class="bi bi-tags-fill me-1"></i>Categories
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/BudgetPage">
                                    <i class="bi bi-piggy-bank me-1"></i>Budgets
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Reports">
                                    <i class="bi bi-bar-chart-fill me-1"></i>Reports
                                </a>
                            </li>

                            <li class="nav-item">
                                    <button class="btn btn-primary ms-lg-2" onclick="logout()">
                                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                                </button>
                            </li>
                        `;
            });

function logout(){

    localStorage.removeItem("token");

    window.location.href="/";

}


</script>


<script src="~/js/authGuard.js"></script>

@await RenderSectionAsync("Scripts", required: false)


</body>
</html>
