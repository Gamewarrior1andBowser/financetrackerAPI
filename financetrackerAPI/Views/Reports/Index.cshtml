@{
    ViewData["Title"] = "Reports";
}

<div class="reports-page">

    <div class="page-heading">
        <div>
            <h1>
                <i class="bi bi-bar-chart-fill"></i>
                Financial Reports
            </h1>
            <p>Track your income, expenses, and spending patterns.</p>
        </div>
    </div>

    <div class="report-toolbar">
        <button class="toolbar-btn">
            <i class="bi bi-sliders"></i> Configure
        </button>
        <button class="toolbar-btn">
            <i class="bi bi-sort-down"></i> Sort
        </button>
        <button class="toolbar-btn">
            <i class="bi bi-funnel"></i> Filter
        </button>
        <button class="toolbar-btn">
            <i class="bi bi-palette"></i> Color
        </button>
    </div>

    <div class="summary-grid">
        <div class="summary-card">
            <div class="summary-label">TOTAL INCOME</div>
            <div id="totalIncome" class="summary-value income">$0.00</div>
            <div class="summary-change income">
                <i class="bi bi-arrow-up"></i> Income
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-label">TOTAL EXPENSES</div>
            <div id="totalExpenses" class="summary-value expense">$0.00</div>
            <div class="summary-change expense">
                <i class="bi bi-arrow-down"></i> Expenses
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-label">REMAINING BALANCE</div>
            <div id="remainingBalance" class="summary-value balance">$0.00</div>
            <div class="summary-change balance">Income minus expenses</div>
        </div>
    </div>

    <div class="charts-grid">

        <div class="report-card">
            <div class="report-card-header">
                <div>
                    <h5 class="report-card-title">Income vs Expenses</h5>
                    <div class="report-card-subtitle">
                        Compare your total income and spending
                    </div>
                </div>
                <i class="bi bi-three-dots"></i>
            </div>

            <div class="reports-chart-container">
                <canvas id="incomeExpenseChart"></canvas>
            </div>
        </div>

        <div class="report-card">
            <div class="report-card-header">
                <div>
                    <h5 class="report-card-title">Spending by Category</h5>
                    <div class="report-card-subtitle">
                        Where your money is going
                    </div>
                </div>
                <i class="bi bi-three-dots"></i>
            </div>

            <div class="category-chart-container">
                <canvas id="categoryChart"></canvas>
            </div>

            <div id="categoryList" class="category-list"></div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/reports.js"></script>
}