@{
    ViewData["Title"] = "Delete Category";
    var categoryID = ViewBag.catagoryID;
}

<div class="category-page">

    <div class="card category-delete-card">

        <h2>
            <i class="bi bi-trash-fill me-2"></i>
            Delete Category
        </h2>

        <p>
            This action cannot be undone. The category and its
            related data may also be removed.
        </p>

        <div class="category-delete-info">
            <div>
                <small>Category</small><br />
                <strong id="name">Loading...</strong>
            </div>

            <div class="mt-2">
                <small>Type</small><br />
                <strong id="type">—</strong>
            </div>
        </div>

        <div id="deleteError" class="category-error"></div>

        <div class="category-buttons">
            <button class="category-btn category-danger"
                    onclick="deleteCategory()">
                <i class="bi bi-trash me-1"></i>
                Delete Category
            </button>

            <a asp-controller="CategoryPage"
               asp-action="Index"
               class="category-btn category-secondary">
                Cancel
            </a>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        const token = localStorage.getItem("token");
        const id = @categoryID;
        const errorBox = document.getElementById("deleteError");

        async function loadCategory() {
            try {
                const response = await fetch(`/api/Category/${id}`, {
                    headers: { Authorization: "Bearer " + token }
                });

                if (!response.ok) throw new Error();

                const category = await response.json();

                document.getElementById("name").textContent = category.name;
                document.getElementById("type").textContent = category.type;
            }
            catch {
                errorBox.textContent = "Unable to load category.";
                errorBox.style.display = "block";
            }
        }

        async function deleteCategory() {
            const response = await fetch(`/api/Category/${id}`, {
                method: "DELETE",
                headers: { Authorization: "Bearer " + token }
            });

            if (response.ok) {
                window.location.href = "/CategoryPage";
                return;
            }

            errorBox.textContent = "Unable to delete category.";
            errorBox.style.display = "block";
        }

        loadCategory();
    </script>
}