@{
    ViewData["Title"] = "Create Category";
}


<div class="container">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow p-4">

                <h2 class="mb-4">
                    <i class="bi bi-plus-circle-fill me-2"></i>
                    Create Category
                </h2>


                <div class="mb-3">

                    <label class="form-label">
                        Category Name
                    </label>

                    <input id="name"
                           class="form-control"
                           placeholder="Enter category name" />

                </div>



                <div class="mb-4">

                    <label class="form-label">
                        Type
                    </label>


                    <select id="type"
                            class="form-select">

                        <option value="Income">
                            Income
                        </option>

                        <option value="Expense">
                            Expense
                        </option>

                    </select>

                </div>


<div class="mb-4">
    <label class="form-label" id="budgetLabel">Budget Limit</label>
    <input id="budgetLimit" type="number" class="form-control" placeholder="Enter budget limit" />
    <small class="form-text text-muted" id="budgetHelp"></small>
</div>

                <div class="d-flex gap-2">


                    <button class="btn btn-success"
                            onclick="createCategory()">

                        <i class="bi bi-check-circle me-1"></i>
                        Save

                    </button>



                    <a asp-controller="CategoryPage"
                       asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left-circle me-1"></i>
                        Back

                    </a>


                </div>


            </div>

        </div>

    </div>

</div>



@section Scripts {

<script>

async function createCategory()
{

    const token = localStorage.getItem("token");


    const category =
    {
        name: document.getElementById("name").value,
        type: document.getElementById("type").value
    };



    const response = await fetch("/api/Category",
    {

        method: "POST",

        headers:
        {
            "Content-Type": "application/json",
            "Authorization": "Bearer " + token
        },


        body: JSON.stringify(category)

    });



    if(response.ok)
{
    window.location.href = "/CategoryPage";
}
else
{
    const error = await response.text();

}

}







