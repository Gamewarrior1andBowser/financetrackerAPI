@{
    ViewData["Title"] = "Add Category";
}

<div class="category-page">

    <div class="card category-form">

        <h2>
            <i class="bi bi-plus-circle-fill"></i>
            Add Category
        </h2>

        <div class="mb-3">
            <label class="form-label">Category Name</label>
            <input id="name"
                   class="form-control"
                   type="text"
                   placeholder="e.g. Groceries" />
        </div>

        <div class="mb-3">
            <label class="form-label">Type</label>

            <select id="type" class="form-select">
                <option value="Expense">Expense</option>
                <option value="Income">Income</option>
            </select>
        </div>

        <div id="createError" class="category-error"></div>

        <div class="category-buttons">
            <button class="category-btn category-primary"
                    onclick="createCategory()">
                <i class="bi bi-check-lg me-1"></i> Save
            </button>

            <a asp-controller="CategoryPage"
               asp-action="Index"
               class="category-btn category-secondary">
                Cancel
            </a>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        const errorBox = document.getElementById("createError");

        // Try to make the names of the categories unique
        function showError(message) {
            errorBox.textContent = message;
            errorBox.style.display = "block";
        }

        async function createCategory() {
            const token = localStorage.getItem("token");
            const name = document.getElementById("name").value.trim();
            const type = document.getElementById("type").value;

            if (!token) {
                showError("Your session has expired. Please log in again.");
                return;
            }

            if (!name) {
                showError("Please enter a category name.");
                return;
            }

            try {
                const response = await fetch("/api/Category", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        Authorization: "Bearer " + token
                    },
                    body: JSON.stringify({ name, type })
                });

                if (!response.ok) {
                    showError("Unable to create category.");
                    return;
                }

                window.location.href = "/CategoryPage";
            }
            catch {
                showError("Unable to connect to the server.");
            }
        }
    </script>
}