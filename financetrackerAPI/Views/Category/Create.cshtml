function updateBudgetLabel() {
    const type = document.getElementById("type").value;
    document.getElementById("budgetHelp").textContent =
        type === "Income"
            ? "Maximum number of transactions allowed for this category."
            : "Maximum amount allowed (must be greater than 0).";
}
updateBudgetLabel();

async function createCategory() {
    const token = localStorage.getItem("token");
    const type = document.getElementById("type").value;
    const budgetLimit = parseInt(document.getElementById("budgetLimit").value);

    // Client-side validation since BudgetController does none
    if (type === "Expense" && budgetLimit <= 0) {
        alert("Budget limit must be greater than 0 for expense categories.");
        return;
    }
    if (type === "Income" && (isNaN(budgetLimit) || budgetLimit < 0)) {
        alert("Transaction limit must be a valid number, 0 or greater.");
        return;
    }

    const category = {
        name: document.getElementById("name").value,
        type: type
    };

    const catResponse = await fetch("/api/Category", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Authorization": "Bearer " + token },
        body: JSON.stringify(category)
    });

    if (!catResponse.ok) {
        alert(await catResponse.text());
        return;
    }

    const createdCategory = await catResponse.json();

    const budget = {
        categoryID: createdCategory.categoryID,
        limit: budgetLimit,
        date: new Date().toISOString()
    };

    const budgetResponse = await fetch("/api/Budget", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Authorization": "Bearer " + token },
        body: JSON.stringify(budget)
    });

    if (budgetResponse.ok) {
        window.location.href = "/CategoryPage";
    } else {
        alert("Category created, but budget failed: " + await budgetResponse.text());
    }
}
</script>

