@{
    ViewData["Title"] = "Categories";
}

<div class="category-page">

   
    <div class="category-header">
        <div>
            <h1>
                <i class="bi bi-tags-fill"></i>
                Categories
            </h1>
            <p class="category-subtitle">
                Manage your income and expense categories.
            </p>
        </div>

        <a asp-controller="CategoryPage"
           asp-action="Create"
           class="category-btn category-primary">
            <i class="bi bi-plus-lg"></i>
            Add Category
        </a>
    </div>

    <div class="card category-card">
        <div class="table-responsive">
            <table class="table category-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="categoryTable"></tbody>
            </table>
        </div>

        <div id="emptyState" class="category-empty">
            No categories found.
        </div>
    </div>
   

</div>

@section Scripts {
    <script src="~/js/authGuard.js"></script>

   
    <script>
        const token = localStorage.getItem("token");
        const table = document.getElementById("categoryTable");
        const empty = document.getElementById("emptyState");

        async function loadCategories() {
            try {
                const response = await fetch("/api/Category", {
                    headers: {
                        Authorization: "Bearer " + token
                    }
                });

                if (!response.ok) {
                    throw new Error();
                }

                const categories = await response.json();

                if (!categories.length) {
                    empty.style.display = "block";
                    return;
                }

                empty.style.display = "none";

                table.innerHTML = categories.map(category => `
                        <tr>
                            <td class="category-name">
                                ${category.name}
                            </td>

                            <td>
                                <span class="category-type ${category.type.toLowerCase()}">
                                    ${category.type}
                                </span>
                            </td>

                            <td>
                                <div class="category-actions">

                                    <a href="/CategoryPage/Details/${category.categoryID}"
                                       class="category-action category-view"
                                       title="View Category">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a href="/CategoryPage/Edit/${category.categoryID}"
                                       class="category-action category-edit"
                                       title="Edit Category">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a href="/CategoryPage/Delete/${category.categoryID}"
                                       class="category-action category-delete"
                                       title="Delete Category">
                                        <i class="bi bi-trash"></i>
                                    </a>

                                </div>
                            </td>
                        </tr>
                    `).join("");
            }
            catch {
                empty.textContent = "Unable to load categories.";
                empty.style.display = "block";
            }
        }

        loadCategories();
    </script>
    

}
