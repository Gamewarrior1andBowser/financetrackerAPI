@{
    ViewData["Title"] = "Categories";
}

<div class="category-page">

    <div class="category-header">
        <div>
            <h1 class="category-title">
                <i class="bi bi-tags-fill"></i> Categories
            </h1>

            <p class="category-description">
                Organize your income and expenses to better understand where your money goes.
            </p>
        </div>
    </div>


    <!-- HERO -->

    <section class="category-hero">

    <div class="category-hero-content">

        <span class="category-hero-label">
            <i class="bi bi-lightbulb-fill"></i>
            Why organize your finances?
        </span>

        <h2>Make Every Expense Easier to Understand</h2>

        <p>
            Categories turn individual transactions into meaningful groups.
            This helps you see your spending habits, manage your budget,
            and make better financial decisions.
        </p>

        <button class="category-hero-btn" onclick="showCreatePanel()">
            <i class="bi bi-plus-circle"></i> Create a Category
        </button>

    </div>

    <div class="category-hero-visual"></div>

</section>

    <!-- WHY CATEGORIES MATTER -->

    <section class="category-benefits">

        <div class="category-section-heading">

            <span>WHY CATEGORIES MATTER</span>

            <h2>Turn Transactions Into Useful Information</h2>

            <p>
                Organizing your transactions makes your financial activity
                easier to understand and manage.
            </p>

        </div>


        <div class="category-benefit-grid">

            <article class="category-benefit-card">

                <img src="~/images/categories/spending.jpg"
                     class="category-benefit-image"
                     alt="Understanding spending">

            
                <h3>Understand Spending</h3>

                <p>
                    Group similar expenses together so you can see where your
                    money is actually going.
                </p>

            </article>


            <article class="category-benefit-card">

                <img src="~/images/categories/budget.webp"
                     class="category-benefit-image"
                     alt="Budget planning">


                <h3>Budget Better</h3>

                <p>
                    Use categories to separate spending areas and make your
                    budget easier to plan and manage.
                </p>

            </article>


            <article class="category-benefit-card">

                <img src="~/images/categories/saving.webp"
                     class="category-benefit-image"
                     alt="Saving money">

               

                <h3>Find Ways to Save</h3>

                <p>
                    Recognize categories where spending may be higher than
                    expected and find opportunities to reduce costs.
                </p>

            </article>

        </div>

    </section>


    <!-- PROBLEM / SOLUTION -->

    <section class="category-problem">

        <div class="category-problem-icon">
            <i class="bi bi-question-circle-fill"></i>
        </div>

        <div class="category-problem-content">

            <span>THE PROBLEM WE SOLVE</span>

            <h2>Where Is Your Money Going?</h2>

            <p>
                Looking at a long list of transactions does not always make
                spending patterns obvious. Without organization, it can be
                difficult to identify which areas are taking up most of your
                money.
            </p>

        </div>


        <div class="category-solution">

            <div class="category-solution-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <div>

                <strong>Our Solution</strong>

                <p>
                    Categories organize related transactions together, making
                    your finances easier to understand and helping you make
                    more informed decisions.
                </p>

            </div>

        </div>

    </section>


    <!-- CATEGORY CONTENT -->

    <div class="category-content">

        <main class="category-main">

            <div id="categoryList" class="category-grid"></div>


            <div id="emptyCategory"
                 class="category-empty"
                 style="display:none;">

                <div class="category-empty-icon">
                    <i class="bi bi-tags-fill"></i>
                </div>

                <h3>No categories yet</h3>

                <p>
                    Create your first category to start organizing your transactions.
                </p>

                <button class="category-add-btn"
                        onclick="showCreatePanel()">

                    <i class="bi bi-plus-lg"></i>
                    Create Category

                </button>

            </div>


            <div id="categoryError"
                 class="category-error"
                 style="display:none;">

                Unable to load categories.

            </div>

        </main>


        <aside id="categoryPanel"
               class="category-panel">

            <div class="category-panel-header">

                <div>

                    <h2 id="panelTitle">Category</h2>

                    <p>Manage this category</p>

                </div>

                <button class="category-panel-close"
                        onclick="closePanel()">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <div id="panelContent"
                 class="category-panel-content">
            </div>

        </aside>

    </div>

</div>


@section Scripts {

    <script>

        const token = localStorage.getItem("token");

        const headers = {
            Authorization: "Bearer " + token
        };

        const categoryList = document.getElementById("categoryList");
        const emptyCategory = document.getElementById("emptyCategory");
        const categoryError = document.getElementById("categoryError");
        const categoryPanel = document.getElementById("categoryPanel");
        const panelTitle = document.getElementById("panelTitle");
        const panelContent = document.getElementById("panelContent");


        function escapeHtml(value) {

            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");

        }


        function openPanel(title, content) {

            panelTitle.innerHTML =
                `<i class="bi bi-tags-fill"></i> ${title}`;

            panelContent.innerHTML = content;

            categoryPanel.classList.add("open");

            setTimeout(() => {

                categoryPanel.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

            }, 100);

        }


        function closePanel() {

            categoryPanel.classList.remove("open");

        }


        async function loadCategories() {

            try {

                const response =
                    await fetch("/api/Category", { headers });

                if (!response.ok)
                    throw new Error();


                const categories = await response.json();


                if (!categories.length) {

                    categoryList.innerHTML = "";

                    emptyCategory.style.display = "block";

                    return;

                }


                emptyCategory.style.display = "none";


                categoryList.innerHTML =
                    categories.map(category => {

                        const name =
                            category.name || "Unnamed Category";

                        const type =
                            category.type || "Expense";

                        const typeClass =
                            type.toLowerCase();


                        return `

                            <article class="category-card">

                                <div class="category-card-body">

                                    <div class="category-card-icon ${typeClass}">
                                        <i class="bi bi-tag-fill"></i>
                                    </div>

                                    <h2>
                                        ${escapeHtml(name)}
                                    </h2>

                                    <div class="category-card-type">

                                        <span>Type</span>

                                        <strong class="${typeClass}">
                                            ${escapeHtml(type)}
                                        </strong>

                                    </div>

                                </div>


                                <div class="category-card-actions">

                                    <button
                                        class="category-card-btn category-view-btn"
                                        onclick="showDetails(${category.categoryID})">

                                        <i class="bi bi-eye"></i>
                                        View Details

                                    </button>


                                    <button
                                        class="category-card-btn category-edit-btn"
                                        onclick="showEditPanel(${category.categoryID})">

                                        <i class="bi bi-pencil"></i>
                                        Edit

                                    </button>


                                    <button
                                        class="category-card-btn category-delete-btn"
                                        onclick="showDeletePanel(${category.categoryID})">

                                        <i class="bi bi-trash"></i>
                                        Delete

                                    </button>

                                </div>

                            </article>

                        `;

                    }).join("");

            }
            catch {

                categoryError.style.display = "block";

            }

        }


        function showCreatePanel() {

            openPanel("Add Category", `

                <form id="createCategoryForm">

                    <div class="category-form-group">

                        <label>Category name</label>

                        <input
                            id="createName"
                            class="category-input"
                            placeholder="e.g. Groceries"
                            required>

                    </div>


                    <div class="category-form-group">

                        <label>Type</label>

                        <select
                            id="createType"
                            class="category-input">

                            <option value="Expense">
                                Expense
                            </option>

                            <option value="Income">
                                Income
                            </option>

                        </select>

                    </div>


                    <div id="createError"
                         class="category-panel-error"
                         style="display:none;">
                    </div>


                    <button class="category-panel-primary">

                        <i class="bi bi-check-circle"></i>
                        Save Category

                    </button>

                </form>

            `);


            document
                .getElementById("createCategoryForm")
                .addEventListener("submit", createCategory);

        }


        async function createCategory(event) {

            event.preventDefault();


            const name =
                document.getElementById("createName")
                    .value.trim();

            const type =
                document.getElementById("createType")
                    .value;

            const error =
                document.getElementById("createError");


            if (!name) {

                error.textContent =
                    "Enter a valid category name.";

                error.style.display = "block";

                return;

            }


            try {

                const response =
                    await fetch("/api/Category", {

                        method: "POST",

                        headers: {
                            ...headers,
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify({
                            name,
                            type
                        })

                    });


                if (!response.ok)
                    throw new Error();


                closePanel();

                loadCategories();

            }
            catch {

                error.textContent =
                    "Unable to create category.";

                error.style.display = "block";

            }

        }


        async function showDetails(id) {

            try {

                const categoryResponse =
                    await fetch(`/api/Category/${id}`, {
                        headers
                    });

                const transactionsResponse =
                    await fetch("/api/Transactions", {
                        headers
                    });


                if (!categoryResponse.ok)
                    throw new Error();


                const category =
                    await categoryResponse.json();

                const transactions =
                    transactionsResponse.ok
                        ? await transactionsResponse.json()
                        : [];


                const categoryTransactions =
                    transactions.filter(
                        t => t.categoryID == id
                    );


                const totalSpent =
                    categoryTransactions.reduce(
                        (sum, t) =>
                            sum + (Number(t.amount) || 0),
                        0
                    );


                const typeClass =
                    category.type?.toLowerCase() === "income"
                        ? "income"
                        : "expense";


                openPanel("Category Details", `

                    <div class="category-detail">

                        <div class="category-detail-icon ${typeClass}">
                            <i class="bi bi-tag-fill"></i>
                        </div>


                        <h3>
                            ${escapeHtml(category.name)}
                        </h3>


                        <div class="category-detail-block">

                            <span>Type</span>

                            <strong class="${typeClass}">
                                ${escapeHtml(category.type)}
                            </strong>

                        </div>


                        <div class="category-detail-block">

                            <span>Total Transactions</span>

                            <strong>
                                ${categoryTransactions.length}
                            </strong>

                        </div>


                        <div class="category-detail-block">

                            <span>Total Spent</span>

                            <strong>
                                $${totalSpent.toFixed(2)}
                            </strong>

                        </div>

                    </div>

                `);

            }
            catch {

                showPanelError(
                    "Category Details",
                    "Unable to load category details."
                );

            }

        }


        async function showEditPanel(id) {

            try {

                const response =
                    await fetch(`/api/Category/${id}`, {
                        headers
                    });


                if (!response.ok)
                    throw new Error();


                const category =
                    await response.json();


                openPanel("Edit Category", `

                    <form id="editCategoryForm">

                        <div class="category-form-group">

                            <label>Category name</label>

                            <input
                                id="editName"
                                class="category-input"
                                value="${escapeHtml(category.name)}"
                                required>

                        </div>


                        <div class="category-form-group">

                            <label>Type</label>

                            <select
                                id="editType"
                                class="category-input">

                                <option
                                    value="Expense"
                                    ${category.type === "Expense"
                                        ? "selected"
                                        : ""}>

                                    Expense

                                </option>

                                <option
                                    value="Income"
                                    ${category.type === "Income"
                                        ? "selected"
                                        : ""}>

                                    Income

                                </option>

                            </select>

                        </div>


                        <div id="editError"
                             class="category-panel-error"
                             style="display:none;">
                        </div>


                        <button class="category-panel-primary">

                            <i class="bi bi-save"></i>
                            Update Category

                        </button>

                    </form>

                `);


                document
                    .getElementById("editCategoryForm")
                    .addEventListener(
                        "submit",
                        e => updateCategory(e, id)
                    );

            }
            catch {

                showPanelError(
                    "Edit Category",
                    "Unable to load category."
                );

            }

        }


        async function updateCategory(event, id) {

            event.preventDefault();


            const name =
                document.getElementById("editName")
                    .value.trim();

            const type =
                document.getElementById("editType")
                    .value;

            const error =
                document.getElementById("editError");


            if (!name) {

                error.textContent =
                    "Enter a valid category name.";

                error.style.display = "block";

                return;

            }


            try {

                const response =
                    await fetch(`/api/Category/${id}`, {

                        method: "PUT",

                        headers: {
                            ...headers,
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify({
                            name,
                            type
                        })

                    });


                if (!response.ok)
                    throw new Error();


                closePanel();

                loadCategories();

            }
            catch {

                error.textContent =
                    "Unable to update category.";

                error.style.display = "block";

            }

        }


        function showDeletePanel(id) {

            openPanel("Delete Category", `

                <div class="category-delete-box">

                    <div class="category-delete-icon">
                        <i class="bi bi-trash-fill"></i>
                    </div>


                    <h3>Delete Category?</h3>


                    <p>
                        Are you sure you want to delete this category?
                        This action cannot be undone.
                    </p>


                    <div class="category-delete-actions">

                        <button
                            class="category-panel-cancel"
                            onclick="closePanel()">

                            Cancel

                        </button>


                        <button
                            class="category-panel-danger"
                            onclick="deleteCategory(${id})">

                            <i class="bi bi-trash"></i>
                            Delete

                        </button>

                    </div>

                </div>

            `);

        }


        async function deleteCategory(id) {

            try {

                const response =
                    await fetch(`/api/Category/${id}`, {

                        method: "DELETE",
                        headers

                    });


                if (!response.ok)
                    throw new Error();


                closePanel();

                loadCategories();

            }
            catch {

                showPanelError(
                    "Delete Category",
                    "Unable to delete category."
                );

            }

        }


        function showPanelError(title, message) {

            openPanel(
                title,
                `<div class="category-panel-error">${message}</div>`
            );

        }


        loadCategories();

    </script>

    <script src="~/js/authGuard.js"></script>
}