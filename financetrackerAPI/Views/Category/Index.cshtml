@{
    ViewData["Title"] = "Create Category";
}


<div class="container">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow border-0 p-4">


                <h2 class="mb-4 fw-bold">

                    <i class="bi bi-tags-fill me-2"></i>
                    Create Category

                </h2>



                <div class="mb-3">

                    <label class="form-label">
                        Category Name
                    </label>


                    <input id="name"
                           class="form-control"
                           placeholder="Enter category name" />

                </div>



                <div class="mb-3">

                    <label class="form-label">
                        Type
                    </label>


                    <select id="type"
                            class="form-select">


                        <option value="Income">
                            Income
                        </option>


                        <option value="Expense">
                            Expense
                        </option>


                    </select>

                </div>



                <button class="btn btn-success"
                        onclick="createCategory()">

                    <i class="bi bi-check-circle me-1"></i>
                    Save

                </button>


                <a asp-controller="CategoryPage"
                   asp-action="Index"
                   class="btn btn-secondary ms-2">

                    Back

                </a>



            </div>

        //                 rows += `

        // <tr>

        // <td>${category.categoryID}</td>

        // <td>${category.name}</td>

        // <td>${category.type}</td>

        // <td>

        // <a href="/CategoryPage/Edit/${category.categoryID}"
        // class="btn btn-warning btn-sm">

        // <i class="bi bi-pencil-square"></i>

        // </a>

        // <button
        // class="btn btn-danger btn-sm"
        // onclick="deleteCategory(${category.categoryID})">

        // <i class="bi bi-trash"></i>

        // </button>

        // </td>

        // </tr>

        // `;

        rows += `
<tr>
<td>${category.categoryID}</td>
<td>${category.name}</td>
<td>${category.type}</td>
<td>
<a href="/CategoryPage/Edit/${category.categoryID}" class="btn btn-warning btn-sm">
<i class="bi bi-pencil-square"></i>
</a>
<a href="/CategoryPage/Budget/${category.categoryID}" class="btn btn-info btn-sm">
<i class="bi bi-piggy-bank-fill"></i>
</a>
<button class="btn btn-danger btn-sm" onclick="deleteCategory(${category.categoryID})">
<i class="bi bi-trash"></i>
</button>
</td>
</tr>
`;


            const category =
            {
                name: document.getElementById("name").value,

                type: document.getElementById("type").value
            };



            try {

                const response = await fetch("/api/Category",
                    {

                        method: "POST",


                        headers:
                        {
                            "Content-Type": "application/json",

                            "Authorization": "Bearer " + token
                        },


                        body: JSON.stringify(category)

                    });



                if (response.ok) {

                    window.location.href = "/CategoryPage";

                }
                else {

                    const error = await response.text();

                    alert(error);

                }


            }
            catch (error) {

                alert("API Error: " + error.message);

                console.log(error);

            }


        }


    </script>


    <script src="~/js/authGuard.js"></script>


}