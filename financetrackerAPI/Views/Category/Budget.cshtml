@{
    ViewData["Title"] = "Budget Summary";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow p-4" id="budgetCard">
                <h2 id="budgetname" class="mb-4"></h2>

                <p><strong>Created:</strong> <span id="budgetdate"></span></p>
                <p><strong>Limits:</strong> <span id="budgetlimits"></span></p>

                <a asp-controller="CategoryPage" asp-action="Index"
                   class="btn btn-secondary mt-3">
                    <i class="bi bi-arrow-left-circle me-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const categoryId = @ViewData["CategoryId"];
        const token = localStorage.getItem("token");
        const headers = { Authorization: "Bearer " + token };

        async function loadBudgetSummary() {
            const categoryResponse = await fetch(`/api/Category/${categoryId}`, { headers });
            const category = await categoryResponse.json();

            const budgetResponse = await fetch("/api/Budget", { headers });
            const budgets = await budgetResponse.json();

            const budget = budgets.find(b => b.categoryID == categoryId);

            if (!budget) {
                document.getElementById("budgetCard").innerHTML =
                    "<p>No budget found for this category.</p>";
                return;
            }

            document.getElementById("budgetname").textContent =
                category.name + " Budget";

            document.getElementById("budgetdate").textContent =
                new Date(budget.date).toLocaleDateString();

            document.getElementById("budgetlimits").textContent =
                "$" + budget.limit;
        }

        loadBudgetSummary();
    </script>
}