@{
    ViewData["Title"] = "Edit Category";
    var categoryID = ViewData["categoryID"];
}

<div class="category-page">

    <div class="card category-form">

        <h2>
            <i class="bi bi-pencil-square"></i>
            Edit Category
        </h2>

        <div class="mb-3">
            <label class="form-label">Category Name</label>
            <input id="name" class="form-control" type="text" />
        </div>

        <div class="mb-3">
            <label class="form-label">Type</label>

            <select id="type" class="form-select">
                <option value="Expense">Expense</option>
                <option value="Income">Income</option>
            </select>
        </div>

        <div id="editError" class="category-error"></div>

        <div class="category-buttons">
            <button class="category-btn category-primary"
                    onclick="saveCategory()">
                <i class="bi bi-check-lg me-1"></i> Save Changes
            </button>

            <a asp-controller="CategoryPage"
               asp-action="Index"
               class="category-btn category-secondary">
                Cancel
            </a>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        const token = localStorage.getItem("token");
        const categoryID = @categoryID;
        const errorBox = document.getElementById("editError");

        function showError(message) {
            errorBox.textContent = message;
            errorBox.style.display = "block";
        }

        async function loadCategory() {
            const response = await fetch(`/api/Category/${categoryID}`, {
                headers: { Authorization: "Bearer " + token }
            });

            if (!response.ok) {
                window.location.href = "/CategoryPage";
                return;
            }

            const category = await response.json();

            document.getElementById("name").value = category.name;
            document.getElementById("type").value = category.type;
        }

        async function saveCategory() {
            const name = document.getElementById("name").value.trim();
            const type = document.getElementById("type").value;

            if (!name) {
                showError("Please enter a category name.");
                return;
            }

            const response = await fetch(`/api/Category/${categoryID}`, {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json",
                    Authorization: "Bearer " + token
                },
                body: JSON.stringify({ name, type })
            });

            if (response.ok) {
                window.location.href = "/CategoryPage";
                return;
            }

            showError("Unable to save changes.");
        }

        loadCategory();
    </script>
}