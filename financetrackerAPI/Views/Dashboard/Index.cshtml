@section Scripts {

    <script src="~/js/authGuard.js"></script>

    <script>
        const token = localStorage.getItem("token");

        if (!token) {
            window.location.href = "/AuthPage/Login";
        }

        function handleAuthError(response) {
            if (response.status === 401) {
                localStorage.removeItem("token");
                window.location.href = "/AuthPage/Login";
                return true;
            }
            return false;
        }

        // ✅ Budget
        fetch("/api/Budget", {
            headers: {
                "Authorization": "Bearer " + token
            }
        })
            .then(response => {
                if (handleAuthError(response)) return;
                return response.json();
            })
            .then(budget => {
                if (!budget) return;

                document.getElementById("budgetName").innerHTML = budget.budgetName;
                document.getElementById("budgetAmount").innerHTML = "$" + budget.amount;
            });

        // ✅ Category
        fetch("/api/Category", {
            headers: {
                "Authorization": "Bearer " + token
            }
        })
            .then(response => {
                if (handleAuthError(response)) return;
                return response.json();
            })
            .then(category => {
                if (!category) return;

                document.getElementById("categoryName").innerHTML = category.categoryName;
                document.getElementById("categoryAmount").innerHTML = "$" + category.totalSpent;
            });

        // ✅ Transactions
        fetch("/api/Transactions", {
            headers: {
                "Authorization": "Bearer " + token
            }
        })
            .then(response => {
                if (handleAuthError(response)) return;
                return response.json();
            })
            .then(transactions => {
                if (!transactions) return;

                let html = "";

                transactions.forEach(transaction => {
                    html += `<p>${transaction.description} - $${transaction.amount}</p>`;
                });

                document.getElementById("recentTransactions").innerHTML = html;
            });

    </script>
}
