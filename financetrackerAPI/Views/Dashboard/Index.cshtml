@{
    ViewData["Title"] = "Dashboard";
}

<div class="container">

    <h1 class="fw-bold mb-4">
        <i class="bi bi-speedometer2 me-2"></i>
        Dashboard
    </h1>

    <!-- Hero banner -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card shadow h-100">
                <div class="card-header bg-success text-white fw-bold">
                    <i class="bi bi-arrow-up-circle-fill me-1"></i>
                    Income
                </div>
                <div class="card-body text-center">
                    <h2 class="fw-bold mb-0" id="incomeTotal">$0.00</h2>
                    <small class="text-muted">Total from income categories</small>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow h-100">
                <div class="card-header bg-danger text-white fw-bold">
                    <i class="bi bi-arrow-down-circle-fill me-1"></i>
                    Expenses
                </div>
                <div class="card-body text-center">
                    <h2 class="fw-bold mb-0" id="expenseTotal">$0.00</h2>
                    <small class="text-muted">Total from expense categories</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Three equal columns -->
    <div class="row g-4">

        <div class="col-md-4 d-flex">
            <div class="card shadow p-3 flex-fill">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-star-fill me-1"></i>
                    Most Used Category
                </h5>
                <div id="mostUsedCategory">
                    <p class="text-muted mb-0">No transactions yet.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 d-flex">
            <div class="card shadow p-3 flex-fill">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    Budgets Almost Full
                </h5>
                <ul class="list-group list-group-flush" id="almostFullList">
                    <li class="list-group-item text-muted">No budgets are close to their limit.</li>
                </ul>
            </div>
        </div>

        <div class="col-md-4 d-flex">
            <div class="card shadow p-3 flex-fill">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-clock-history me-1"></i>
                    Recent Transactions
                </h5>
                <ul class="list-group list-group-flush" id="recentTransactionsList">
                    <li class="list-group-item text-muted">No transactions yet.</li>
                </ul>
            </div>
        </div>

    </div>

</div>

@section Scripts {
<script>

const token = localStorage.getItem("token");

loadDashboard();

async function loadDashboard() {

    const [categoriesRes, transactionsRes, budgetsRes] = await Promise.all([
        fetch("/api/Category", { headers: { "Authorization": "Bearer " + token } }),
        fetch("/api/Transactions", { headers: { "Authorization": "Bearer " + token } }),
        fetch("/api/Budget", { headers: { "Authorization": "Bearer " + token } })
    ]);

    const categories = categoriesRes.ok ? await categoriesRes.json() : [];
    const transactions = transactionsRes.ok ? await transactionsRes.json() : [];
    const budgets = budgetsRes.ok ? await budgetsRes.json() : [];

    const categoryById = {};
    categories.forEach(c => categoryById[c.categoryID] = c);

    renderHero(transactions, categoryById);
    renderMostUsedCategory(transactions, categoryById);
    renderAlmostFullBudgets(budgets, transactions, categoryById);
    renderRecentTransactions(transactions);
}

function renderHero(transactions, categoryById) {

    let income = 0;
    let expense = 0;

    transactions.forEach(t => {
        const category = categoryById[t.categoryID];
        if (!category) return;

        if (category.type.toLowerCase() === "income") {
            income += t.amount;
        } else {
            expense += t.amount;
        }
    });

    document.getElementById("incomeTotal").innerText = "$" + income.toFixed(2);
    document.getElementById("expenseTotal").innerText = "$" + expense.toFixed(2);
}

function renderMostUsedCategory(transactions, categoryById) {

    if (transactions.length === 0) return;

    const counts = {};
    transactions.forEach(t => {
        counts[t.categoryID] = (counts[t.categoryID] || 0) + 1;
    });

    let topCategoryID = null;
    let topCount = 0;

    Object.keys(counts).forEach(id => {
        if (counts[id] > topCount) {
            topCount = counts[id];
            topCategoryID = Number(id);
        }
    });

    const category = categoryById[topCategoryID];
    const name = category ? category.name : "Unknown category";

    document.getElementById("mostUsedCategory").innerHTML = `
        <h4 class="fw-bold">${name}</h4>
        <p class="text-muted mb-0">${topCount} transaction${topCount === 1 ? "" : "s"}</p>
    `;
}

function renderAlmostFullBudgets(budgets, transactions, categoryById) {

    const spentByCategory = {};
    transactions.forEach(t => {
        spentByCategory[t.categoryID] = (spentByCategory[t.categoryID] || 0) + t.amount;
    });

    const almostFull = budgets
        .map(b => {
            const spent = spentByCategory[b.categoryID] || 0;
            const percent = b.limit > 0 ? Math.round((spent / b.limit) * 100) : 0;
            const category = categoryById[b.categoryID];
            return { name: category ? category.name : "Unknown category", percent: percent };
        })
        .filter(b => b.percent >= 80)
        .sort((a, b) => b.percent - a.percent);

    if (almostFull.length === 0) return;

    const list = document.getElementById("almostFullList");
    list.innerHTML = almostFull.map(b => `
        <li class="list-group-item d-flex justify-content-between align-items-center">
            ${b.name}
            <span class="badge bg-danger rounded-pill">${b.percent}%</span>
        </li>
    `).join("");
}

function renderRecentTransactions(transactions) {

    if (transactions.length === 0) return;

    const recent = [...transactions]
        .sort((a, b) => new Date(b.date) - new Date(a.date))
        .slice(0, 5);

    const list = document.getElementById("recentTransactionsList");
    list.innerHTML = recent.map(t => `
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>${t.categoryName ?? "No Category"}</span>
            <span class="fw-bold">$${t.amount.toFixed(2)}</span>
        </li>
    `).join("");
}

</script>
}
