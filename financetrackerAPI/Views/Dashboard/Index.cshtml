@{ ViewData["Title"] = "Dashboard"; }

<div class="container">

    <h1 class="mb-4"> Finance Dashboard </h1> 
    <br />
    <br />
    <br />


    @*Insert navbar here
        Navbar has:

            Title{Financial Tracker (for now)}

            Links{
                    Home,
                    Sign Out
                }
    *@
    @if (User.Identity.IsAuthenticated)
    {
        <h2>Hello, @User.Identity.Name!</h2>
        <p>Welcome back.</p>
    }
    <br />
    <br />
    <hr class="dropdown-divider">

    <h4> Account Overview</h4>

    @*Three Cards*@
    @*Budget Card: Shows latest budget being used*@
    @*Category Card: Shows category most used*@
    @*Transaction Card: Shows 3 or 4 transactions*@
    <div class="row">
  <div class="col-sm-4 mb-3 mb-sm-0">
    <div class="card">
        <div class="card-header"><h6>Budget</h6></div>
      <div class="card-body">
        <h5 id="budgetName"></h5>
        <p id="budgetAmount"></p>
        <a asp-controller="BudgetPage"
                   asp-action="Index" class="btn btn-primary">Go to Budget</a>
      </div>
    </div>
  </div>
  <div class="col-sm-4">
    <div class="card">
        <div class="card-header"><h6>Category</h6></div>
      <div class="card-body">
        <h5 id="categoryName"></h5>
        <p id="categoryAmount"></p>
        <a asp-controller="CategoryPage"
                   asp-action="Index" class="btn btn-primary">Go to Category</a>
      </div>
    </div>
  </div>
    <div class="col-sm-4">
    <div class="card">
        <div class="card-header"><h6>Transactions</h6></div>
      <div class="card-body">
        <h5 id="recentTransactions"></h5>
        <a asp-controller="TransactionPage"
                   asp-action="Index" class="btn btn-primary">Go to Transactions</a>
      </div>
    </div>
  </div>
</div>

