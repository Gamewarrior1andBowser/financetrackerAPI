@{
    ViewData["Title"] = "Dashboard";
}

<div class="finance-dashboard page-content">

    <div class="dashboard-hero">
        <div class="hero-text">
            <div class="hero-badge">
                <i class="bi bi-stack"></i> Personal Finance Tracker
            </div>
            <h2>Hello, <span id="greetingName">...</span></h2>
            <p>Here's what's happening with your finances today.</p>
        </div>

        <div class="hero-actions">
            <a asp-controller="TransactionPage" asp-action="Index"
               asp-route-type="Income" class="btn-new-income">
                <i class="bi bi-plus-circle-fill"></i> New Income
            </a>
            <a asp-controller="TransactionPage" asp-action="Index"
               asp-route-type="Expense" class="btn-new-expense">
                <i class="bi bi-plus-circle-fill"></i> New Expense
            </a>
        </div>
    </div>

    <div class="dashboard-subnav">
        <a asp-controller="TransactionPage" asp-action="Index" class="active">
            <i class="bi bi-cash-stack"></i> Transactions
        </a>
        <a href="#dashboardStats">
            <i class="bi bi-bar-chart-line-fill"></i> Stats
        </a>
    </div>

    <div class="summary-cards">

        <div class="summary-card income">
            <div class="summary-card-head">
                <span>Total Income</span>
                <span class="summary-icon"><i class="bi bi-graph-up-arrow"></i></span>
            </div>
            <strong id="incomeTotal">$0.00</strong>
        </div>

        <div class="summary-card expense">
            <div class="summary-card-head">
                <span>Total Expenses</span>
                <span class="summary-icon"><i class="bi bi-graph-down-arrow"></i></span>
            </div>
            <strong id="expenseTotal">$0.00</strong>
        </div>

        <div class="summary-card balance">
            <div class="summary-card-head">
                <span>Balance</span>
                <span class="summary-icon"><i class="bi bi-wallet2"></i></span>
            </div>
            <strong id="balanceTotal">$0.00</strong>
        </div>

    </div>

    <div id="dashboardStats" class="chart-grid">

        <div class="chart-card">
            <h2>Spend by Category This Month</h2>
            <div class="chart-container donut-container">
                <canvas id="categoryChart"></canvas>
            </div>
            <div id="categoryLegend" class="chart-legend"></div>
        </div>

        <div class="chart-card">
            <h2>This Year — Income vs. Expenses Trend</h2>
            <div class="chart-container">
                <canvas id="trendChart"></canvas>
            </div>
        </div>

    </div>

    <div class="chart-card recent-dashboard-section">

        <div class="recent-header">
            <h2>Recent Transactions</h2>
            <a asp-controller="TransactionPage" asp-action="Index">
                View All <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div id="recentDashboardTransactions" class="recent-dashboard-list"></div>

        <div id="noRecentTransactions" class="dashboard-empty" style="display:none;">
            <i class="bi bi-receipt"></i>
            <p>No transactions yet.</p>
        </div>

    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const token = localStorage.getItem("token");

        let categories = [];
        let transactions = [];
        let categoryChart;
        let trendChart;

        loadDashboard();
        loadGreeting();

        function getJwtPayload(token) {
            try {
                const data = token.split(".")[1];
                const text = atob(data.replace(/-/g, "+").replace(/_/g, "/"));

                return JSON.parse(
                    decodeURIComponent(
                        text.split("").map(c =>
                            "%" + ("00" + c.charCodeAt(0).toString(16)).slice(-2)
                        ).join("")
                    )
                );
            } catch {
                return null;
            }
        }

        async function getUserName() {
            if (!token) return "User";

            const user = getJwtPayload(token);
            const name = user?.name || user?.given_name || user?.unique_name;

            if (name) return name;

            try {
                const response = await fetch("/api/User/profile", {
                    headers: { Authorization: "Bearer " + token }
                });

                if (response.ok) {
                    const data = await response.json();
                    return data?.name || "User";
                }
            } catch { }

            return "User";
        }

        async function loadGreeting() {
            document.getElementById("greetingName").textContent =
                await getUserName();
        }

        async function loadDashboard() {
            try {
                const headers = {
                    Authorization: "Bearer " + token
                };

                const categoryResponse = await fetch("/api/Category", { headers });
                const transactionResponse = await fetch("/api/Transactions", { headers });

                categories = categoryResponse.ok
                    ? await categoryResponse.json()
                    : [];

                transactions = transactionResponse.ok
                    ? await transactionResponse.json()
                    : [];

                showTotals();
                showCategoryChart();
                showTrendChart();
                showRecentTransactions();

            } catch (error) {
                console.error("Dashboard loading error:", error);
            }
        }

        function getCategory(id) {
            return categories.find(c => c.categoryID === id);
        }

        function isIncome(transaction) {
            const category = getCategory(transaction.categoryID);

            return category?.type?.toLowerCase() === "income";
        }

        function showTotals() {
            let income = 0;
            let expenses = 0;

            transactions.forEach(transaction => {
                const amount = Number(transaction.amount) || 0;

                if (isIncome(transaction))
                    income += amount;
                else
                    expenses += amount;
            });

            document.getElementById("incomeTotal").textContent =
                "$" + income.toFixed(2);

            document.getElementById("expenseTotal").textContent =
                "$" + expenses.toFixed(2);

            document.getElementById("balanceTotal").textContent =
                "$" + (income - expenses).toFixed(2);
        }

        function showCategoryChart() {
            const now = new Date();
            const totals = {};

            transactions.forEach(transaction => {
                const date = new Date(transaction.date);

                if (
                    date.getMonth() !== now.getMonth() ||
                    date.getFullYear() !== now.getFullYear() ||
                    isIncome(transaction)
                ) return;

                const category =
                    getCategory(transaction.categoryID)?.name ||
                    transaction.categoryName ||
                    "Other";

                totals[category] =
                    (totals[category] || 0) +
                    (Number(transaction.amount) || 0);
            });

            const labels = Object.keys(totals);
            const values = Object.values(totals);

            categoryChart?.destroy();

            categoryChart = new Chart(
                document.getElementById("categoryChart"),
                {
                    type: "doughnut",
                    data: {
                        labels: labels,
                        datasets: [{
                            data: values,
                            backgroundColor: [
                                "#4f46a5",
                                "#6d5bd0",
                                "#4f86c6",
                                "#f59e0b",
                                "#fbbf24",
                                "#9b91df",
                                "#7c74d1",
                                "#3f8fd1"
                            ],
                            borderWidth: 3,
                            borderColor: "#fff"
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: "62%",
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: item =>
                                        "$" + Number(item.raw).toFixed(2)
                                }
                            }
                        }
                    }
                }
            );

            showCategoryLegend(labels, values);
        }

        function showCategoryLegend(labels, values) {
            const legend = document.getElementById("categoryLegend");

            if (!labels.length) {
                legend.innerHTML =
                    `<span class="no-chart-data">No expenses this month</span>`;
                return;
            }

            const total = values.reduce((a, b) => a + b, 0);

            const colors = [
                "#4f46a5",
                "#6d5bd0",
                "#4f86c6",
                "#f59e0b",
                "#fbbf24",
                "#9b91df",
                "#7c74d1",
                "#3f8fd1"
            ];

            legend.innerHTML = labels.map((label, i) => `
                        <div class="legend-item">
                            <span class="legend-dot"
                                  style="background:${colors[i % colors.length]}"></span>
                            <span>${label}</span>
                            <strong>$${values[i].toFixed(2)}</strong>
                            (${(values[i] / total * 100).toFixed(1)}%)
                        </div>
                    `).join("");
        }

        function showTrendChart() {
            const year = new Date().getFullYear();

            const labels = [
                "Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
            ];

            const income = Array(12).fill(0);
            const expenses = Array(12).fill(0);

            transactions.forEach(transaction => {
                const date = new Date(transaction.date);

                if (date.getFullYear() !== year) return;

                const amount = Number(transaction.amount) || 0;

                if (isIncome(transaction))
                    income[date.getMonth()] += amount;
                else
                    expenses[date.getMonth()] += amount;
            });

            trendChart?.destroy();

            trendChart = new Chart(
                document.getElementById("trendChart"),
                {
                    type: "line",
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: "Income",
                                data: income,
                                borderColor: "#4f46a5",
                                backgroundColor: "rgba(79,70,165,.12)",
                                borderWidth: 2,
                                tension: .35,
                                fill: true
                            },
                            {
                                label: "Expense",
                                data: expenses,
                                borderColor: "#f59e0b",
                                backgroundColor: "rgba(245,158,11,.12)",
                                borderWidth: 2,
                                tension: .35,
                                fill: true
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            intersect: false,
                            mode: "index"
                        },
                        plugins: {
                            legend: {
                                position: "bottom"
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: value =>
                                        "$" + Number(value).toLocaleString()
                                }
                            }
                        }
                    }
                }
            );
        }

        function showRecentTransactions() {
            const container =
                document.getElementById("recentDashboardTransactions");

            const empty =
                document.getElementById("noRecentTransactions");

            if (!transactions.length) {
                container.innerHTML = "";
                empty.style.display = "block";
                return;
            }

            empty.style.display = "none";

            const recent = [...transactions]
                .sort((a, b) => new Date(b.date) - new Date(a.date))
                .slice(0, 5);

            container.innerHTML = recent.map(transaction => {

                const date = transaction.date
                    ? new Date(transaction.date).toLocaleDateString("en-CA", {
                        month: "short",
                        day: "numeric",
                        year: "numeric"
                    })
                    : "Unknown";

                return `
                            <div class="dashboard-transaction-row">

                                <div class="dashboard-transaction-left">

                                    <div class="dashboard-transaction-icon">
                                        <i class="bi bi-receipt"></i>
                                    </div>

                                    <div>
                                        <strong>
                                            ${transaction.categoryName ?? "No Category"}
                                        </strong>
                                        <span>${date}</span>
                                    </div>

                                </div>

                                <strong class="dashboard-transaction-amount">
                                    $${(Number(transaction.amount) || 0).toFixed(2)}
                                </strong>

                            </div>
                        `;

            }).join("");
        }
    </script>

    <script src="~/js/authGuard.js"></script>
}