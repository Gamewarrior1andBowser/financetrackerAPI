@{
    ViewData["Title"] = "Dashboard";
}

<div class="finance-dashboard">

    <!-- TOP -->
    <div class="dashboard-top">

        <div class="finance-logo">
            <i class="bi bi-stack"></i>
            <span class="finance-dollar">$</span>
        </div>

        <h1>
            Personal Finance Tracker
        </h1>

    </div>


    <!-- NAVIGATION -->
    <div class="dashboard-nav">

        <div class="dashboard-nav-left">

            <a asp-controller="TransactionPage"
               asp-action="Index"
               class="dashboard-nav-link active">

                <i class="bi bi-cash-stack"></i>
                Transactions

            </a>


            <a href="#dashboardStats"
               class="dashboard-nav-link">

                <i class="bi bi-bar-chart-line-fill"></i>
                Stats

            </a>

        </div>


        <div class="dashboard-nav-right">

            <a asp-controller="TransactionPage"
               asp-action="Create"
               class="new-income-btn">

                <i class="bi bi-plus-circle-fill"></i>
                New Income

            </a>


            <a asp-controller="TransactionPage"
               asp-action="Create"
               class="new-expense-btn">

                <i class="bi bi-plus-circle-fill"></i>
                New Expense

            </a>

        </div>

    </div>



    <!-- CHART SECTION -->
    <div id="dashboardStats"
         class="dashboard-charts">


        <!-- CATEGORY CHART -->
        <div class="dashboard-chart-card">

            <div class="chart-title">

                <h2>
                    Spend By Category This Month
                </h2>

            </div>


            <div class="chart-container donut-container">

                <canvas id="categoryChart"></canvas>

            </div>


            <div id="categoryLegend"
                 class="chart-legend">
            </div>

        </div>



        <!-- TREND CHART -->
        <div class="dashboard-chart-card trend-card">

            <div class="chart-title">

                <h2>
                    This Year Income vs. Expenses Trend
                </h2>

            </div>


            <div class="chart-container">

                <canvas id="trendChart"></canvas>

            </div>

        </div>

    </div>



    <!-- SUMMARY -->
    <div class="dashboard-summary-row">

        <div class="summary-box">

            <span>
                Total Income
            </span>

            <strong id="incomeTotal">
                $0.00
            </strong>

        </div>


        <div class="summary-box">

            <span>
                Total Expenses
            </span>

            <strong id="expenseTotal">
                $0.00
            </strong>

        </div>


        <div class="summary-box">

            <span>
                Balance
            </span>

            <strong id="balanceTotal">
                $0.00
            </strong>

        </div>

    </div>



    <!-- RECENT TRANSACTIONS -->
    <div class="recent-dashboard-section">

        <div class="recent-header">

            <h2>
                Recent Transactions
            </h2>

            <a asp-controller="TransactionPage"
               asp-action="Index">

                View All

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <div id="recentDashboardTransactions"
             class="recent-dashboard-list">
        </div>


        <div id="noRecentTransactions"
             class="dashboard-empty"
             style="display:none;">

            <i class="bi bi-receipt"></i>

            <p>
                No transactions yet.
            </p>

        </div>

    </div>

</div>



@section Scripts {

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    <script>

        const token = localStorage.getItem("token");

        let dashboardCategories = [];
        let dashboardTransactions = [];
        let categoryChartInstance = null;
        let trendChartInstance = null;


        loadDashboard();



        async function loadDashboard() {

            try {

                const [
                    categoriesRes,
                    transactionsRes,
                    budgetsRes
                ] = await Promise.all([

                    fetch("/api/Category", {
                        headers: {
                            "Authorization": "Bearer " + token
                        }
                    }),

                    fetch("/api/Transactions", {
                        headers: {
                            "Authorization": "Bearer " + token
                        }
                    }),

                    fetch("/api/Budget", {
                        headers: {
                            "Authorization": "Bearer " + token
                        }
                    })

                ]);


                dashboardCategories =
                    categoriesRes.ok
                        ? await categoriesRes.json()
                        : [];


                dashboardTransactions =
                    transactionsRes.ok
                        ? await transactionsRes.json()
                        : [];


                const budgets =
                    budgetsRes.ok
                        ? await budgetsRes.json()
                        : [];


                renderTotals();

                renderCategoryChart();

                renderTrendChart();

                renderRecentTransactions();

            }
            catch (error) {

                console.error(
                    "Dashboard loading error:",
                    error
                );

            }

        }



        /* =========================================
           TOTALS
        ========================================= */

        function renderTotals() {

            let income = 0;
            let expenses = 0;


            dashboardTransactions.forEach(transaction => {

                const category =
                    dashboardCategories.find(
                        c =>
                            c.categoryID ===
                            transaction.categoryID
                    );


                if (!category) return;


                const amount =
                    Number(transaction.amount) || 0;


                if (
                    category.type &&
                    category.type.toLowerCase() === "income"
                ) {

                    income += amount;

                }
                else {

                    expenses += amount;

                }

            });


            document.getElementById(
                "incomeTotal"
            ).innerText =
                "$" + income.toFixed(2);


            document.getElementById(
                "expenseTotal"
            ).innerText =
                "$" + expenses.toFixed(2);


            document.getElementById(
                "balanceTotal"
            ).innerText =
                "$" + (income - expenses).toFixed(2);

        }



        /* =========================================
           CATEGORY DONUT
        ========================================= */

        function renderCategoryChart() {

            const now = new Date();

            const currentMonth =
                now.getMonth();

            const currentYear =
                now.getFullYear();


            const categoryTotals = {};


            dashboardTransactions.forEach(transaction => {

                const transactionDate =
                    new Date(transaction.date);


                if (
                    transactionDate.getMonth() !== currentMonth ||
                    transactionDate.getFullYear() !== currentYear
                ) {

                    return;

                }


                const category =
                    dashboardCategories.find(
                        c =>
                            c.categoryID ===
                            transaction.categoryID
                    );


                if (!category) return;


                if (
                    category.type &&
                    category.type.toLowerCase() === "income"
                ) {

                    return;

                }


                const categoryName =
                    category.name ||
                    transaction.categoryName ||
                    "Other";


                categoryTotals[categoryName] =
                    (categoryTotals[categoryName] || 0) +
                    Number(transaction.amount || 0);

            });


            const labels =
                Object.keys(categoryTotals);


            const values =
                Object.values(categoryTotals);


            const canvas =
                document.getElementById(
                    "categoryChart"
                );


            if (categoryChartInstance) {

                categoryChartInstance.destroy();

            }


            categoryChartInstance =
                new Chart(canvas, {

                    type: "doughnut",

                    data: {

                        labels: labels,

                        datasets: [{

                            data: values,

                            borderWidth: 3,

                            borderColor: "#ffffff"

                        }]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        cutout: "62%",

                        plugins: {

                            legend: {
                                display: false
                            },

                            tooltip: {

                                callbacks: {

                                    label: function(context) {

                                        return "$" +
                                            Number(
                                                context.raw
                                            ).toFixed(2);

                                    }

                                }

                            }

                        }

                    }

                });


            renderCategoryLegend(
                labels,
                values
            );

        }



        function renderCategoryLegend(
            labels,
            values
        ) {

            const legend =
                document.getElementById(
                    "categoryLegend"
                );


            if (labels.length === 0) {

                legend.innerHTML = `
                            <span class="no-chart-data">
                                No expenses this month
                            </span>
                        `;

                return;

            }


            const total =
                values.reduce(
                    (sum, value) =>
                        sum + value,
                    0
                );


            legend.innerHTML =
                labels.map((label, index) => {

                    const percentage =
                        total > 0
                            ? (
                                values[index] /
                                total *
                                100
                            ).toFixed(1)
                            : 0;


                    return `

                                <div class="legend-item">

                                    <span class="legend-dot"></span>

                                    <span>
                                        ${label}
                                    </span>

                                    <small>
                                        $${values[index].toFixed(2)}
                                        (${percentage}%)
                                    </small>

                                </div>

                            `;

                }).join("");

        }



        /* =========================================
           YEAR TREND
        ========================================= */

        function renderTrendChart() {

            const currentYear =
                new Date().getFullYear();


            const monthLabels = [
                "Jan",
                "Feb",
                "Mar",
                "Apr",
                "May",
                "Jun",
                "Jul",
                "Aug",
                "Sep",
                "Oct",
                "Nov",
                "Dec"
            ];


            const incomeData =
                new Array(12).fill(0);


            const expenseData =
                new Array(12).fill(0);


            dashboardTransactions.forEach(transaction => {

                const date =
                    new Date(transaction.date);


                if (
                    date.getFullYear() !==
                    currentYear
                ) {

                    return;

                }


                const month =
                    date.getMonth();


                const category =
                    dashboardCategories.find(
                        c =>
                            c.categoryID ===
                            transaction.categoryID
                    );


                if (!category) return;


                const amount =
                    Number(transaction.amount) || 0;


                if (
                    category.type &&
                    category.type.toLowerCase() === "income"
                ) {

                    incomeData[month] += amount;

                }
                else {

                    expenseData[month] += amount;

                }

            });


            const canvas =
                document.getElementById(
                    "trendChart"
                );


            if (trendChartInstance) {

                trendChartInstance.destroy();

            }


            trendChartInstance =
                new Chart(canvas, {

                    type: "line",

                    data: {

                        labels: monthLabels,

                        datasets: [

                            {

                                label: "Income",

                                data: incomeData,

                                borderWidth: 2,

                                tension: 0.35,

                                fill: true

                            },

                            {

                                label: "Expense",

                                data: expenseData,

                                borderWidth: 2,

                                tension: 0.35,

                                fill: true

                            }

                        ]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        interaction: {

                            intersect: false,

                            mode: "index"

                        },

                        plugins: {

                            legend: {

                                position: "bottom"

                            }

                        },

                        scales: {

                            y: {

                                beginAtZero: true,

                                ticks: {

                                    callback: function(value) {

                                        return "$" +
                                            Number(value)
                                                .toLocaleString();

                                    }

                                }

                            }

                        }

                    }

                });

        }



        /* =========================================
           RECENT TRANSACTIONS
        ========================================= */

        function renderRecentTransactions() {

            const container =
                document.getElementById(
                    "recentDashboardTransactions"
                );


            const empty =
                document.getElementById(
                    "noRecentTransactions"
                );


            if (
                !dashboardTransactions ||
                dashboardTransactions.length === 0
            ) {

                container.innerHTML = "";

                empty.style.display = "block";

                return;

            }


            empty.style.display = "none";


    const recent = [...transactions]
        .sort((a, b) => new Date(b.date) - new Date(a.date))
        .slice(0, 5);


            container.innerHTML =
                recent.map(transaction => {

                    const amount =
                        Number(
                            transaction.amount
                        ) || 0;


                    const category =
                        transaction.categoryName ??
                        "No Category";


                    const date =
                        new Date(
                            transaction.date
                        ).toLocaleDateString(
                            "en-CA",
                            {
                                month: "short",
                                day: "numeric",
                                year: "numeric"
                            }
                        );


                    return `

                                <div class="dashboard-transaction-row">

                                    <div class="dashboard-transaction-left">

                                        <div class="dashboard-transaction-icon">

                                            <i class="bi bi-receipt"></i>

                                        </div>


                                        <div>

                                            <strong>
                                                ${category}
                                            </strong>

                                            <span>
                                                ${date}
                                            </span>

                                        </div>

                                    </div>


                                    <strong class="dashboard-transaction-amount">

                                        $${amount.toFixed(2)}

                                    </strong>

                                </div>

                            `;

                }).join("");

        }

    </script>


    <script src="~/js/authGuard.js"></script>

}