        fetch("/api/Budget", {
        headers: {
        "Authorization": "Bearer " + token
        }
        })
        .then(response => response.json())
        .then(budget => {

        document.getElementById("budgetName").innerHTML =
        budget.budgetName;

        document.getElementById("budgetAmount").innerHTML =
        "$" + budget.amount;

        });

        fetch("/api/Category", {
    headers: {
        "Authorization": "Bearer " + token
    }
})
.then(response => response.json())
.then(category => {

    document.getElementById("categoryName").innerHTML =
        category.categoryName;

    document.getElementById("categoryAmount").innerHTML =
        "$" + category.totalSpent;

});

fetch("/api/Transactions", {
    headers: {
        "Authorization": "Bearer " + token
    }
})
.then(response => response.json())
.then(transactions => {

    let html = "";

    transactions.forEach(transaction => {

        html += `
            <p>
                ${transaction.description}
                - $${transaction.amount}
            </p>
        `;

    });

    document.getElementById("recentTransactions").innerHTML = html;

});
    </script>
}


