@{
    ViewData["Title"] = "Delete Budget";
    var budgetID = ViewData["budgetID"];
}

<div class="budget-form-page">

    <div class="budget-delete-card">

        <div class="budget-delete-icon">
            <i class="bi bi-trash-fill"></i>
        </div>

        <h1>Delete Budget?</h1>

        <p>
            Are you sure you want to remove this budget?
            This action cannot be undone.
        </p>

        <div id="deleteError"
             class="budget-form-error"
             style="display:none;">
        </div>

        <div class="budget-form-actions">

            <button id="deleteBtn"
                    class="btn btn-danger">
                <i class="bi bi-trash me-1"></i>
                Delete Budget
            </button>

            <a asp-controller="BudgetPage"
               asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        const id = @budgetID;
        const token = localStorage.getItem("token");

        document.getElementById("deleteBtn")
            .addEventListener("click", async function() {

                const errorBox =
                    document.getElementById("deleteError");

                try {

                    const response =
                        await fetch(`/api/Budget/${id}`, {

                            method: "DELETE",

                            headers: {
                                "Authorization": "Bearer " + token
                            }
                        });

                    if (!response.ok) {
                        throw new Error();
                    }

                    window.location.href = "/BudgetPage";

                }
                catch {

                    errorBox.textContent =
                        "Unable to delete budget.";

                    errorBox.style.display = "block";
                }

            });

    </script>

}