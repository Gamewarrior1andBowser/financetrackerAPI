@{
    ViewData["Title"] = "Delete Budget";

    var budgetID = ViewData["budgetID"];
}



<div class="card shadow border-0 p-5 text-center">


<i class="bi bi-trash-fill text-danger"
   style="font-size:60px;">
</i>



<h2 class="mt-3">

Delete Budget?

</h2>



<p class="text-muted">

Are you sure you want to remove this budget?

</p>



<button id="deleteBtn"
        class="btn btn-danger">


<i class="bi bi-trash me-2"></i>

Delete


</button>



<a asp-controller="BudgetPage"
   asp-action="Index"
   class="btn btn-secondary mt-3">


Cancel


</a>


</div>




@section Scripts {


<script>


const id = @budgetID;



document.getElementById("deleteBtn")
.onclick = async ()=>{


const response = await fetch(`/api/Budget/${id}`,
{

method:"DELETE"

});



if(response.ok)
{


window.location.href="/BudgetPage";


}


}


</script>


}