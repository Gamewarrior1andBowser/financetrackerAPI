@{
    ViewData["Title"] = "Budgets";
}



<div class="budget-page">

    <!-- HEADER -->
    <div class="budget-header">

        <div>
            <p class="budget-subtitle">Personal Finance</p>
            <h1 class="budget-title">Budgets</h1>
            <p class="budget-description">
                Set spending limits and keep your budget goals on track.
            </p>
        </div>

        <a asp-controller="BudgetPage" asp-action="Create" class="budget-add-btn">
            <i class="bi bi-plus-circle"></i>
            Add Budget
        </a>

    </div>

    <!-- TOOLBAR -->
    <div class="budget-toolbar">

        <div class="budget-filter-list">
            <button class="budget-filter active" onclick="showAllBudgets()">
                <i class="bi bi-grid-fill"></i>
                <span>All</span>
            </button>

            <button class="budget-filter" onclick="showActiveBudgets()">
                <i class="bi bi-check-circle"></i>
                <span>Active</span>
            </button>

            <button class="budget-filter" onclick="showRecentBudgets()">
                <i class="bi bi-calendar3"></i>
                <span>Recent</span>
            </button>
        </div>

        <div class="budget-toolbar-meta">
            <span id="budgetCount">0 budgets</span>
            <div class="toolbar-divider"></div>
            <span>Total: <strong id="totalBudgeted">$0.00</strong></span>
        </div>

    </div>

    <!-- BUDGET LIST -->
    <div id="budgetCards" class="budget-card-grid"></div>

    <!-- EMPTY STATE -->
    <div id="emptyBudget" class="budget-empty" style="display:none;">
        <div class="budget-empty-icon">
            <i class="bi bi-wallet2"></i>
        </div>
        <h3>No budgets yet</h3>
        <p>Create your first budget to start managing your spending.</p>
        <a asp-controller="BudgetPage" asp-action="Create" class="budget-add-btn">
            <i class="bi bi-plus-circle"></i>
            Add Budget
        </a>
    </div>

</div>

@section Scripts {

    <script>

        const token = localStorage.getItem("token");

        let allBudgets = [];


        loadBudgets();


        async function loadBudgets() {

            try {

                const response = await fetch(
                    "/api/Budget",
                    {
                        headers: {
                            "Authorization": "Bearer " + token
                        }
                    }
                );

                if (!response.ok) {
                    throw new Error("Unable to load budgets.");
                }

                allBudgets = await response.json();

                displayBudgets(allBudgets);

            }
            catch (error) {

                console.error(error);

                document.getElementById("budgetCards").innerHTML = `
                    <div class="budget-error">
                        <i class="bi bi-exclamation-circle"></i>
                        <p>Unable to load budgets.</p>
                    </div>
                `;

            }

        }


        function displayBudgets(budgets) {

            const container =
                document.getElementById("budgetCards");

            const empty =
                document.getElementById("emptyBudget");

            const count =
                document.getElementById("budgetCount");

            const totalBudgeted =
                document.getElementById("totalBudgeted");


            container.innerHTML = "";


            count.textContent =
                `${budgets.length} ${budgets.length === 1 ? "budget" : "budgets"}`;


            const total =
                budgets.reduce((sum, b) => sum + Number(b.limit ?? b.Limit ?? 0), 0);

            totalBudgeted.textContent =
                `$${total.toFixed(2)}`;


            if (budgets.length === 0) {

                empty.style.display = "block";

                return;

            }


            empty.style.display = "none";


            budgets.forEach(budget => {

                const id =
                    budget.budgetID ??
                    budget.BudgetID ??
                    budget.id;


                const name =
                    budget.name ??
                    budget.Name ??
                    "Unnamed Budget";


                const limit =
                    Number(
                        budget.limit ??
                        budget.Limit ??
                        0
                    );


                const date =
                    budget.date ??
                    budget.Date ??
                    budget.dateCreated ??
                    budget.DateCreated;


                let formattedDate = "Not available";


                if (date) {

                    formattedDate =
                        new Date(date).toLocaleDateString(
                            "en-CA",
                            {
                                year: "numeric",
                                month: "short",
                                day: "numeric"
                            }
                        );

                }


                const card =
                    document.createElement("div");


                card.className = "budget-card";


                card.innerHTML = `

                    <div class="budget-card-left">

                        <div class="budget-icon">

                            <i class="bi bi-wallet2"></i>

                        </div>


                        <div class="budget-info">

                            <h3>
                                ${name}
                            </h3>


                            <span>

                                <i class="bi bi-calendar3"></i>

                                Created ${formattedDate}

                            </span>

                        </div>

                    </div>


                    <div class="budget-card-right">

                        <div class="budget-limit">

                            <small>Monthly limit</small>

                            <strong class="budget-amount">

                                $${limit.toFixed(2)}

                            </strong>

                        </div>


                        <div class="budget-actions">


                            <a href="/BudgetPage/Details?id=${id}"
                               class="budget-action details"
                               title="View Details">

                                <i class="bi bi-eye"></i>

                            </a>


                            <a href="/BudgetPage/Edit?id=${id}"
                               class="budget-action edit"
                               title="Edit">

                                <i class="bi bi-pencil"></i>

                            </a>


                            <a href="/BudgetPage/Delete?id=${id}"
                               class="budget-action delete"
                               title="Delete">

                                <i class="bi bi-trash"></i>

                            </a>


                        </div>

                    </div>

                `;


                container.appendChild(card);

            });

        }


        function showAllBudgets() {

            displayBudgets(allBudgets);

            setActiveFilter(0);

        }


        function showActiveBudgets() {

            displayBudgets(allBudgets);

            setActiveFilter(1);

        }


        function showRecentBudgets() {

            const recent =
                [...allBudgets]
                    .sort((a, b) => {

                        const dateA =
                            new Date(
                                a.date ??
                                a.Date ??
                                a.dateCreated ??
                                a.DateCreated
                            );

                        const dateB =
                            new Date(
                                b.date ??
                                b.Date ??
                                b.dateCreated ??
                                b.DateCreated
                            );

                        return dateB - dateA;

                    })
                    .slice(0, 5);


            displayBudgets(recent);

            setActiveFilter(2);

        }


        function setActiveFilter(index) {

            const buttons =
                document.querySelectorAll(".budget-filter");


            buttons.forEach(button => {

                button.classList.remove("active");

            });


            if (buttons[index]) {

                buttons[index].classList.add("active");

            }

        }

    </script>


    <script src="~/js/authGuard.js"></script>

}
