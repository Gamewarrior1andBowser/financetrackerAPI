@{ ViewData["Title"] = "Budgets"; }

<div class="container">
    <h1 class="mb-4"> Budgets </h1>
        <a asp-controller="BudgetPage" asp-action="Create" class="btn btn-primary">Create Budget</a> 
    <a asp-controller="BudgetPage" asp-action="Edit" class="btn btn-primary">Edit Budget</a> 
    <table class="table table-bordered">
        <thead class="table-primary">
            <tr>
                <th> Date </th> @*Change this to "Name" or "Budget Name"*@
                <th>Limit </th>
            </tr>
        </thead>
        <tbody id="budgetTable">
        </tbody>
    </table>
    <a asp-controller="Dashboard"
       asp-action="Index" class="btn btn-primary">Go to Dashboard</a>
</div>

@section Scripts {
    <script>

        const token = localStorage.getItem("token");

        fetch("/api/Budget", {
            headers: { "Authorization": "Bearer " + token }
        })

            .then(response => response.json())

            .then(data => {
                let rows = "";
                data.forEach(budget => { rows += `
                <tr>
                    <td>${budget.date}</td>
                    <td>${budget.limit}</td>
                </tr> `;
                });

                document.getElementById("budgetTable").innerHTML = rows;
            })
            .catch(error => {
                console.log(error);
            });
    </script>
}