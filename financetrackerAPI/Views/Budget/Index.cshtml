@{
    ViewData["Title"] = "Budgets";
}

<link rel="stylesheet" href="~/css/budget.css" />

<div class="budget-page">

    <div class="category-header">
        <div>
            <h1 class="category-title">
                <i class="bi bi-piggy-bank-fill"></i> Budgets
            </h1>

            <p class="category-description">
                Set spending limits and keep every category on track.
            </p>
        </div>
    </div>


    <!-- HERO -->

    <section class="category-hero">

        <div class="category-hero-content">

            <span class="category-hero-label">
                <i class="bi bi-lightbulb-fill"></i>
                Give every dollar a job
            </span>

            <h2>Set Limits, Stay In Control</h2>

            <p>
                Budgets keep your spending in check by putting a clear
                ceiling on each category, so surprises don't creep in.
            </p>

            <button class="category-hero-btn" onclick="showCreatePanel()">
                <i class="bi bi-plus-circle"></i> Create a Budget
            </button>

        </div>

        <div class="budget-hero-visual"></div>

    </section>


    <!-- WHY BUDGETS MATTER -->

    <section class="category-benefits">

        <div class="category-section-heading">

            <span>WHY BUDGETS MATTER</span>

            <h2>Turn Limits Into Better Habits</h2>

            <p>
                A budget gives your spending a boundary and gives you an
                early warning before you cross it.
            </p>

        </div>


        <div class="category-benefit-grid">

            <article class="category-benefit-card">

                <img src="~/images/budgets/budget-card-image-one.webp"
                     class="category-benefit-image"
                     alt="Understanding spending">

                <h3>Stay Protected</h3>

                <p>
                    Set a limit for each category so spending never quietly
                    gets out of hand.
                </p>

            </article>


            <article class="category-benefit-card">

                <img src="~/images/budgets/budget-card-image-two.webp"
                     class="category-benefit-image"
                     alt="Understanding spending">

                <h3>Stay On Target</h3>

                <p>
                    Clear limits make it easy to see how close you are to
                    your spending goals at any time.
                </p>

            </article>


            <article class="category-benefit-card">

                <img src="~/images/budgets/budget-card-image-three.webp"
                     class="category-benefit-image"
                     alt="Understanding spending">

                <h3>Build Savings</h3>

                <p>
                    Staying under budget frees up more money to put toward
                    your savings goals.
                </p>

            </article>

        </div>

    </section>


    <!-- PROBLEM / SOLUTION -->

    <section class="category-problem">

        <div class="category-problem-icon">
            <i class="bi bi-question-circle-fill"></i>
        </div>

        <div class="category-problem-content">

            <span>THE PROBLEM WE SOLVE</span>

            <h2>Spending Without Limits Adds Up Fast</h2>

            <p>
                Without a set limit, it's easy to lose track of how much
                you've spent in a category until it's too late.
            </p>

        </div>


        <div class="category-solution">

            <div class="category-solution-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <div>

                <strong>Our Solution</strong>

                <p>
                    Set a limit per category up front, so you always know
                    how much room you have left.
                </p>

            </div>

        </div>

    </section>


    <!-- BUDGET CONTENT -->

    <div class="category-content">

        <main class="category-main">

            <div id="budgetList" class="category-grid"></div>


            <div id="emptyBudget"
                 class="category-empty"
                 style="display:none;">

                <div class="category-empty-icon">
                    <i class="bi bi-piggy-bank-fill"></i>
                </div>

                <h3>No budgets yet</h3>

                <p>
                    Create your first budget to start tracking your spending.
                </p>

                <button class="category-add-btn"
                        onclick="showCreatePanel()">

                    <i class="bi bi-plus-lg"></i>
                    Create Budget

                </button>

            </div>


            <div id="budgetError"
                 class="category-error"
                 style="display:none;">

                Unable to load budgets.

            </div>

        </main>


        <aside id="budgetPanel"
               class="category-panel">

            <div class="category-panel-header">

                <div>

                    <h2 id="panelTitle">Budget</h2>

                    <p>Manage this budget</p>

                </div>

                <button class="category-panel-close"
                        onclick="closePanel()">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <div id="panelContent"
                 class="category-panel-content">
            </div>

        </aside>

    </div>

</div>


@section Scripts {

    <script>

        const token = localStorage.getItem("token");
        const headers = { Authorization: "Bearer " + token };

        const budgetList = document.getElementById("budgetList");
        const emptyBudget = document.getElementById("emptyBudget");
        const budgetError = document.getElementById("budgetError");
        const budgetPanel = document.getElementById("budgetPanel");
        const panelTitle = document.getElementById("panelTitle");
        const panelContent = document.getElementById("panelContent");


        function escapeHtml(value) {

            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");

        }


        function openPanel(title, content) {

            panelTitle.innerHTML =
                `<i class="bi bi-piggy-bank-fill"></i> ${title}`;

            panelContent.innerHTML = content;

            budgetPanel.classList.add("open");

            setTimeout(() => {

                budgetPanel.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

            }, 100);

        }


        function closePanel() {

            budgetPanel.classList.remove("open");

        }


        async function loadBudgets() {

            try {

                const response =
                    await fetch("/api/Budget", { headers });

                if (!response.ok)
                    throw new Error();

                const budgets = await response.json();

                if (!budgets.length) {

                    budgetList.innerHTML = "";
                    emptyBudget.style.display = "block";
                    return;

                }

                emptyBudget.style.display = "none";

                budgetList.innerHTML =
                    budgets.map(budget => {

                        const name = budget.username || "Unnamed Budget";
                        const limit = Number(budget.limits) || 0;
                        const date = budget.date
                            ? new Date(budget.date).toLocaleDateString()
                            : "Unknown";

                        return `

                            <article class="category-card">

                                <div class="category-card-body">

                                    <div class="category-card-icon">
                                        <i class="bi bi-piggy-bank-fill"></i>
                                    </div>

                                    <h2>
                                        ${escapeHtml(name)}
                                    </h2>

                                    <div class="category-card-type">

                                        <span>Budget Limit</span>

                                        <strong>
                                            $${limit.toFixed(2)}
                                        </strong>

                                    </div>


                                    <div class="category-card-type">

                                        <span>Created</span>

                                        <strong>
                                            ${date}
                                        </strong>

                                    </div>

                                </div>


                                <div class="category-card-actions">

                                    <button
                                        class="category-card-btn category-view-btn"
                                        onclick="showDetails(${budget.budgetID})">

                                        <i class="bi bi-eye"></i>
                                        View Details

                                    </button>


                                    <button
                                        class="category-card-btn category-edit-btn"
                                        onclick="showEditPanel(${budget.budgetID})">

                                        <i class="bi bi-pencil"></i>
                                        Edit

                                    </button>


                                    <button
                                        class="category-card-btn category-delete-btn"
                                        onclick="showDeletePanel(${budget.budgetID})">

                                        <i class="bi bi-trash"></i>
                                        Delete

                                    </button>

                                </div>

                            </article>

                        `;

                    }).join("");

            }
            catch {

                budgetError.style.display = "block";

            }

        }


        async function showCreatePanel() {

            openPanel("Add Budget", `

                <form id="createBudgetForm">

                    <div class="category-form-group">
                        <label>Budget name</label>
                        <input id="createname" class="category-input"
                               placeholder="e.g. Groceries" required>
                    </div>

                    <div class="category-form-group">
                        <label>Category</label>
                        <select id="createCategoryID" class="category-input">
                            <option>Loading categories...</option>
                        </select>
                    </div>

                    <div class="category-form-group">
                        <label>Budget Limit</label>
                        <input id="createLimit" type="number"
                               min="1" step="0.01"
                               class="category-input"
                               placeholder="Enter budget limit" required>
                    </div>

                    <div id="createError" class="category-panel-error" style="display:none;"></div>

                    <button type="submit" class="category-panel-primary">
                        <i class="bi bi-check-circle"></i> Save Budget
                    </button>

                </form>

            `);

            const response = await fetch("/api/Category", { headers });

            if (!response.ok) {

                document.getElementById("createError").textContent =
                    "Unable to load categories.";
                return;

            }

            const categories = await response.json();

            document.getElementById("createCategoryID").innerHTML =
                categories.map(category =>
                    `<option value="${category.categoryID}">${escapeHtml(category.name)}</option>`
                ).join("");

            document
                .getElementById("createBudgetForm")
                .addEventListener("submit", createBudget);

        }


        async function createBudget(event) {

            event.preventDefault();

            const name = document.getElementById("createname").value.trim();
            const categoryID = document.getElementById("createCategoryID").value;
            const limit = Number(document.getElementById("createLimit").value);
            const error = document.getElementById("createError");

            if (!name || limit <= 0) {

                error.textContent = "Enter a valid budget name and limit.";
                error.style.display = "block";
                return;

            }

            try {

                const response =
                    await fetch("/api/Budget", {

                        method: "POST",

                        headers: {
                            ...headers,
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify({
                            username: name,
                            categoryID: categoryID,
                            limits: limit
                        })

                    });

                if (!response.ok)
                    throw new Error();

                closePanel();
                loadBudgets();

            }
            catch {

                error.textContent = "Unable to create budget.";
                error.style.display = "block";

            }

        }


        async function showDetails(id) {

            try {

                const response =
                    await fetch(`/api/Budget/${id}`, { headers });

                if (!response.ok)
                    throw new Error();

                const budget = await response.json();

                const categoryResponse =
                    await fetch(`/api/Category/${budget.categoryID}`, { headers });

                const category = categoryResponse.ok
                    ? await categoryResponse.json()
                    : null;

                const name = budget.username || "Unnamed Budget";
                const limit = Number(budget.limits) || 0;
                const date = budget.date
                    ? new Date(budget.date).toLocaleDateString()
                    : "Unknown";

                openPanel("Budget Details", `

                    <div class="category-detail">

                        <div class="category-detail-icon">
                            <i class="bi bi-piggy-bank-fill"></i>
                        </div>

                        <h3>
                            ${escapeHtml(name)}
                        </h3>

                        <div class="category-detail-block">
                            <span>Budget Category</span>
                            <strong>${escapeHtml(category?.name || "Unknown Category")}</strong>
                        </div>

                        <div class="category-detail-block">
                            <span>Budget Limit</span>
                            <strong>$${limit.toFixed(2)}</strong>
                        </div>

                        <div class="category-detail-block">
                            <span>Created</span>
                            <strong>${date}</strong>
                        </div>

                    </div>

                `);

            }
            catch {

                showPanelError("Budget Details", "Unable to load budget.");

            }

        }


        async function showEditPanel(id) {

            try {

                const response =
                    await fetch(`/api/Budget/${id}`, { headers });

                if (!response.ok)
                    throw new Error();

                const budget = await response.json();

                openPanel("Edit Budget", `

                    <form id="editBudgetForm">

                        <div class="category-form-group">
                            <label>Budget name</label>
                            <input id="editname" class="category-input"
                                   value="${escapeHtml(budget.username)}" required>
                        </div>

                        <div class="category-form-group">
                            <label>Budget Limit</label>
                            <input id="editLimit" type="number"
                                   min="1" step="0.01"
                                   class="category-input"
                                   value="${budget.limits}" required>
                        </div>

                        <div id="editError" class="category-panel-error" style="display:none;"></div>

                        <button type="submit" class="category-panel-primary">
                            <i class="bi bi-save"></i> Update Budget
                        </button>

                    </form>

                `);

                document
                    .getElementById("editBudgetForm")
                    .addEventListener("submit", event => updateBudget(event, id));

            }
            catch {

                showPanelError("Edit Budget", "Unable to load budget.");

            }

        }


        async function updateBudget(event, id) {

            event.preventDefault();

            const name = document.getElementById("editname").value.trim();
            const limit = Number(document.getElementById("editLimit").value);
            const error = document.getElementById("editError");

            if (!name || limit <= 0) {

                error.textContent = "Enter a valid budget name and limit.";
                error.style.display = "block";
                return;

            }

            try {

                const response =
                    await fetch(`/api/Budget/${id}`, {

                        method: "PUT",

                        headers: {
                            ...headers,
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify({
                            username: name,
                            limits: limit
                        })

                    });

                if (!response.ok)
                    throw new Error();

                closePanel();
                loadBudgets();

            }
            catch {

                error.textContent = "Unable to update budget.";
                error.style.display = "block";

            }

        }


        function showDeletePanel(id) {

            openPanel("Delete Budget", `

                <div class="category-delete-box">

                    <div class="category-delete-icon">
                        <i class="bi bi-trash-fill"></i>
                    </div>

                    <h3>Delete Budget?</h3>

                    <p>
                        Are you sure you want to delete this budget?
                        This action cannot be undone.
                    </p>

                    <div class="category-delete-actions">

                        <button
                            class="category-panel-cancel"
                            onclick="closePanel()">

                            Cancel

                        </button>

                        <button
                            class="category-panel-danger"
                            onclick="deleteBudget(${id})">

                            <i class="bi bi-trash"></i>
                            Delete

                        </button>

                    </div>

                </div>

            `);

        }


        async function deleteBudget(id) {

            try {

                const response =
                    await fetch(`/api/Budget/${id}`, {
                        method: "DELETE",
                        headers
                    });

                if (!response.ok)
                    throw new Error();

                closePanel();
                loadBudgets();

            }
            catch {

                showPanelError("Delete Budget", "Unable to delete budget.");

            }

        }


        function showPanelError(title, message) {

            openPanel(
                title,
                `<div class="category-panel-error">${message}</div>`
            );

        }


        loadBudgets();

    </script>

    <script src="~/js/authGuard.js"></script>
}
