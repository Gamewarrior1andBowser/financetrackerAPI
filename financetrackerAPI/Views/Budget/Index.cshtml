@{
    ViewData["Title"] = "Budgets";
}


<div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="fw-bold">
        <i class="bi bi-piggy-bank-fill me-2"></i>
        Budgets
    </h1>


    <a asp-controller="BudgetPage"
       asp-action="Create"
       class="btn btn-success">

        <i class="bi bi-plus-circle me-1"></i>
        Add Budget

    </a>

</div>



<div class="card shadow border-0 p-4">


    <div class="table-responsive">


        <table class="table table-hover">


            <thead class="table-primary">


                <tr>

                    <th>Budget Name</th>

                    <th>limits</th>

                    <th>Date Created</th>

                    <th>Actions</th>


                </tr>


            </thead>


            <tbody id="budgetTable">


            </tbody>


        </table>


    </div>


</div>



@section Scripts {

<script>


async function loadBudgets(){


    const response = await fetch("/api/Budget");


    if(response.ok){


        const budgets = await response.json();


        let rows = "";


        budgets.forEach(budget => {


            rows += `

            <tr>

                <td>${budget.name}</td>


                <td>
                    $${budget.limit}
                </td>


                <td>
                    ${budget.date}
                </td>


                <td>


                    <a href="/BudgetPage/Details/${budget.budgetID}"
                       class="btn btn-info btn-sm">

                       <i class="bi bi-eye"></i>

                    </a>



                    <a href="/BudgetPage/Edit/${budget.budgetID}"
                       class="btn btn-warning btn-sm">

                       <i class="bi bi-pencil"></i>

                    </a>



                    <a href="/BudgetPage/Delete/${budget.budgetID}"
                       class="btn btn-danger btn-sm">

                       <i class="bi bi-trash"></i>

                    </a>


                </td>


            </tr>

            `;


        });


        document.getElementById("budgetTable").innerHTML = rows;


    }


}


loadBudgets();


</script>

}