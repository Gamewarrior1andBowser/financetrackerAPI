@{
    ViewData["Title"] = "Budgets";
}

<div class="container">

    <h1 class="fw-bold mb-4">
        <i class="bi bi-piggy-bank-fill me-2"></i>
        Budgets
    </h1>

    <div class="card shadow p-4">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Limit</th>
                        <th>Date Set</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="budgetTable"></tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
<script>

const token = localStorage.getItem("token");

loadBudgets();

async function loadBudgets() {

    const [budgetsRes, categoriesRes] = await Promise.all([
        fetch("/api/Budget", { headers: { "Authorization": "Bearer " + token } }),
        fetch("/api/Category", { headers: { "Authorization": "Bearer " + token } })
    ]);

    if (!budgetsRes.ok) {
        alert("Unable to load budgets");
        return;
    }

    const budgets = await budgetsRes.json();
    const categories = categoriesRes.ok ? await categoriesRes.json() : [];

    let rows = "";

    if (budgets.length === 0) {
        rows = `<tr><td colspan="4" class="text-center text-muted">No budgets yet. Create a category to add one.</td></tr>`;
    }

    budgets.forEach(budget => {
        const category = categories.find(c => c.categoryID === budget.categoryID);
        const categoryName = category ? category.name : "Unknown category";

        rows += `
        <tr>
            <td>${categoryName}</td>
            <td>$${budget.limit.toFixed(2)}</td>
            <td>${budget.date.substring(0, 10)}</td>
            <td>
                <a href="/BudgetPage/Details/${budget.budgetID}" class="btn btn-info btn-sm">
                    <i class="bi bi-eye-fill"></i>
                </a>
            </td>
        </tr>
        `;
    });

    document.getElementById("budgetTable").innerHTML = rows;
}

</script>
}
