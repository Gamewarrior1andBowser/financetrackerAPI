@{
    ViewData["Title"] = "Add Budget";
}

<div class="budget-form-page">
    <div class="budget-form-card">

        <div class="budget-form-header">
            <div class="budget-form-icon">
                <i class="bi bi-piggy-bank-fill"></i>
            </div>

            <div>
                <h1>Add Budget</h1>
                <p>Set a spending limit for your budget.</p>
            </div>
        </div>

        <form id="createBudgetForm">

            <div class="budget-form-group">
                <label for="name">Budget Name</label>
                <input id="name"
                       type="text"
                       class="form-control"
                       placeholder="e.g. Groceries, Rent, Travel"
                       required />
            </div>

            <div class="budget-form-group">
                <label for="categoryID">Category</label>

                <select id="categoryID" class="form-select" required>
                    <option>Loading categories...</option>
                </select>
            </div>

            <div class="budget-form-group">
                <label for="limits">Budget Limit</label>

                <input id="limits"
                       type="number"
                       min="1"
                       step="0.01"
                       class="form-control"
                       placeholder="Enter budget limit"
                       required />

                <small class="text-muted">
                    Set the maximum amount you want to spend for this budget.
                </small>
            </div>

            <div id="createError"
                 class="budget-form-error"
                 style="display:none;">
            </div>

            <div class="budget-form-actions">
                <a asp-controller="BudgetPage"
                   asp-action="Index"
                   class="budget-cancel-btn">
                    <i class="bi bi-arrow-left"></i> Back
                </a>

                <button type="submit" class="budget-save-btn">
                    <i class="bi bi-check-circle"></i> Save Budget
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        const token = localStorage.getItem("token");
        const headers = { Authorization: "Bearer " + token };

        document.getElementById("createBudgetForm")
            .addEventListener("submit", createBudget);

        async function loadCategories() {
            const response = await fetch("/api/Category", { headers });
            const dropdown = document.getElementById("categoryID");

            if (!response.ok) {
                dropdown.innerHTML = "<option>No categories available</option>";
                return;
            }

            const categories = await response.json();

            if (!categories.length) {
                dropdown.innerHTML = "<option value=''>No categories available</option>";
                return;
            }

            dropdown.innerHTML = categories.map(category =>
                `<option value="${category.categoryID}">
                        ${category.name}
                    </option>`
            ).join("");
        }

        function showError(message) {
            const error = document.getElementById("createError");
            error.textContent = message;
            error.style.display = "block";
        }

        async function createBudget(event) {
            event.preventDefault();

            const name = document.getElementById("name").value.trim();
            const categoryID = Number(document.getElementById("categoryID").value);
            const limits = Number(document.getElementById("limits").value);

            if (!name) {
                showError("Please enter a budget name.");
                return;
            }

            if (!categoryID) {
                showError("Please select a category.");
                return;
            }

            if (!limits || limits <= 0) {
                showError("Please enter a valid budget limit.");
                return;
            }

            const budget = {
                username: name,
                categoryID: categoryID,
                limits: limits,
                date: new Date().toISOString()
            };

            const response = await fetch("/api/Budget", {
                method: "POST",
                headers: { ...headers, "Content-Type": "application/json" },
                body: JSON.stringify(budget)
            });

            if (!response.ok) {
                showError("Unable to create budget.");
                return;
            }

            window.location.href = "/BudgetPage";
        }

        loadCategories();
    </script>
}