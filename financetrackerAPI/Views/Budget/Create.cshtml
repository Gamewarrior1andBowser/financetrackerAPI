@{
    ViewData["Title"] = "Add Budget";
}


<div class="row justify-content-center">

    <div class="col-md-6">

        <div class="card shadow border-0 p-4">


            <h2 class="mb-4">

                <i class="bi bi-plus-circle-fill me-2"></i>

                Add Budget

            </h2>



            <div class="mb-3">

                <label class="form-label">
                    Budget Name
                </label>


                <input id="name"
                       type="text"
                       class="form-control"
                       placeholder="e.g. Groceries, Rent, Travel" />

            </div>


            <div class="mb-3">

                <label class="form-label">
                    Category
                </label>


                <select id="categoryID"
                        class="form-select">

                    <option>
                        Loading categories...
                    </option>

                </select>


            </div>


            <div class="mb-4">

                <label class="form-label">
                    Budget limits
                </label>


                <input id="limit"
                       type="number"
                       min="1"
                       step="0.01"
                       class="form-control"
                       placeholder="Enter budget limit" />


                <small class="text-muted">

                    Set the maximum amount you want to spend for this budget.

                </small>


            </div>




            <div id="createError"
                 class="alert alert-danger"
                 style="display:none;">
            </div>





            <div class="d-flex gap-2">


                <button class="btn btn-success"
                        onclick="createBudget()">


                    <i class="bi bi-check-circle me-1"></i>

                    Save


                </button>




                <a asp-controller="BudgetPage"
                   asp-action="Index"
                   class="btn btn-secondary">


                    <i class="bi bi-arrow-left-circle me-1"></i>

                    Back


                </a>


            </div>


        </div>

    </div>

</div>



@section Scripts {


<script>


    const token = localStorage.getItem("token");

    loadCategories();



    async function loadCategories() {


        const response = await fetch("/api/Category",
            {

                headers:
                {

                    "Authorization": "Bearer " + token

                }


            });

        const categories = await response.json();
        const dropdown = document.getElementById("categoryID");

        if (categories.length === 0) {
            dropdown.innerHTML = `<option value="">No categories available</option>`;
            return;
        }


        if (!response.ok) {

            document.getElementById("categoryID").innerHTML =
                "<option>No Categories</option>";

            return;

        }



        let options = "";




        categories.forEach(category => {


            options += `

                <option value="${category.categoryID}">

                    ${category.name}

                </option>

                `;


        });

        dropdown.innerHTML = options;

        document.getElementById("categoryID").innerHTML = options;
    }



    function showError(message)
    {

        const box = document.getElementById("createError");

        box.innerText = message;

        box.style.display = "block";

    }




    async function createBudget()
    {


        const name =
            document.getElementById("name").value.trim();



        const limit =
            Number(document.getElementById("limit").value);




        if(!name)
        {
            showError("Please enter a budget name.");
            return;
        }



        if(!limit || limit <= 0)
        {
            showError("Please enter a valid budget limit.");
            return;
        }





        const budget = {

            name: name,

            categoryID: categoryID,

            limit: limit,

            date: new Date().toISOString()

        };





        const response = await fetch("/api/Budget",
        {

            method:"POST",

            headers:
            {

                "Content-Type":"application/json",

                "Authorization":"Bearer " + token

            },


            body: JSON.stringify(budget)

        });






        if(!response.ok)
        {

            showError("Unable to create budget.");

            return;

        }




        window.location.href="/BudgetPage";

    }



</script>


}
