@{
    ViewData["Title"] = "Add Budget";
}

<div class="budget-form-page">

    <div class="budget-form-card">

        <div class="budget-form-header">
            <div class="budget-form-icon">
                <i class="bi bi-piggy-bank-fill"></i>
            </div>

            <div>
                <h1>Add Budget</h1>
                <p>Set a spending limit for your budget.</p>
            </div>
        </div>

        <form id="createBudgetForm">

            <div class="budget-form-group">
                <label for="name">Budget Name</label>

                <input id="name"
                       type="text"
                       class="form-control"
                       placeholder="e.g. Groceries, Rent, Travel"
                       required />
            </div>

            <div class="budget-form-group">
                <label for="limit">Budget Limit</label>

                <div class="budget-input">
                    <span>$</span>

                    <input id="limit"
                           type="number"
                           min="1"
                           step="0.01"
                           placeholder="0.00"
                           required />
                </div>
            </div>

            <div id="createError"
                 class="budget-form-error"
                 style="display:none;">
            </div>

            <div class="budget-form-actions">

                <a asp-controller="BudgetPage"
                   asp-action="Index"
                   class="budget-cancel-btn">
                    <i class="bi bi-arrow-left"></i>
                    Back
                </a>

                <button type="submit"
                        class="budget-save-btn">
                    <i class="bi bi-check-circle"></i>
                    Save Budget
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <script>

        const token = localStorage.getItem("token");

        const form = document.getElementById("createBudgetForm");
        const errorBox = document.getElementById("createError");


        function showError(message) {

            errorBox.textContent = message;
            errorBox.style.display = "block";

        }


        form.addEventListener("submit", async function(e) {

            e.preventDefault();

            errorBox.style.display = "none";

            const name = document
                .getElementById("name")
                .value
                .trim();

            const limit = Number(
                document.getElementById("limit").value
            );


            if (!name) {

            
            let valid = true;
            [nameInput, limitInput].forEach(input => input.classList.remove('is-invalid'));

            }


            if (!limit || limit <= 0) {

                showError("Please enter a valid budget limit.");
                return;

            }


            const budget = {

                username: name,

                limits: limit

            };


            try {

                const response = await fetch("/api/Budget", {

                    method: "POST",

                    headers: {

                        "Content-Type": "application/json",

                        "Authorization": "Bearer " + token

                    },

                    body: JSON.stringify(budget)

                });


                if (!response.ok) {

                    const message = await response.text();

                    console.error(message);

                    showError("Unable to create budget.");

                
                setTimeout(() => {
                    window.location.href = '@Url.Action("Index", "BudgetPage")';
                }, 1200);

                }


