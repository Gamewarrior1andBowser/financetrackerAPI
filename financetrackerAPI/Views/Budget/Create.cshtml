@{
    ViewData["Title"] = "Add Budget";
}

<div class="budget-form-page">

    <div class="budget-form-card">

        <div class="budget-form-header">
            <div class="budget-form-icon">
                <i class="bi bi-piggy-bank-fill"></i>
            </div>

            <div>
                <h1>Add Budget</h1>
                <p>Set a spending limit for your budget.</p>
            </div>
        </div>

        <form id="createBudgetForm">

            <div class="budget-form-group">
                <label for="name">Budget Name</label>

                <input id="name"
                       type="text"
                       class="form-control"
                       placeholder="e.g. Groceries, Rent, Travel"
                       required />
            </div>

            <div class="budget-form-group">
                <label for="limit">Budget Limit</label>

            <div class="mb-3">

                <label class="form-label">
                    Category
                </label>


                <select id="categoryID"
                        class="form-select">

                    <option>
                        Loading categories...
                    </option>

                </select>


            </div>


            <div class="mb-4">

                <label class="form-label">
                    Budget limits
                </label>


                <input id="limits"
                       type="number"
                       min="1"
                       step="0.01"
                       class="form-control"
                       placeholder="Enter budget limits" />


                <small class="text-muted">

                    Set the maximum amount you want to spend for this budget.

                </small>


            </div>

            <div id="createError"
                 class="budget-form-error"
                 style="display:none;">
            </div>

            <div class="budget-form-actions">

                <a asp-controller="BudgetPage"
                   asp-action="Index"
                   class="budget-cancel-btn">
                    <i class="bi bi-arrow-left"></i>
                    Back
                </a>

                <button type="submit"
                        class="budget-save-btn">
                    <i class="bi bi-check-circle"></i>
                    Save Budget
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <script>


    const token = localStorage.getItem("token");

    loadCategories();



    async function loadCategories() {


        const response = await fetch("/api/Category",
            {

                headers:
                {

                    "Authorization": "Bearer " + token

                }


            });

        const categories = await response.json();
        const dropdown = document.getElementById("categoryID");

        if (categories.length === 0) {
            dropdown.innerHTML = `<option value="">No categories available</option>`;
            return;
        }


        if (!response.ok) {

            document.getElementById("categoryID").innerHTML =
                "<option>No Categories</option>";

            return;

        }



        let options = "";




        categories.forEach(category => {


            options += `

                <option value="${category.categoryID}">

                    ${category.name}

                </option>

                `;


        });

        dropdown.innerHTML = options;

        document.getElementById("categoryID").innerHTML = options;
    }



    function showError(message)
    {

        const box = document.getElementById("createError");

        box.innerText = message;

        box.style.display = "block";

    }




