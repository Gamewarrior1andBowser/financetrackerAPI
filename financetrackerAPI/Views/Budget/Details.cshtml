@{
    ViewData["Title"] = "Budget Details";
    var budgetID = ViewData["budgetID"];
}

<div class="budget-form-page">

    <div class="budget-details-card">

        <div class="budget-details-header">

            <div class="budget-form-icon">
                <i class="bi bi-piggy-bank-fill"></i>
            </div>

            <div>
                <h1>Budget Details</h1>
                <p>View information about this budget.</p>
            </div>

        </div>

        <div id="budgetDetails">

            <div class="budget-detail-row">
                <span>Budget Name</span>
                <strong id="budgetName">Loading...</strong>
            </div>

            <div class="budget-detail-row">
                <span>Budget Limit</span>
                <strong id="budgetLimit">Loading...</strong>
            </div>

            <div class="budget-detail-row">
                <span>Date Created</span>
                <strong id="budgetDate">Loading...</strong>
            </div>

        </div>

        <div id="detailsError"
             class="budget-form-error"
             style="display:none;">
        </div>

        <a asp-controller="BudgetPage"
           asp-action="Index"
           class="btn btn-secondary mt-4">
            <i class="bi bi-arrow-left-circle me-1"></i>
            Back
        </a>

    </div>

</div>

@section Scripts {

    <script>

        const id = @budgetID;
        const token = localStorage.getItem("token");

        async function loadBudget() {

            try {

                const response =
                    await fetch(`/api/Budget/${id}`, {
                        headers: {
                            "Authorization": "Bearer " + token
                        }
                    });

                if (!response.ok) {
                    throw new Error();
                }

                const budget = await response.json();

                document.getElementById("budgetName").textContent =
                    budget.username || "Unnamed Budget";

                document.getElementById("budgetLimit").textContent =
                    "$" + Number(budget.limits || 0).toFixed(2);

                document.getElementById("budgetDate").textContent =
                    budget.date
                        ? new Date(budget.date).toLocaleDateString()
                        : "Unknown";

            }
            catch {

                const error =
                    document.getElementById("detailsError");

                error.textContent =
                    "Unable to load budget details.";

                error.style.display = "block";
            }
        }

        loadBudget();

    </script>

}