@{
    ViewData["Title"] = "Budget Details";

    var budgetID = ViewData["budgetID"];
}



<div class="card shadow border-0 p-4">


<h2 class="fw-bold mb-4">

<i class="bi bi-piggy-bank-fill me-2"></i>

Budget Details

</h2>



<div id="details">


    <p>
        <strong>Name:</strong>
        <span id="budgetName"></span>
    </p>



    <p>
        <strong>limits:</strong>
        $<span id="budgetlimits"></span>
    </p>



    <p>
        <strong>date Created:</strong>
        <span id="budgetdate"></span>
    </p>



</div>




<a asp-controller="BudgetPage"
   asp-action="Index"
   class="btn btn-secondary">

Back

</a>



</div>




@section Scripts {


<script>


async function loadBudget(){


    const id = @budgetID;



    const response = await fetch(
        `/api/Budget/${id}`
    );



    if(response.ok)
    {

        const budget = await response.json();



        document.getElementById("budgetName")
        .innerText = budget.name;



        document.getElementById("budgetlimits")
        .innerText = budget.limit;



        document.getElementById("budgetdate")
        .innerText =
        new date(budget.date)
        .toLocaledateString();



    }
  

}



loadBudget();



</script>


}