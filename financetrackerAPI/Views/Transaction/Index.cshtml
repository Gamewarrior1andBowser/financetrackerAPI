@{
    ViewData["Title"] = "Transactions";
}

<div class="transaction-page">

    <div class="transaction-header">

        <div>
            <h1 class="transaction-title">
                <i class="bi bi-receipt me-2"></i>
                Transactions
            </h1>

            <p class="transaction-description">
                View and manage your transactions.
            </p>
        </div>

        <a asp-controller="TransactionPage"
           asp-action="Create"
           class="transaction-add-btn">

            <i class="bi bi-plus-circle-fill"></i>
            Add Transaction

        </a>

    </div>

    <div id="transactionError"
         class="transaction-error"
         style="display:none;">
    </div>

    <div class="transaction-card">

        <table class="transaction-table">

            <thead>
                <tr>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody id="transactionTableBody">

                <tr>
                    <td colspan="5" class="transaction-empty">
                        Loading transactions...
                    </td>
                </tr>

            </tbody>

        </table>

    </div>

</div>

@section Scripts {

    <script src="~/js/authGuard.js"></script>

    <script>

        const token = localStorage.getItem("token");

        async function loadTransactions() {

            const tableBody =
                document.getElementById("transactionTableBody");

            try {

                const response = await fetch("/api/Transactions", {
                    headers: {
                        "Authorization": "Bearer " + token
                    }
                });

                if (!response.ok) {

                    tableBody.innerHTML = `
                                <tr>
                                    <td colspan="5">
                                        <div class="transaction-error">
                                            Unable to load transactions.
                                        </div>
                                    </td>
                                </tr>
                            `;

                    return;
                }

                const transactions = await response.json();

                if (!transactions || transactions.length === 0) {

                    tableBody.innerHTML = `
                                <tr>
                                    <td colspan="5">
                                        <div class="transaction-empty">

                                            <div class="transaction-empty-icon">
                                                <i class="bi bi-receipt"></i>
                                            </div>

                                            <h3>No Transactions</h3>

                                            <p>
                                                You have not added any transactions yet.
                                            </p>

                                        </div>
                                    </td>
                                </tr>
                            `;

                    return;
                }

                tableBody.innerHTML = "";

                transactions.forEach(transaction => {

                    const type =
                        transaction.type ?? "Expense";

                    const isIncome =
                        type.toLowerCase() === "income";

                    const amountClass =
                        isIncome
                            ? "transaction-income"
                            : "transaction-expense";

                    const typeClass =
                        isIncome
                            ? "income"
                            : "expense";

                    const sign =
                        isIncome ? "+" : "-";

                    const category =
                        transaction.categoryName ??
                        transaction.category?.name ??
                        "No Category";

                    const date =
                        transaction.date
                            ? transaction.date.substring(0, 10)
                            : "N/A";

                    const id =
                        transaction.transactionsID ??
                        transaction.transactionID;

                    tableBody.innerHTML += `

                                <tr>

                                    <td>
                                        <span class="transaction-name">
                                            ${category}
                                        </span>
                                    </td>

                                    <td>
                                        <span class="transaction-type ${typeClass}">
                                            ${type}
                                        </span>
                                    </td>

                                    <td>
                                        <span class="${amountClass}">
                                            ${sign}$${Number(transaction.amount).toFixed(2)}
                                        </span>
                                    </td>

                                    <td>
                                        <span class="transaction-date">
                                            ${date}
                                        </span>
                                    </td>

                                    <td>

                                        <div class="transaction-actions">

                                            <a href="/TransactionPage/Details/${id}"
                                               class="transaction-action transaction-view"
                                               title="View Details">

                                                <i class="bi bi-eye-fill"></i>

                                            </a>

                                            <a href="/TransactionPage/Edit/${id}"
                                               class="transaction-action transaction-edit"
                                               title="Edit">

                                                <i class="bi bi-pencil-fill"></i>

                                            </a>

                                            <button type="button"
                                                    class="transaction-action transaction-delete"
                                                    title="Delete"
                                                    onclick="deleteTransaction(${id})">

                                                <i class="bi bi-trash-fill"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>

                            `;

                });

            }
            catch (error) {

                console.error(error);

                tableBody.innerHTML = `
                            <tr>
                                <td colspan="5">
                                    <div class="transaction-error">
                                        Something went wrong while loading transactions.
                                    </div>
                                </td>
                            </tr>
                        `;

            }

        }


        async function deleteTransaction(id) {

            if (!confirm("Are you sure you want to delete this transaction?")) {
                return;
            }

            try {

                const response = await fetch(
                    "/api/Transactions/" + id,
                    {
                        method: "DELETE",

                        headers: {
                            "Authorization": "Bearer " + token
                        }
                    }
                );

                if (response.ok) {

                    loadTransactions();

                }
                else {

                    alert("Unable to delete transaction.");

                }

            }
            catch (error) {

                console.error(error);

                alert("Something went wrong while deleting the transaction.");

            }

        }


        loadTransactions();

    </script>
}