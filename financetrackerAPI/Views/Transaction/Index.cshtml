@{
    ViewData["Title"] = "Transactions";
}

<div class="transaction-page">
    <div class="transaction-header">
        <div>
            <h1 class="transaction-title">
                <i class="bi bi-receipt"></i> Transactions
            </h1>
            <p class="transaction-description">View and manage your transactions.</p>
        </div>

        <button type="button" class="transaction-add-btn" onclick="showCreatePanel()">
            <i class="bi bi-plus-lg"></i> Add Transaction
        </button>
    </div>

    <div class="transaction-content">
        <main class="transaction-main">
            <div id="transactionGrid" class="transaction-grid"></div>

            <div id="transactionEmpty" class="transaction-empty" style="display:none;">
                <div class="transaction-empty-icon">
                    <i class="bi bi-receipt"></i>
                </div>
                <h3>No transactions yet</h3>
                <p>Add your first transaction to start tracking your money.</p>
                <button type="button" class="transaction-add-btn" onclick="showCreatePanel()">
                    <i class="bi bi-plus-lg"></i> Add Transaction
                </button>
            </div>

            <div id="transactionError" class="transaction-error" style="display:none;">
                Unable to load transactions.
            </div>
        </main>

        <aside id="transactionPanel" class="transaction-panel">
            <div class="transaction-panel-header">
                <div>
                    <h2 id="panelTitle">Transaction</h2>
                    <p>Manage this transaction</p>
                </div>
                <button type="button" class="transaction-panel-close" onclick="closePanel()">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div id="panelContent" class="transaction-panel-content"></div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        const token = localStorage.getItem("token");
        const headers = { Authorization: "Bearer " + token };
        const grid = document.getElementById("transactionGrid");
        const empty = document.getElementById("transactionEmpty");
        const errorBox = document.getElementById("transactionError");
        const panel = document.getElementById("transactionPanel");
        const panelTitle = document.getElementById("panelTitle");
        const panelContent = document.getElementById("panelContent");

        function escapeHtml(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function openPanel(title, content) {
            panelTitle.innerHTML = `<i class="bi bi-receipt"></i> ${title}`;
            panelContent.innerHTML = content;
            panel.classList.add("open");
        }

        function closePanel() {
            panel.classList.remove("open");
        }

        async function loadTransactions() {
            try {
                const response = await fetch("/api/Transactions", { headers });
                if (!response.ok) throw new Error();

                const transactions = await response.json();

                if (!transactions.length) {
                    grid.innerHTML = "";
                    empty.style.display = "block";
                    return;
                }

                empty.style.display = "none";

                grid.innerHTML = transactions.map(t => {
                    const income = t.type === "Income";
                    const amount = `${income ? "+" : "-"}$${Number(t.amount || 0).toFixed(2)}`;
                    const date = t.date ? new Date(t.date).toLocaleDateString() : "Unknown";

                    return `
                        <article class="transaction-card">
                            <div class="transaction-card-body">
                                <div class="transaction-card-icon">
                                    <i class="bi bi-receipt"></i>
                                </div>

                                <h2>${escapeHtml(t.categoryName || "No Category")}</h2>

                                <div class="transaction-summary">
                                    <span class="transaction-type ${income ? "income" : "expense"}">
                                        ${income ? "Income" : "Expense"}
                                    </span>
                                    <strong class="transaction-amount ${income ? "transaction-income" : "transaction-expense"}">
                                        ${amount}
                                    </strong>
                                </div>

                                <div class="transaction-date">
                                    <i class="bi bi-calendar3"></i> ${date}
                                </div>

                                <div class="transaction-note">
                                    <i class="bi bi-sticky"></i>
                                    <span>${escapeHtml(t.notes?.trim() || "N/A")}</span>
                                </div>
                            </div>

                            <div class="transaction-card-actions">
                                <button type="button" class="transaction-card-btn transaction-view-btn"
                                        onclick="showDetails(${t.transactionsID})">
                                    <i class="bi bi-eye"></i> View Details
                                </button>

                                <button type="button" class="transaction-card-btn transaction-edit-btn"
                                        onclick="showEditPanel(${t.transactionsID})">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>

                                <button type="button" class="transaction-card-btn transaction-delete-btn"
                                        onclick="showDeletePanel(${t.transactionsID})">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        </article>`;
                }).join("");

            } catch {
                errorBox.style.display = "block";
            }
        }

        async function loadCategories(selected = "") {
            const response = await fetch("/api/Category", { headers });
            if (!response.ok) return "";

            const categories = await response.json();

            return `
                <option value="">Select a category</option>
                ${categories.map(c => `
                    <option value="${c.categoryID}"
                        ${Number(c.categoryID) === Number(selected) ? "selected" : ""}>
                        ${escapeHtml(c.name)}
                    </option>
                `).join("")}`;
        }

        function showCreatePanel(type = "Expense") {
            openPanel("Add Transaction", `
                <form id="createTransactionForm">

                    <div class="transaction-form-group">
                        <label>Amount</label>
                        <input id="createAmount" type="number" min="0.01" step="0.01"
                               class="transaction-input" required>
                    </div>

                    <div class="transaction-form-group">
                        <label>Category</label>
                        <select id="createCategory" class="transaction-input" required>
                            <option>Loading...</option>
                        </select>
                    </div>

                    <div class="transaction-form-group">
                        <label>Type</label>
                        <select id="createType" class="transaction-input">
                            <option value="Expense" ${type === "Expense" ? "selected" : ""}>Expense</option>
                            <option value="Income" ${type === "Income" ? "selected" : ""}>Income</option>
                        </select>
                    </div>

                    <div class="transaction-form-group">
                        <label>Date</label>
                        <input id="createDate" type="date" class="transaction-input">
                    </div>

                    <div class="transaction-form-group">
                        <label>Notes <span class="transaction-optional">Optional</span></label>
                        <textarea id="createNotes" class="transaction-input transaction-textarea"
                                  placeholder="Add a note if you want..."></textarea>
                    </div>

                    <div id="createError" class="transaction-panel-error" style="display:none;"></div>

                    <button class="transaction-panel-primary">
                        <i class="bi bi-check-circle"></i> Save Transaction
                    </button>
                </form>`);

            loadCategories().then(options => {
                document.getElementById("createCategory").innerHTML = options;
            });

            document.getElementById("createTransactionForm")
                .addEventListener("submit", createTransaction);
        }

        async function createTransaction(event) {
            event.preventDefault();

            const error = document.getElementById("createError");

            const data = {
                amount: Number(document.getElementById("createAmount").value),
                categoryID: Number(document.getElementById("createCategory").value),
                type: document.getElementById("createType").value,
                date: document.getElementById("createDate").value,
                notes: document.getElementById("createNotes").value.trim() || null
            };

            if (data.amount <= 0 || !data.categoryID) {
                error.textContent = "Enter a valid amount and category.";
                error.style.display = "block";
                return;
            }

            try {
                const response = await fetch("/api/Transactions", {
                    method: "POST",
                    headers: { ...headers, "Content-Type": "application/json" },
                    body: JSON.stringify(data)
                });

                if (!response.ok) throw new Error();

                closePanel();
                loadTransactions();
            } catch {
                error.textContent = "Unable to create transaction.";
                error.style.display = "block";
            }
        }

        async function showDetails(id) {
            try {
                const response = await fetch(`/api/Transactions/${id}`, { headers });
                if (!response.ok) throw new Error();

                const t = await response.json();
                const income = t.type === "Income";

                openPanel("Transaction Details", `
                    <div class="transaction-detail">
                        <div class="transaction-detail-icon">
                            <i class="bi bi-receipt"></i>
                        </div>

                        <div class="transaction-detail-block">
                            <span>Category</span>
                            <strong>${escapeHtml(t.categoryName || "No Category")}</strong>
                        </div>

                        <div class="transaction-detail-block">
                            <span>Type</span>
                            <strong class="${income ? "transaction-income" : "transaction-expense"}">
                                ${escapeHtml(t.type || "Expense")}
                            </strong>
                        </div>

                        <div class="transaction-detail-block">
                            <span>Amount</span>
                            <strong class="${income ? "transaction-income" : "transaction-expense"}">
                                ${income ? "+" : "-"}$${Number(t.amount || 0).toFixed(2)}
                            </strong>
                        </div>

                        <div class="transaction-detail-block">
                            <span>Date</span>
                            <strong>${t.date ? new Date(t.date).toLocaleDateString() : "N/A"}</strong>
                        </div>

                        <div class="transaction-detail-block">
                            <span>Notes</span>
                            <strong class="transaction-notes-value">
                                ${escapeHtml(t.notes?.trim() || "N/A")}
                            </strong>
                        </div>
                    </div>`);
            } catch {
                showPanelError("Transaction Details", "Unable to load transaction.");
            }
        }

        async function showEditPanel(id) {
            try {
                const response = await fetch(`/api/Transactions/${id}`, { headers });
                if (!response.ok) throw new Error();

                const t = await response.json();
                const categories = await loadCategories(t.categoryID);

                openPanel("Edit Transaction", `
                    <form id="editTransactionForm">

                        <div class="transaction-form-group">
                            <label>Amount</label>
                            <input id="editAmount" type="number" min="0.01" step="0.01"
                                   class="transaction-input" value="${t.amount}" required>
                        </div>

                        <div class="transaction-form-group">
                            <label>Category</label>
                            <select id="editCategory" class="transaction-input" required>
                                ${categories}
                            </select>
                        </div>

                        <div class="transaction-form-group">
                            <label>Type</label>
                            <select id="editType" class="transaction-input">
                                <option value="Expense" ${t.type === "Expense" ? "selected" : ""}>Expense</option>
                                <option value="Income" ${t.type === "Income" ? "selected" : ""}>Income</option>
                            </select>
                        </div>

                        <div class="transaction-form-group">
                            <label>Date</label>
                            <input id="editDate" type="date" class="transaction-input"
                                   value="${t.date ? t.date.substring(0, 10) : ""}">
                        </div>

                        <div class="transaction-form-group">
                            <label>Notes <span class="transaction-optional">Optional</span></label>
                            <textarea id="editNotes" class="transaction-input transaction-textarea">${escapeHtml(t.notes || "")}</textarea>
                        </div>

                        <div id="editError" class="transaction-panel-error" style="display:none;"></div>

                        <button class="transaction-panel-primary">
                            <i class="bi bi-save"></i> Update Transaction
                        </button>
                    </form>`);

                document.getElementById("editTransactionForm")
                    .addEventListener("submit", e => updateTransaction(e, id));

            } catch {
                showPanelError("Edit Transaction", "Unable to load transaction.");
            }
        }

        async function updateTransaction(event, id) {
            event.preventDefault();

            const error = document.getElementById("editError");

            const data = {
                amount: Number(document.getElementById("editAmount").value),
                categoryID: Number(document.getElementById("editCategory").value),
                type: document.getElementById("editType").value,
                date: document.getElementById("editDate").value,
                notes: document.getElementById("editNotes").value.trim() || null
            };

            try {
                const response = await fetch(`/api/Transactions/${id}`, {
                    method: "PUT",
                    headers: { ...headers, "Content-Type": "application/json" },
                    body: JSON.stringify(data)
                });

                if (!response.ok) throw new Error();

                closePanel();
                loadTransactions();
            } catch {
                error.textContent = "Unable to update transaction.";
                error.style.display = "block";
            }
        }

        function showDeletePanel(id) {
            openPanel("Delete Transaction", `
                <div class="transaction-delete-box">
                    <div class="transaction-delete-icon">
                        <i class="bi bi-trash-fill"></i>
                    </div>

                    <h3>Delete Transaction?</h3>
                    <p>Are you sure you want to delete this transaction?</p>

                    <div class="transaction-delete-actions">
                        <button type="button" class="transaction-panel-cancel" onclick="closePanel()">
                            Cancel
                        </button>

                        <button type="button" class="transaction-panel-danger"
                                onclick="deleteTransaction(${id})">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>
                </div>`);
        }

        async function deleteTransaction(id) {
            try {
                const response = await fetch(`/api/Transactions/${id}`, {
                    method: "DELETE",
                    headers
                });

                if (!response.ok) throw new Error();

                closePanel();
                loadTransactions();
            } catch {
                showPanelError("Delete Transaction", "Unable to delete transaction.");
            }
        }

        function showPanelError(title, message) {
            openPanel(title, `<div class="transaction-panel-error">${message}</div>`);
        }

        loadTransactions();

        const requestedType = new URLSearchParams(location.search).get("type");

        if (requestedType === "Income" || requestedType === "Expense") {
            showCreatePanel(requestedType);
        }
    </script>

    <script src="~/js/authGuard.js"></script>
}