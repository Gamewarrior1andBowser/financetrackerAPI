@{
    ViewData["Title"] = "Transactions";
}


<div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="fw-bold">

        <i class="bi bi-cash-stack me-2"></i>

        Transactions

    </h1>


    <a asp-controller="TransactionPage"
       asp-action="Create"
       class="btn btn-success">

        <i class="bi bi-plus-circle me-1"></i>

        Add Transaction

    </a>

</div>




<div class="card shadow border-0 p-4">


    <h3 class="mb-4">

        Recent Transactions

    </h3>



    <div class="table-responsive">


        <table class="table table-hover">


            <thead class="table-primary">


                <tr>

                    <th>Date</th>

                    <th>Category</th>

                    <th>Amount</th>

                    <th>Actions</th>

                </tr>


            </thead>



            <tbody id="transactionTable">
            </tbody>


        </table>


    </div>


</div>





@section Scripts {


    <script>


        const token = localStorage.getItem("token");


        loadTransactions();




        async function loadTransactions() {


            const response = await fetch("/api/Transactions",
                {

                    headers:
                    {

                        "Authorization": "Bearer " + token

                    }


                });



            if (!response.ok) {

                document.getElementById("transactionTable").innerHTML = "";

                return;

            }





            const transactions = await response.json();



            let rows = "";




            transactions.forEach(transaction => {


                rows += `


                    <tr>


                        <td>

                            ${transaction.date.substring(0, 10)}

                        </td>



                        <td>

                            ${transaction.categoryName ?? "No Category"}

                        </td>



                        <td class="fw-bold text-danger">

                            $${transaction.amount}

                        </td>



                        <td>



                            <a href="/TransactionPage/Details/${transaction.transactionID}"
                               class="btn btn-info btn-sm me-1">


                                <i class="bi bi-eye"></i>


                            </a>





                            <a href="/TransactionPage/Edit/${transaction.transactionID}"
                               class="btn btn-warning btn-sm me-1">


                                <i class="bi bi-pencil"></i>


                            </a>





                            <button class="btn btn-danger btn-sm"
                                    onclick="deleteTransaction(${transaction.transactionID})">


                                <i class="bi bi-trash"></i>


                            </button>



                        </td>


                    </tr>


                    `;


            });





            document.getElementById("transactionTable").innerHTML = rows;


        }








        async function deleteTransaction(id) {


            const response = await fetch("/api/Transactions/" + id,
                {

                    method: "DELETE",


                    headers:
                    {

                        "Authorization": "Bearer " + token

                    }


                });





            if (response.ok) {

                loadTransactions();

            }


        }




    </script>



    <script src="~/js/authGuard.js"></script>


}