@{
    ViewData["Title"] = "Transactions";
}

<div class="transaction-page">

    <div class="category-header">
        <div>
            <h1 class="category-title">
                <i class="bi bi-receipt"></i> Transactions
            </h1>

            <p class="category-description">
                View and manage every transaction moving through your accounts.
            </p>
        </div>
    </div>


    <!-- HERO -->

    <section class="category-hero">

        <div class="category-hero-content">

            <span class="category-hero-label">
                <i class="bi bi-lightbulb-fill"></i>
                Stay on top of every dollar
            </span>

            <h2>Every Income and Expense, In One Place</h2>

            <p>
                Log transactions as they happen so your balance is always
                accurate and nothing slips through unnoticed.
            </p>

            <button class="category-hero-btn" onclick="showCreatePanel()">
                <i class="bi bi-plus-circle"></i> Create a Transaction
            </button>

        </div>

        <div class="transaction-hero-visual"></div>

    </section>


    <!-- WHY TRACKING MATTERS -->

    <section class="category-benefits">

        <div class="category-section-heading">

            <span>WHY TRACKING MATTERS</span>

            <h2>Turn Activity Into a Clear Money Trail</h2>

            <p>
                Every logged transaction adds a little more clarity to your
                financial picture.
            </p>

        </div>


        <div class="category-benefit-grid">

            <article class="category-benefit-card">

                <img src="~/images/transactions/transaction-card-image-one.webp"
                     class="category-benefit-image"
                     alt="Understanding transactions">
                     @*Made changes here*@
                <h3>Log It Fast</h3>

                <p>
                    Add income or expenses in seconds, right when they happen,
                    so your records stay current.
                </p>

            </article>


            <article class="category-benefit-card">

                <img src="~/images/transactions/transaction-card-image-two.webp"
                     class="category-benefit-image"
                     alt="Understanding transactions">

                <h3>Full History</h3>

                <p>
                    Every transaction is kept on record, so you can look back
                    and see exactly what happened and when.
                </p>

            </article>


            <article class="category-benefit-card">

                <img src="~/images/transactions/transaction-card-image-three.webp"
                     class="category-benefit-image"
                     alt="Understanding transactions">

                <h3>Spot Trends</h3>

                <p>
                    Consistent logging makes it easy to notice patterns in
                    your spending and income over time.
                </p>

            </article>

        </div>

    </section>


    <!-- PROBLEM / SOLUTION -->

    <section class="category-problem">

        <div class="category-problem-icon">
            <i class="bi bi-question-circle-fill"></i>
        </div>

        <div class="category-problem-content">

            <span>THE PROBLEM WE SOLVE</span>

            <h2>Forgotten Transactions Add Up</h2>

            <p>
                A missed expense here, an unlogged payment there — small gaps
                in your records can throw off your whole financial picture.
            </p>

        </div>


        <div class="category-solution">

            <div class="category-solution-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <div>

                <strong>Our Solution</strong>

                <p>
                    A fast, simple way to record every transaction, so your
                    balance always reflects reality.
                </p>

            </div>

        </div>

    </section>


    <!-- TRANSACTION CONTENT -->

    <div class="category-content">

        <main class="category-main">

            <div id="transactionGrid" class="category-grid"></div>


            <div id="transactionEmpty"
                 class="category-empty"
                 style="display:none;">

                <div class="category-empty-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <h3>No transactions yet</h3>

                <p>
                    Add your first transaction to start tracking your money.
                </p>

                <button class="category-add-btn"
                        onclick="showCreatePanel()">

                    <i class="bi bi-plus-lg"></i>
                    Add Transaction

                </button>

            </div>


            <div id="transactionError"
                 class="category-error"
                 style="display:none;">

                Unable to load transactions.

            </div>

        </main>


        <aside id="transactionPanel"
               class="category-panel">

            <div class="category-panel-header">

                <div>

                    <h2 id="panelTitle">Transaction</h2>

                    <p>Manage this transaction</p>

                </div>

                <button class="category-panel-close"
                        onclick="closePanel()">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <div id="panelContent"
                 class="category-panel-content">
            </div>

        </aside>

    </div>

</div>


@section Scripts {

    <script>

        const token = localStorage.getItem("token");
        const headers = { Authorization: "Bearer " + token };

        const grid = document.getElementById("transactionGrid");
        const empty = document.getElementById("transactionEmpty");
        const errorBox = document.getElementById("transactionError");
        const panel = document.getElementById("transactionPanel");
        const panelTitle = document.getElementById("panelTitle");
        const panelContent = document.getElementById("panelContent");


        function escapeHtml(value) {

            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");

        }


        function openPanel(title, content) {

            panelTitle.innerHTML =
                `<i class="bi bi-receipt"></i> ${title}`;

            panelContent.innerHTML = content;

            panel.classList.add("open");

            setTimeout(() => {

                panel.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

            }, 100);

        }


        function closePanel() {

            panel.classList.remove("open");

        }


        async function loadTransactions() {

            try {

                const response =
                    await fetch("/api/Transactions", { headers });

                if (!response.ok)
                    throw new Error();


                const transactions = await response.json();


                if (!transactions.length) {

                    grid.innerHTML = "";

                    empty.style.display = "block";

                    return;

                }


                empty.style.display = "none";


                grid.innerHTML =
                    transactions.map(t => {

                        const income =
                            t.type === "Income";

                        const typeClass =
                            income ? "income" : "expense";

                        const amount =
                            `${income ? "+" : "-"}$${Number(t.amount || 0).toFixed(2)}`;

                        const date =
                            t.date
                                ? new Date(t.date).toLocaleDateString()
                                : "Unknown";


                        return `

                            <article class="category-card">

                                <div class="category-card-body">

                                    <div class="category-card-icon ${typeClass}">
                                        <i class="bi bi-receipt"></i>
                                    </div>

                                    <h2>
                                        ${escapeHtml(t.categoryName || "No Category")}
                                    </h2>

                                    <div class="category-card-type">

                                        <span>Type</span>

                                        <strong class="${typeClass}">
                                            ${income ? "Income" : "Expense"}
                                        </strong>

                                    </div>


                                    <div class="category-card-type">

                                        <span>Amount</span>

                                        <strong class="${typeClass}">
                                            ${amount}
                                        </strong>

                                    </div>


                                    <div class="category-card-type">

                                        <span>Date</span>

                                        <strong>
                                            ${date}
                                        </strong>

                                    </div>

                                </div>


                                <div class="category-card-actions">

                                    <button
                                        class="category-card-btn category-view-btn"
                                        onclick="showDetails(${t.transactionsID})">

                                        <i class="bi bi-eye"></i>
                                        View Details

                                    </button>


                                    <button
                                        class="category-card-btn category-edit-btn"
                                        onclick="showEditPanel(${t.transactionsID})">

                                        <i class="bi bi-pencil"></i>
                                        Edit

                                    </button>


                                    <button
                                        class="category-card-btn category-delete-btn"
                                        onclick="showDeletePanel(${t.transactionsID})">

                                        <i class="bi bi-trash"></i>
                                        Delete

                                    </button>

                                </div>

                            </article>

                        `;

                    }).join("");

            }
            catch {

                errorBox.style.display = "block";

            }

        }


        async function loadCategories(selected = "") {

            const response =
                await fetch("/api/Category", { headers });

            if (!response.ok) return "";

            const categories = await response.json();

            return `
                <option value="">Select a category</option>
                ${categories.map(c => `
                    <option value="${c.categoryID}"
                        ${Number(c.categoryID) === Number(selected) ? "selected" : ""}>
                        ${escapeHtml(c.name)}
                    </option>
                `).join("")}`;

        }


        function showCreatePanel(type = "Expense") {

            openPanel("Add Transaction", `

                <form id="createTransactionForm">

                    <div class="category-form-group">
                        <label>Amount</label>
                        <input id="createAmount" type="number" min="0.01" step="0.01"
                               class="category-input" required>
                    </div>

                    <div class="category-form-group">
                        <label>Category</label>
                        <select id="createCategory" class="category-input" required>
                            <option>Loading...</option>
                        </select>
                    </div>

                    <div class="category-form-group">
                        <label>Type</label>
                        <select id="createType" class="category-input">
                            <option value="Expense" ${type === "Expense" ? "selected" : ""}>Expense</option>
                            <option value="Income" ${type === "Income" ? "selected" : ""}>Income</option>
                        </select>
                    </div>

                    <div class="category-form-group">
                        <label>Date</label>
                        <input id="createDate" type="date" class="category-input">
                    </div>

                    <div class="category-form-group">
                        <label>Notes <span class="category-optional">Optional</span></label>
                        <textarea id="createNotes" class="category-input category-textarea"
                                  placeholder="Add a note if you want..."></textarea>
                    </div>

                    <div id="createError" class="category-panel-error" style="display:none;"></div>

                    <button class="category-panel-primary">
                        <i class="bi bi-check-circle"></i> Save Transaction
                    </button>

                </form>

            `);

            loadCategories().then(options => {
                document.getElementById("createCategory").innerHTML = options;
            });

            document
                .getElementById("createTransactionForm")
                .addEventListener("submit", createTransaction);

        }


        async function createTransaction(event) {

            event.preventDefault();

            const error = document.getElementById("createError");

            const data = {
                amount: Number(document.getElementById("createAmount").value),
                categoryID: Number(document.getElementById("createCategory").value),
                type: document.getElementById("createType").value,
                date: document.getElementById("createDate").value,
                notes: document.getElementById("createNotes").value.trim() || null
            };

            if (data.amount <= 0 || !data.categoryID) {

                error.textContent = "Enter a valid amount and category.";
                error.style.display = "block";
                return;

            }

            try {

                const response =
                    await fetch("/api/Transactions", {

                        method: "POST",

                        headers: {
                            ...headers,
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify(data)

                    });

                if (!response.ok)
                    throw new Error();

                closePanel();
                loadTransactions();

            }
            catch {

                error.textContent = "Unable to create transaction.";
                error.style.display = "block";

            }

        }


        async function showDetails(id) {

            try {

                const response =
                    await fetch(`/api/Transactions/${id}`, { headers });

                if (!response.ok)
                    throw new Error();

                const t = await response.json();
                const income = t.type === "Income";
                const typeClass = income ? "income" : "expense";

                openPanel("Transaction Details", `

                    <div class="category-detail">

                        <div class="category-detail-icon ${typeClass}">
                            <i class="bi bi-receipt"></i>
                        </div>

                        <h3>
                            ${escapeHtml(t.categoryName || "No Category")}
                        </h3>

                        <div class="category-detail-block">
                            <span>Type</span>
                            <strong class="${typeClass}">
                                ${escapeHtml(t.type || "Expense")}
                            </strong>
                        </div>

                        <div class="category-detail-block">
                            <span>Amount</span>
                            <strong class="${typeClass}">
                                ${income ? "+" : "-"}$${Number(t.amount || 0).toFixed(2)}
                            </strong>
                        </div>

                        <div class="category-detail-block">
                            <span>Date</span>
                            <strong>
                                ${t.date ? new Date(t.date).toLocaleDateString() : "N/A"}
                            </strong>
                        </div>

                        <div class="category-detail-block">
                            <span>Notes</span>
                            <strong>
                                ${escapeHtml(t.notes?.trim() || "N/A")}
                            </strong>
                        </div>

                    </div>

                `);

            }
            catch {

                showPanelError("Transaction Details", "Unable to load transaction.");

            }

        }


        async function showEditPanel(id) {

            try {

                const response =
                    await fetch(`/api/Transactions/${id}`, { headers });

                if (!response.ok)
                    throw new Error();

                const t = await response.json();
                const categories = await loadCategories(t.categoryID);

                openPanel("Edit Transaction", `

                    <form id="editTransactionForm">

                        <div class="category-form-group">
                            <label>Amount</label>
                            <input id="editAmount" type="number" min="0.01" step="0.01"
                                   class="category-input" value="${t.amount}" required>
                        </div>

                        <div class="category-form-group">
                            <label>Category</label>
                            <select id="editCategory" class="category-input" required>
                                ${categories}
                            </select>
                        </div>

                        <div class="category-form-group">
                            <label>Type</label>
                            <select id="editType" class="category-input">
                                <option value="Expense" ${t.type === "Expense" ? "selected" : ""}>Expense</option>
                                <option value="Income" ${t.type === "Income" ? "selected" : ""}>Income</option>
                            </select>
                        </div>

                        <div class="category-form-group">
                            <label>Date</label>
                            <input id="editDate" type="date" class="category-input"
                                   value="${t.date ? t.date.substring(0, 10) : ""}">
                        </div>

                        <div class="category-form-group">
                            <label>Notes <span class="category-optional">Optional</span></label>
                            <textarea id="editNotes" class="category-input category-textarea">${escapeHtml(t.notes || "")}</textarea>
                        </div>

                        <div id="editError" class="category-panel-error" style="display:none;"></div>

                        <button class="category-panel-primary">
                            <i class="bi bi-save"></i> Update Transaction
                        </button>

                    </form>

                `);

                document
                    .getElementById("editTransactionForm")
                    .addEventListener("submit", e => updateTransaction(e, id));

            }
            catch {

                showPanelError("Edit Transaction", "Unable to load transaction.");

            }

        }


        async function updateTransaction(event, id) {

            event.preventDefault();

            const error = document.getElementById("editError");

            const data = {
                amount: Number(document.getElementById("editAmount").value),
                categoryID: Number(document.getElementById("editCategory").value),
                type: document.getElementById("editType").value,
                date: document.getElementById("editDate").value,
                notes: document.getElementById("editNotes").value.trim() || null
            };

            try {

                const response =
                    await fetch(`/api/Transactions/${id}`, {

                        method: "PUT",

                        headers: {
                            ...headers,
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify(data)

                    });

                if (!response.ok)
                    throw new Error();

                closePanel();
                loadTransactions();

            }
            catch {

                error.textContent = "Unable to update transaction.";
                error.style.display = "block";

            }

        }


        function showDeletePanel(id) {

            openPanel("Delete Transaction", `

                <div class="category-delete-box">

                    <div class="category-delete-icon">
                        <i class="bi bi-trash-fill"></i>
                    </div>

                    <h3>Delete Transaction?</h3>

                    <p>
                        Are you sure you want to delete this transaction?
                        This action cannot be undone.
                    </p>

                    <div class="category-delete-actions">

                        <button
                            class="category-panel-cancel"
                            onclick="closePanel()">

                            Cancel

                        </button>

                        <button
                            class="category-panel-danger"
                            onclick="deleteTransaction(${id})">

                            <i class="bi bi-trash"></i>
                            Delete

                        </button>

                    </div>

                </div>

            `);

        }


        async function deleteTransaction(id) {

            try {

                const response =
                    await fetch(`/api/Transactions/${id}`, {
                        method: "DELETE",
                        headers
                    });

                if (!response.ok)
                    throw new Error();

                closePanel();
                loadTransactions();

            }
            catch {

                showPanelError("Delete Transaction", "Unable to delete transaction.");

            }

        }


        function showPanelError(title, message) {

            openPanel(
                title,
                `<div class="category-panel-error">${message}</div>`
            );

        }


        loadTransactions();

        const requestedType = new URLSearchParams(location.search).get("type");

        if (requestedType === "Income" || requestedType === "Expense") {
            showCreatePanel(requestedType);
        }

    </script>

    <script src="~/js/authGuard.js"></script>
}