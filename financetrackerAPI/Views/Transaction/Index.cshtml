@* @{
    ViewData["Title"] = "Transactions";
}

<div class="transaction-page">

    <div class="transaction-header">

        <div>

            <h1 class="transaction-title">
                <i class="bi bi-receipt me-1"></i> Transactions
            </h1>

            <p class="transaction-description">
                Track your income and expenses to understand your financial activity.
            </p>

        </div>

    </div>


    <!-- HERO -->

    <section class="transaction-hero">

        <div class="transaction-hero-content">

            <span class="transaction-hero-label">
                <i class="bi bi-lightbulb-fill"></i>
                Why track your transactions?
            </span>

            <h2>Understand Every Move Your Money Makes</h2>

            <p>
                Transactions give you a clear record of your income and expenses.
                Tracking them helps you understand your spending, monitor your
                financial activity, and make better decisions.
            </p>

            <button class="transaction-hero-btn"
                    onclick="showCreatePanel()">

                <i class="bi bi-plus-circle"></i>
                Add a Transaction

            </button>

        </div>

        <div class="transaction-hero-visual"></div>

    </section>


    <!-- WHY TRANSACTIONS MATTER -->

    <section class="transaction-insights">

        <div class="transaction-section-heading">

            <span>WHY TRANSACTIONS MATTER</span>

            <h2>Turn Your Financial Activity Into Information</h2>

            <p>
                Keeping track of every transaction makes it easier to understand
                your income, expenses, and overall financial habits.
            </p>

        </div>


        <div class="transaction-insight-grid">

            <article class="transaction-insight-card">

                <img src="~/images/transactions/transaction.avif"
                     class="transaction-insight-image"
                     alt="Track spending">

                <h3>Track Spending</h3>

                <p>
                    Record your expenses so you can see where your money is
                    going and identify your biggest spending areas.
                </p>

            </article>


            <article class="transaction-insight-card">

                <img src="~/images/transactions/pay.avif"
                     class="transaction-insight-image"
                     alt="Track income">

                <h3>Monitor Income</h3>

                <p>
                    Keep a record of money coming in so you can understand
                    your available income and financial activity.
                </p>

            </article>


            <article class="transaction-insight-card">

                <img src="~/images/transactions/success.avif"
                     class="transaction-insight-image"
                     alt="Manage finances">

                <h3>Manage Finances</h3>

                <p>
                    Reviewing your transactions helps you make informed
                    decisions and maintain better control of your money.
                </p>

            </article>

        </div>

    </section>


    <!-- PROBLEM / SOLUTION -->

    <section class="transaction-problem">

        <div class="transaction-problem-icon">
            <i class="bi bi-question-circle-fill"></i>
        </div>


        <div class="transaction-problem-content">

            <span>THE PROBLEM WE SOLVE</span>

            <h2>Where Did Your Money Go?</h2>

            <p>
                Without keeping track of transactions, it can be difficult to
                understand spending patterns, remember where money was spent,
                or see how income and expenses affect your finances.
            </p>

        </div>


        <div class="transaction-solution">

            <div class="transaction-solution-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <div>

                <strong>Our Solution</strong>

                <p>
                    Transactions provide one organized place to record income
                    and expenses, making your financial activity easier to
                    review and understand.
                </p>

            </div>

        </div>

    </section>


    <!-- TRANSACTION CONTENT -->

    <div class="transaction-content">

        <main class="transaction-main">

            <div id="transactionList"
                 class="transaction-grid">
            </div>


            <div id="emptyTransaction"
                 class="transaction-empty"
                 style="display:none;">

                <div class="transaction-empty-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <h3>No transactions yet</h3>

                <p>
                    Add your first transaction to start tracking your finances.
                </p>

                <button class="transaction-add-btn"
                        onclick="showCreatePanel()">

                    <i class="bi bi-plus-lg"></i>
                    Add Transaction

                </button>

            </div>


            <div id="transactionError"
                 class="transaction-error"
                 style="display:none;">

                Unable to load transactions.

            </div>

        </main>


        <aside id="transactionPanel"
               class="transaction-panel">

            <div class="transaction-panel-header">

                <div>

                    <h2 id="panelTitle">
                        Transaction
                    </h2>

                    <p>
                        Manage this transaction
                    </p>

                </div>

                <button class="transaction-panel-close"
                        onclick="closePanel()">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <div id="panelContent"
                 class="transaction-panel-content">
            </div>

        </aside>

    </div>

</div>


@section Scripts {

    <script>

        const token = localStorage.getItem("token");

        const headers = {
            Authorization: "Bearer " + token
        };


        const transactionList =
            document.getElementById("transactionList");

        const emptyTransaction =
            document.getElementById("emptyTransaction");

        const transactionError =
            document.getElementById("transactionError");

        const transactionPanel =
            document.getElementById("transactionPanel");

        const panelTitle =
            document.getElementById("panelTitle");

        const panelContent =
            document.getElementById("panelContent");


        function escapeHtml(value) {

            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");

        }


        function openPanel(title, content) {

            panelTitle.innerHTML =
                `<i class="bi bi-receipt"></i> ${title}`;

            panelContent.innerHTML = content;

            transactionPanel.classList.add("open");

            setTimeout(() => {

                transactionPanel.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

            }, 100);

        }


        function closePanel() {

            transactionPanel.classList.remove("open");

        }


        async function loadTransactions() {

            try {

                const response =
                    await fetch("/api/Transactions", {
                        headers
                    });


                if (!response.ok)
                    throw new Error();


                const transactions =
                    await response.json();


                if (!transactions.length) {

                    transactionList.innerHTML = "";

                    emptyTransaction.style.display = "block";

                    return;

                }


                emptyTransaction.style.display = "none";

                transactionError.style.display = "none";


                transactionList.innerHTML =
                    transactions.map(transaction => {

                        const type =
                            transaction.type || "Expense";

                        const typeClass =
                            type.toLowerCase() === "income"
                                ? "income"
                                : "expense";


                        const amount =
                            Number(transaction.amount) || 0;


                        const date =
                            transaction.date
                                ? new Date(transaction.date)
                                    .toLocaleDateString()
                                : "No date";


                        const category =
                            transaction.categoryName ||
                            transaction.category?.name ||
                            "Uncategorized";


                        const notes =
                            transaction.notes ||
                            "No notes";


                        return `

                                    <article class="transaction-card">

                                        <div class="transaction-card-body">

                                            <div class="transaction-card-icon ${typeClass}">
                                                <i class="bi bi-receipt"></i>
                                            </div>


                                            <h2>
                                                ${escapeHtml(category)}
                                            </h2>


                                            <div class="transaction-summary">

                                                <span class="transaction-type ${typeClass}">
                                                    ${escapeHtml(type)}
                                                </span>

                                                <strong class="transaction-amount ${typeClass}">
                                                    ${typeClass === "income" ? "+" : "-"}$${amount.toFixed(2)}
                                                </strong>

                                            </div>


                                            <div class="transaction-date">

                                                <i class="bi bi-calendar3"></i>

                                                <span>
                                                    ${escapeHtml(date)}
                                                </span>

                                            </div>


                                            <div class="transaction-note">

                                                <i class="bi bi-card-text"></i>

                                                <span>
                                                    ${escapeHtml(notes)}
                                                </span>

                                            </div>

                                        </div>


                                        <div class="transaction-card-actions">

                                            <button
                                                class="transaction-card-btn transaction-view-btn"
                                                onclick="showDetails(${transaction.transactionID})">

                                                <i class="bi bi-eye"></i>
                                                View Details

                                            </button>


                                            <button
                                                class="transaction-card-btn transaction-edit-btn"
                                                onclick="showEditPanel(${transaction.transactionID})">

                                                <i class="bi bi-pencil"></i>
                                                Edit

                                            </button>


                                            <button
                                                class="transaction-card-btn transaction-delete-btn"
                                                onclick="showDeletePanel(${transaction.transactionID})">

                                                <i class="bi bi-trash"></i>
                                                Delete

                                            </button>

                                        </div>

                                    </article>

                                `;

                    }).join("");

            }
            catch {

                transactionError.style.display = "block";

            }

        }


        async function loadCategories() {

            try {

                const response =
                    await fetch("/api/Category", {
                        headers
                    });


                if (!response.ok)
                    throw new Error();


                return await response.json();

            }
            catch {

                return [];

            }

        }


        async function showCreatePanel() {

            const categories =
                await loadCategories();


            const categoryOptions =
                categories.map(category => `

                            <option value="${category.categoryID}">
                                ${escapeHtml(category.name)}
                            </option>

                        `).join("");


            openPanel("Add Transaction", `

                        <form id="createTransactionForm">


                            <div class="transaction-form-group">

                                <label>
                                    Amount
                                </label>

                                <input
                                    id="createAmount"
                                    class="transaction-input"
                                    type="number"
                                    step="0.01"
                                    min="0"
                                    placeholder="e.g. 45.00"
                                    required>

                            </div>


                            <div class="transaction-form-group">

                                <label>
                                    Type
                                </label>

                                <select
                                    id="createType"
                                    class="transaction-input">

                                    <option value="Expense">
                                        Expense
                                    </option>

                                    <option value="Income">
                                        Income
                                    </option>

                                </select>

                            </div>


                            <div class="transaction-form-group">

                                <label>
                                    Category
                                </label>

                                <select
                                    id="createCategoryID"
                                    class="transaction-input"
                                    required>

                                    <option value="">
                                        Select category
                                    </option>

                                    ${categoryOptions}

                                </select>

                            </div>


                            <div class="transaction-form-group">

                                <label>
                                    Date
                                </label>

                                <input
                                    id="createDate"
                                    class="transaction-input"
                                    type="date"
                                    required>

                            </div>


                            <div class="transaction-form-group">

                                <label>
                                    Notes
                                    <span class="transaction-optional">
                                        Optional
                                    </span>
                                </label>

                                <textarea
                                    id="createNotes"
                                    class="transaction-input transaction-textarea"
                                    placeholder="Add notes about this transaction"></textarea>

                            </div>


                            <div id="createError"
                                 class="transaction-panel-error"
                                 style="display:none;">
                            </div>


                            <button class="transaction-panel-primary">

                                <i class="bi bi-check-circle"></i>
                                Save Transaction

                            </button>

                        </form>

                    `);


            document
                .getElementById("createTransactionForm")
                .addEventListener(
                    "submit",
                    createTransaction
                );

        }


        async function createTransaction(event) {

            event.preventDefault();


            const amount =
                Number(
                    document
                        .getElementById("createAmount")
                        .value
                );


            const type =
                document
                    .getElementById("createType")
                    .value;


            const categoryID =
                Number(
                    document
                        .getElementById("createCategoryID")
                        .value
                );


            const date =
                document
                    .getElementById("createDate")
                    .value;


            const notes =
                document
                    .getElementById("createNotes")
                    .value.trim();


            const error =
                document
                    .getElementById("createError");


            if (!amount || amount <= 0) {

                error.textContent =
                    "Enter a valid transaction amount.";

                error.style.display = "block";

                return;

            }


            if (!categoryID) {

                error.textContent =
                    "Select a category.";

                error.style.display = "block";

                return;

            }


            if (!date) {

                error.textContent =
                    "Select a transaction date.";

                error.style.display = "block";

                return;

            }


            try {

                const response =
                    await fetch("/api/Transactions", {

                        method: "POST",

                        headers: {
                            ...headers,
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify({
                            amount,
                            type,
                            categoryID,
                            date,
                            notes
                        })

                    });


                if (!response.ok)
                    throw new Error();


                closePanel();

                loadTransactions();

            }
            catch {

                error.textContent =
                    "Unable to create transaction.";

                error.style.display = "block";

            }

        }


        async function showDetails(id) {

            try {

                const response =
                    await fetch(
                        `/api/Transactions/${id}`,
                        { headers }
                    );


                if (!response.ok)
                    throw new Error();


                const transaction =
                    await response.json();


                const type =
                    transaction.type || "Expense";


                const typeClass =
                    type.toLowerCase() === "income"
                        ? "income"
                        : "expense";


                const amount =
                    Number(transaction.amount) || 0;


                const date =
                    transaction.date
                        ? new Date(transaction.date)
                            .toLocaleDateString()
                        : "No date";


                const category =
                    transaction.categoryName ||
                    transaction.category?.name ||
                    "Uncategorized";


                const notes =
                    transaction.notes ||
                    "No notes";


                openPanel("Transaction Details", `

                            <div class="transaction-detail">

                                <div class="transaction-detail-icon ${typeClass}">
                                    <i class="bi bi-receipt"></i>
                                </div>


                                <h3>
                                    Transaction Details
                                </h3>


                                <div class="transaction-detail-block">

                                    <span>
                                        Category
                                    </span>

                                    <strong>
                                        ${escapeHtml(category)}
                                    </strong>

                                </div>


                                <div class="transaction-detail-block">

                                    <span>
                                        Type
                                    </span>

                                    <strong class="${typeClass}">
                                        ${escapeHtml(type)}
                                    </strong>

                                </div>


                                <div class="transaction-detail-block">

                                    <span>
                                        Amount
                                    </span>

                                    <strong class="${typeClass}">
                                        ${typeClass === "income" ? "+" : "-"}$${amount.toFixed(2)}
                                    </strong>

                                </div>


                                <div class="transaction-detail-block">

                                    <span>
                                        Date
                                    </span>

                                    <strong>
                                        ${escapeHtml(date)}
                                    </strong>

                                </div>


                                <div class="transaction-detail-block">

                                    <span>
                                        Notes
                                    </span>

                                    <strong class="transaction-notes-value">
                                        ${escapeHtml(notes)}
                                    </strong>

                                </div>

                            </div>

                        `);

            }
            catch {

                showPanelError(
                    "Transaction Details",
                    "Unable to load transaction details."
                );

            }

        }


        async function showEditPanel(id) {

            try {

                const response =
                    await fetch(
                        `/api/Transactions/${id}`,
                        { headers }
                    );


                if (!response.ok)
                    throw new Error();


                const transaction =
                    await response.json();


                const categories =
                    await loadCategories();


                const categoryOptions =
                    categories.map(category => `

                                <option
                                    value="${category.categoryID}"
                                    ${Number(category.categoryID) === Number(transaction.categoryID)
                            ? "selected"
                            : ""}>

                                    ${escapeHtml(category.name)}

                                </option>

                            `).join("");


                const date =
                    transaction.date
                        ? transaction.date.substring(0, 10)
                        : "";


                openPanel("Edit Transaction", `

                            <form id="editTransactionForm">


                                <div class="transaction-form-group">

                                    <label>
                                        Amount
                                    </label>

                                    <input
                                        id="editAmount"
                                        class="transaction-input"
                                        type="number"
                                        step="0.01"
                                        min="0"
                                        value="${Number(transaction.amount || 0)}"
                                        required>

                                </div>


                                <div class="transaction-form-group">

                                    <label>
                                        Type
                                    </label>

                                    <select
                                        id="editType"
                                        class="transaction-input">

                                        <option
                                            value="Expense"
                                            ${transaction.type === "Expense"
                        ? "selected"
                        : ""}>

                                            Expense

                                        </option>

                                        <option
                                            value="Income"
                                            ${transaction.type === "Income"
                        ? "selected"
                        : ""}>

                                            Income

                                        </option>

                                    </select>

                                </div>


                                <div class="transaction-form-group">

                                    <label>
                                        Category
                                    </label>

                                    <select
                                        id="editCategoryID"
                                        class="transaction-input"
                                        required>

                                        ${categoryOptions}

                                    </select>

                                </div>


                                <div class="transaction-form-group">

                                    <label>
                                        Date
                                    </label>

                                    <input
                                        id="editDate"
                                        class="transaction-input"
                                        type="date"
                                        value="${date}"
                                        required>

                                </div>


                                <div class="transaction-form-group">

                                    <label>
                                        Notes
                                        <span class="transaction-optional">
                                            Optional
                                        </span>
                                    </label>

                                    <textarea
                                        id="editNotes"
                                        class="transaction-input transaction-textarea"
                                        placeholder="Add notes">${escapeHtml(transaction.notes || "")}</textarea>

                                </div>


                                <div id="editError"
                                     class="transaction-panel-error"
                                     style="display:none;">
                                </div>


                                <button class="transaction-panel-primary">

                                    <i class="bi bi-save"></i>
                                    Update Transaction

                                </button>

                            </form>

                        `);


                document
                    .getElementById("editTransactionForm")
                    .addEventListener(
                        "submit",
                        event => updateTransaction(event, id)
                    );

            }
            catch {

                showPanelError(
                    "Edit Transaction",
                    "Unable to load transaction."
                );

            }

        }


        async function updateTransaction(event, id) {

            event.preventDefault();


            const amount =
                Number(
                    document
                        .getElementById("editAmount")
                        .value
                );


            const type =
                document
                    .getElementById("editType")
                    .value;


            const categoryID =
                Number(
                    document
                        .getElementById("editCategoryID")
                        .value
                );


            const date =
                document
                    .getElementById("editDate")
                    .value;


            const notes =
                document
                    .getElementById("editNotes")
                    .value.trim();


            const error =
                document
                    .getElementById("editError");


            if (!amount || amount <= 0) {

                error.textContent =
                    "Enter a valid transaction amount.";

                error.style.display = "block";

                return;

            }


            try {

                const response =
                    await fetch(
                        `/api/Transactions/${id}`,
                        {

                            method: "PUT",

                            headers: {
                                ...headers,
                                "Content-Type": "application/json"
                            },

                            body: JSON.stringify({
                                amount,
                                type,
                                categoryID,
                                date,
                                notes
                            })

                        }
                    );


                if (!response.ok)
                    throw new Error();


                closePanel();

                loadTransactions();

            }
            catch {

                error.textContent =
                    "Unable to update transaction.";

                error.style.display = "block";

            }

        }


        function showDeletePanel(id) {

            openPanel("Delete Transaction", `

                        <div class="transaction-delete-box">

                            <div class="transaction-delete-icon">

                                <i class="bi bi-trash-fill"></i>

                            </div>


                            <h3>
                                Delete Transaction?
                            </h3>


                            <p>
                                Are you sure you want to delete this transaction?
                                This action cannot be undone.
                            </p>


                            <div class="transaction-delete-actions">

                                <button
                                    class="transaction-panel-cancel"
                                    onclick="closePanel()">

                                    Cancel

                                </button>


                                <button
                                    class="transaction-panel-danger"
                                    onclick="deleteTransaction(${id})">

                                    <i class="bi bi-trash"></i>
                                    Delete

                                </button>

                            </div>

                        </div>

                    `);

        }


        async function deleteTransaction(id) {

            try {

                const response =
                    await fetch(
                        `/api/Transactions/${id}`,
                        {

                            method: "DELETE",
                            headers

                        }
                    );


                if (!response.ok)
                    throw new Error();


                closePanel();

                loadTransactions();

            }
            catch {

                showPanelError(
                    "Delete Transaction",
                    "Unable to delete transaction."
                );

            }

        }


        function showPanelError(title, message) {

            openPanel(
                title,
                `<div class="transaction-panel-error">${escapeHtml(message)}</div>`
            );

        }


        loadTransactions();

    </script>

    <script src="~/js/authGuard.js"></script>
} *@








