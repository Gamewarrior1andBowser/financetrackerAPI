@{
    ViewData["Title"] = "Transactions";
}

<div class="transaction-page">

    <div class="transaction-header">
        <div>
            <h1 class="transaction-title">
                <i class="bi bi-receipt"></i>
                Transactions
            </h1>
            <p class="transaction-description">
                View and manage your transactions.
            </p>
        </div>

        <button type="button"
                class="transaction-add-btn"
                onclick="showCreatePanel()">
            <i class="bi bi-plus-lg"></i>
            Add Transaction
        </button>
    </div>

    <div class="transaction-content">

        <main class="transaction-main">
            <div id="transactionGrid" class="transaction-grid"></div>

            <div id="transactionEmpty"
                 class="transaction-empty"
                 style="display:none;">
                <div class="transaction-empty-icon">
                    <i class="bi bi-receipt"></i>
                </div>
                <h3>No transactions yet</h3>
                <p>Add your first transaction to start tracking your money.</p>

                <button type="button"
                        class="transaction-add-btn"
                        onclick="showCreatePanel()">
                    <i class="bi bi-plus-lg"></i>
                    Add Transaction
                </button>
            </div>

            <div id="transactionError"
                 class="transaction-error"
                 style="display:none;">
                Unable to load transactions.
            </div>
        </main>

        <aside id="transactionPanel" class="transaction-panel">

            <div class="transaction-panel-header">
                <div>
                    <h2 id="panelTitle">Transaction</h2>
                    <p>Manage this transaction</p>
                </div>

                <button type="button"
                        class="transaction-panel-close"
                        onclick="closePanel()">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div id="panelContent"
                 class="transaction-panel-content"></div>

        </aside>

    </div>
</div>

@section Scripts {
    <script>
        const token = localStorage.getItem("token");
        const grid = document.getElementById("transactionGrid");
        const empty = document.getElementById("transactionEmpty");
        const errorBox = document.getElementById("transactionError");
        const panel = document.getElementById("transactionPanel");
        const panelTitle = document.getElementById("panelTitle");
        const panelContent = document.getElementById("panelContent");

        function escapeHtml(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function openPanel(title, content) {
            panelTitle.innerHTML = `<i class="bi bi-receipt"></i> ${title}`;
            panelContent.innerHTML = content;
            panel.classList.add("open");
        }

        function closePanel() {
            panel.classList.remove("open");
        }

        async function loadTransactions() {
            try {
                const response = await fetch("/api/Transactions", {
                    headers: { Authorization: "Bearer " + token }
                });

                if (!response.ok) throw new Error();

                const transactions = await response.json();

                if (!transactions.length) {
                    grid.innerHTML = "";
                    empty.style.display = "block";
                    return;
                }

                empty.style.display = "none";

                grid.innerHTML = transactions.map(t => {
                    const type = t.type || "Expense";
                    const income = type.toLowerCase() === "income";
                    const category = t.categoryName || "No Category";
                    const note = t.notes?.trim() || "N/A";
                    const date = t.date
                        ? new Date(t.date).toLocaleDateString()
                        : "Unknown";

                    return `
                        <article class="transaction-card">

                            <div class="transaction-card-body">

                                <div class="transaction-card-icon">
                                    <i class="bi bi-receipt"></i>
                                </div>

                                <h2>${escapeHtml(category)}</h2>

                                <div class="transaction-amount">
                                    <span>${escapeHtml(type)}</span>
                                    <strong class="${income ? "income" : "expense"}">
                                        ${income ? "+" : "-"}$${Number(t.amount).toFixed(2)}
                                    </strong>
                                </div>

                                <div class="transaction-info">
                                    <span>
                                        <i class="bi bi-calendar3"></i>
                                        ${date}
                                    </span>
                                </div>

                                <div class="transaction-note">
                                    <span>Notes</span>
                                    <p>${escapeHtml(note)}</p>
                                </div>

                            </div>

                            <div class="transaction-card-actions">

                                <button class="transaction-card-btn transaction-view-btn"
                                        onclick="showDetails(${t.transactionsID})">
                                    <i class="bi bi-eye"></i>
                                    View Details
                                </button>

                                <button class="transaction-card-btn transaction-edit-btn"
                                        onclick="showEditPanel(${t.transactionsID})">
                                    <i class="bi bi-pencil"></i>
                                    Edit
                                </button>

                                <button class="transaction-card-btn transaction-delete-btn"
                                        onclick="showDeletePanel(${t.transactionsID})">
                                    <i class="bi bi-trash"></i>
                                    Delete
                                </button>

                            </div>
                        </article>
                    `;
                }).join("");

            } catch {
                errorBox.style.display = "block";
            }
        }

        async function loadCategories(selected = "") {
            const response = await fetch("/api/Category", {
                headers: { Authorization: "Bearer " + token }
            });

            if (!response.ok) return "";

            const categories = await response.json();

            return `
                <option value="">Select a category</option>
                ${categories.map(c => `
                    <option value="${c.categoryID}"
                        ${Number(c.categoryID) === Number(selected) ? "selected" : ""}>
                        ${escapeHtml(c.name)}
                    </option>
                `).join("")}
            `;
        }

        function showCreatePanel() {
            openPanel("Add Transaction", `
                <form id="createTransactionForm">

                    <div class="transaction-form-group">
                        <label>Amount</label>
                        <input id="createAmount"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="transaction-input"
                               required>
                    </div>

                    <div class="transaction-form-group">
                        <label>Category</label>
                        <select id="createCategory"
                                class="transaction-input"
                                required>
                            <option>Loading...</option>
                        </select>
                    </div>

                    <div class="transaction-form-group">
                        <label>Type</label>
                        <select id="createType" class="transaction-input">
                            <option value="Expense">Expense</option>
                            <option value="Income">Income</option>
                        </select>
                    </div>

                    <div class="transaction-form-group">
                        <label>Date</label>
                        <input id="createDate"
                               type="date"
                               class="transaction-input">
                    </div>

                    <div class="transaction-form-group">
                        <label>
                            Notes
                            <span class="transaction-optional">Optional</span>
                        </label>

                        <textarea id="createNotes"
                                  class="transaction-input transaction-textarea"
                                  placeholder="Add a note if you want..."></textarea>
                    </div>

                    <div id="createError"
                         class="transaction-panel-error"
                         style="display:none;"></div>

                    <button class="transaction-panel-primary">
                        <i class="bi bi-check-circle"></i>
                        Save Transaction
                    </button>

                </form>
            `);

            loadCategories().then(options => {
                document.getElementById("createCategory").innerHTML = options;
            });

            document.getElementById("createTransactionForm")
                .addEventListener("submit", createTransaction);
        }

        async function createTransaction(event) {
            event.preventDefault();

            const error = document.getElementById("createError");

            const amount = Number(document.getElementById("createAmount").value);
            const categoryID = Number(document.getElementById("createCategory").value);
            const type = document.getElementById("createType").value;
            const date = document.getElementById("createDate").value;
            const notes = document.getElementById("createNotes").value.trim();

            if (!amount || amount <= 0 || !categoryID) {
                error.textContent = "Enter a valid amount and category.";
                error.style.display = "block";
                return;
            }

            try {
                const response = await fetch("/api/Transactions", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        Authorization: "Bearer " + token
                    },
                    body: JSON.stringify({
                        amount,
                        categoryID,
                        type,
                        date,
                        notes: notes || null
                    })
                });

                if (!response.ok) throw new Error();

                closePanel();
                loadTransactions();

            } catch {
                error.textContent = "Unable to create transaction.";
                error.style.display = "block";
            }
        }

        async function showDetails(id) {
            try {
                const response = await fetch(`/api/Transactions/${id}`, {
                    headers: { Authorization: "Bearer " + token }
                });

                if (!response.ok) throw new Error();

                const t = await response.json();

                openPanel("Transaction Details", `
                    <div class="transaction-detail">

                        <div class="transaction-detail-icon">
                            <i class="bi bi-receipt"></i>
                        </div>

                        <div class="transaction-detail-block">
                            <span>Amount</span>
                            <strong>$${Number(t.amount).toFixed(2)}</strong>
                        </div>

                        <div class="transaction-detail-block">
                            <span>Category</span>
                            <strong>${escapeHtml(t.categoryName || "No Category")}</strong>
                        </div>

                        <div class="transaction-detail-block">
                            <span>Type</span>
                            <strong>${escapeHtml(t.type || "N/A")}</strong>
                        </div>

                        <div class="transaction-detail-block">
                            <span>Date</span>
                            <strong>
                                ${t.date ? new Date(t.date).toLocaleDateString() : "N/A"}
                            </strong>
                        </div>

                        <div class="transaction-detail-block">
                            <span>Notes</span>
                            <strong class="transaction-notes-value">
                                ${escapeHtml(t.notes?.trim() || "N/A")}
                            </strong>
                        </div>

                    </div>
                `);

            } catch {
                openPanel("Transaction Details", `
                    <div class="transaction-panel-error">
                        Unable to load transaction.
                    </div>
                `);
            }
        }

        async function showEditPanel(id) {
            try {
                const response = await fetch(`/api/Transactions/${id}`, {
                    headers: { Authorization: "Bearer " + token }
                });

                if (!response.ok) throw new Error();

                const t = await response.json();
                const categories = await loadCategories(t.categoryID);

                openPanel("Edit Transaction", `
                    <form id="editTransactionForm">

                        <div class="transaction-form-group">
                            <label>Amount</label>
                            <input id="editAmount"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   class="transaction-input"
                                   value="${t.amount}"
                                   required>
                        </div>

                        <div class="transaction-form-group">
                            <label>Category</label>
                            <select id="editCategory"
                                    class="transaction-input"
                                    required>
                                ${categories}
                            </select>
                        </div>

                        <div class="transaction-form-group">
                            <label>Type</label>
                            <select id="editType" class="transaction-input">
                                <option value="Expense" ${t.type === "Expense" ? "selected" : ""}>
                                    Expense
                                </option>
                                <option value="Income" ${t.type === "Income" ? "selected" : ""}>
                                    Income
                                </option>
                            </select>
                        </div>

                        <div class="transaction-form-group">
                            <label>Date</label>
                            <input id="editDate"
                                   type="date"
                                   class="transaction-input"
                                   value="${t.date ? t.date.substring(0, 10) : ""}">
                        </div>

                        <div class="transaction-form-group">
                            <label>
                                Notes
                                <span class="transaction-optional">Optional</span>
                            </label>

                            <textarea id="editNotes"
                                      class="transaction-input transaction-textarea"
                                      placeholder="Add a note if you want...">${escapeHtml(t.notes || "")}</textarea>
                        </div>

                        <div id="editError"
                             class="transaction-panel-error"
                             style="display:none;"></div>

                        <button class="transaction-panel-primary">
                            <i class="bi bi-save"></i>
                            Update Transaction
                        </button>

                    </form>
                `);

                document.getElementById("editTransactionForm")
                    .addEventListener("submit", e => updateTransaction(e, id));

            } catch {
                openPanel("Edit Transaction", `
                    <div class="transaction-panel-error">
                        Unable to load transaction.
                    </div>
                `);
            }
        }

        async function updateTransaction(event, id) {
            event.preventDefault();

            const error = document.getElementById("editError");

            const amount = Number(document.getElementById("editAmount").value);
            const categoryID = Number(document.getElementById("editCategory").value);
            const type = document.getElementById("editType").value;
            const date = document.getElementById("editDate").value;
            const notes = document.getElementById("editNotes").value.trim();

            try {
                const response = await fetch(`/api/Transactions/${id}`, {
                    method: "PUT",
                    headers: {
                        "Content-Type": "application/json",
                        Authorization: "Bearer " + token
                    },
                    body: JSON.stringify({
                        amount,
                        categoryID,
                        type,
                        date,
                        notes: notes || null
                    })
                });

                if (!response.ok) throw new Error();

                closePanel();
                loadTransactions();

            } catch {
                error.textContent = "Unable to update transaction.";
                error.style.display = "block";
            }
        }

        function showDeletePanel(id) {
            openPanel("Delete Transaction", `
                <div class="transaction-delete-box">

                    <div class="transaction-delete-icon">
                        <i class="bi bi-trash-fill"></i>
                    </div>

                    <h3>Delete Transaction?</h3>

                    <p>
                        Are you sure you want to delete this transaction?
                    </p>

                    <div class="transaction-delete-actions">

                        <button type="button"
                                class="transaction-panel-cancel"
                                onclick="closePanel()">
                            Cancel
                        </button>

                        <button type="button"
                                class="transaction-panel-danger"
                                onclick="deleteTransaction(${id})">
                            <i class="bi bi-trash"></i>
                            Delete
                        </button>

                    </div>
                </div>
            `);
        }

        async function deleteTransaction(id) {
            try {
                const response = await fetch(`/api/Transactions/${id}`, {
                    method: "DELETE",
                    headers: { Authorization: "Bearer " + token }
                });

                if (!response.ok) throw new Error();

                closePanel();
                loadTransactions();

            } catch {
                openPanel("Delete Transaction", `
                    <div class="transaction-panel-error">
                        Unable to delete transaction.
                    </div>
                `);
            }
        }

        loadTransactions();
    </script>
}