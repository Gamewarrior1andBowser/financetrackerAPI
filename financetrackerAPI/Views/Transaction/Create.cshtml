@{
    ViewData["Title"] = "Create Transaction";
}

<div class="transaction-page">

    <div class="transaction-header">
        <div>
            <h1 class="transaction-title">
                <i class="bi bi-receipt me-2"></i>
                Add Transaction
            </h1>
            <p class="transaction-description">
                Add a new transaction to your account.
            </p>
        </div>
    </div>

    <div class="transaction-content">
        <div class="transaction-form-card">

            <form id="createTransactionForm">

                <div class="transaction-form-group">
                    <label for="amount">Amount</label>
                    <input id="amount"
                           type="number"
                           min="0.01"
                           step="0.01"
                           class="transaction-input"
                           placeholder="Enter amount"
                           required>
                </div>

                <div class="transaction-form-group">
                    <label for="categoryID">Category</label>
                    <select id="categoryID"
                            class="transaction-input"
                            required>
                        <option value="">Loading categories...</option>
                    </select>
                </div>

                <div class="transaction-form-group">
                    <label for="type">Type</label>
                    <select id="type" class="transaction-input">
                        <option value="Expense">Expense</option>
                        <option value="Income">Income</option>
                    </select>
                </div>

                <div class="transaction-form-group">
                    <label for="date">Date</label>
                    <input id="date"
                           type="date"
                           class="transaction-input"
                           required>
                </div>

                <div class="transaction-form-group">
                    <label for="notes">
                        Notes
                        <span class="transaction-optional">Optional</span>
                    </label>
                    <textarea id="notes"
                              class="transaction-input transaction-textarea"
                              placeholder="Add a note if you want..."></textarea>
                </div>

                <div id="createError"
                     class="transaction-panel-error"
                     style="display:none;">
                </div>

                <div class="transaction-form-actions">
                    <button type="submit"
                            class="transaction-panel-primary">
                        <i class="bi bi-check-circle"></i>
                        Save Transaction
                    </button>

                    <a asp-controller="TransactionPage"
                       asp-action="Index"
                       class="transaction-panel-cancel">
                        <i class="bi bi-arrow-left"></i>
                        Back
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        const token = localStorage.getItem("token");

        document.getElementById("date").value =
            new Date().toISOString().substring(0, 10);

        async function loadCategories() {
            const response = await fetch("/api/Category", {
                headers: {
                    Authorization: "Bearer " + token
                }
            });

            const dropdown = document.getElementById("categoryID");

            if (!response.ok) {
                dropdown.innerHTML = `<option value="">Unable to load categories</option>`;
                return;
            }

            const categories = await response.json();

            if (!categories.length) {
                dropdown.innerHTML = `<option value="">No categories available</option>`;
                return;
            }

            dropdown.innerHTML =
                `<option value="">Select a category</option>` +
                categories.map(c =>
                    `<option value="${c.categoryID}">${c.name}</option>`
                ).join("");
        }

        document
            .getElementById("createTransactionForm")
            .addEventListener("submit", async e => {

                e.preventDefault();

                const error = document.getElementById("createError");

                const amount = Number(
                    document.getElementById("amount").value
                );

                const categoryID = Number(
                    document.getElementById("categoryID").value
                );

                const type =
                    document.getElementById("type").value;

                const date =
                    document.getElementById("date").value;

                const notes =
                    document.getElementById("notes").value.trim();

                error.style.display = "none";

                if (!amount || amount <= 0) {
                    error.textContent = "Please enter a valid amount.";
                    error.style.display = "block";
                    return;
                }

                if (!categoryID) {
                    error.textContent = "Please select a category.";
                    error.style.display = "block";
                    return;
                }

                const response = await fetch("/api/Transactions", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        Authorization: "Bearer " + token
                    },
                    body: JSON.stringify({
                        amount,
                        categoryID,
                        type,
                        date,
                        notes: notes || null
                    })
                });

                if (response.ok) {
                    window.location.href = "/TransactionPage";
                    return;
                }

                error.textContent =
                    await response.text() ||
                    "Unable to create transaction.";

                error.style.display = "block";
            });

        loadCategories();
    </script>
}