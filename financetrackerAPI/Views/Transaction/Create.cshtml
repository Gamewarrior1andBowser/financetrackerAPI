@{
    ViewData["Title"] = "Create Transaction";
}


<div class="container">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow border-0 p-4">


                <h2 class="mb-4 fw-bold">

                    <i class="bi bi-plus-circle-fill me-2"></i>

                    Add Transaction

                </h2>


                <div class="mb-3">

                    <label class="form-label">
                        Amount
                    </label>


                    <input id="amount"
                           type="number"
                           step="0.01"
                           class="form-control"
                           placeholder="Enter amount" />

                </div>




                <div class="mb-3">

                    <label class="form-label">
                        Type
                    </label>


                    <select id="type"
                            class="form-select">

                        <option value="Income">
                            Income
                        </option>


                        <option value="Expense">
                            Expense
                        </option>

                    </select>


                </div>




                <div class="mb-3">

                    <label class="form-label">
                        Category
                    </label>


                    <select id="categoryID"
                            class="form-select">

                        <option>
                            Loading categories...
                        </option>


                    </select>


                </div>





                <div class="mb-4">

                    <label class="form-label">
                        Date
                    </label>


                    <input id="date"
                           type="date"
                           class="form-control" />


                </div>





                <div class="d-flex gap-2">


                    <button class="btn btn-success"
                            onclick="createTransaction()">

                        <i class="bi bi-check-circle me-1"></i>

                        Save

                    </button>



                    <a asp-controller="TransactionPage"
                       asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left-circle me-1"></i>

                        Back

                    </a>


                </div>


            </div>

        </div>

    </div>

</div>





@section Scripts {


    <script>


        const token = localStorage.getItem("token");


        loadCategories();





        async function loadCategories() {

            const response = await fetch("/api/Category",
                {

                    headers:
                    {
                        "Authorization": "Bearer " + token
                    }

                });



            if (!response.ok) {

                alert("Unable to load categories");

                return;

            }



            const categories = await response.json();



            let options = "";



            categories.forEach(category => {


                options += `

                <option value="${category.categoryID}">

                    ${category.name}

                </option>

                `;


            });



            document.getElementById("categoryID").innerHTML = options;


        }







        async function createTransaction() {


            const amount =
                Number(document.getElementById("amount").value);



            const type =
                document.getElementById("type").value;



            const categoryID =
                Number(document.getElementById("categoryID").value);



            const date =
                document.getElementById("date").value;






            const response = await fetch("/api/Transactions",
                {

                    method: "POST",


                    headers:
                    {

                        "Content-Type": "application/json",

                        "Authorization": "Bearer " + token

                    },



                    body: JSON.stringify(
                        {

                            amount: amount,

                            type: type,

                            categoryID: categoryID,

                            date: date

                        })


                });






            if (response.ok) {

                window.location.href = "/TransactionPage";

            }

            else {

                const error = await response.text();

                alert(error);

            }


        }


    </script>


    <script src="~/js/authGuard.js"></script>


}