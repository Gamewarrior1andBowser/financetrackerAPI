@{
    ViewData["Title"] = "Create Transaction";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow p-4">

                <h2 class="mb-4">
                    <i class="bi bi-plus-circle-fill me-2"></i>
                    Add Transaction
                </h2>

                <div class="mb-3">
                    <label class="form-label">Amount</label>
                    <input id="amount" type="number" step="0.01" class="form-control" placeholder="Enter amount" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select id="categoryID" class="form-select"></select>
                </div>

                <div class="mb-4">
                    <label class="form-label">Date</label>
                    <input id="date" type="date" class="form-control" />
                </div>

                <div id="budgetPopup" class="alert alert-danger" style="display:none;"></div>

                <div class="d-flex gap-2">
                    <button class="btn btn-success" onclick="createTransaction()">
                        <i class="bi bi-check-circle me-1"></i>
                        Save
                    </button>

                    <a asp-controller="TransactionPage" asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle me-1"></i>
                        Back
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>

const token = localStorage.getItem("token");

loadCategories();

async function loadCategories() {

    const response = await fetch("/api/Category", {
        headers: { "Authorization": "Bearer " + token }
    });

    const categories = await response.json();
    const dropdown = document.getElementById("categoryID");

    if (categories.length === 0) {
        dropdown.innerHTML = `<option value="">No categories available</option>`;
        return;
    }

    let options = "";
    categories.forEach(category => {
        options += `<option value="${category.categoryID}">${category.name}</option>`;
    });

    dropdown.innerHTML = options;
}

function showBudgetPopup(message) {
    const box = document.getElementById("budgetPopup");
    box.innerText = message;
    box.style.display = "block";
}

function hideBudgetPopup() {
    document.getElementById("budgetPopup").style.display = "none";
}


async function getBudgetStatus(categoryID, excludeTransactionID) {

    const [budgetsRes, transactionsRes] = await Promise.all([
        fetch("/api/Budget", { headers: { "Authorization": "Bearer " + token } }),
        fetch("/api/Transactions", { headers: { "Authorization": "Bearer " + token } })
    ]);

    const budgets = budgetsRes.ok ? await budgetsRes.json() : [];
    const transactions = transactionsRes.ok ? await transactionsRes.json() : [];

    const budget = budgets.find(b => b.categoryID === categoryID);

    const spent = transactions
        .filter(t => t.categoryID === categoryID && t.transactionsID !== excludeTransactionID)
        .reduce((sum, t) => sum + t.amount, 0);

    if (!budget) {
        return { hasBudget: false, limit: 0, spent: spent, remaining: null };
    }

    return { hasBudget: true, limit: budget.limit, spent: spent, remaining: budget.limit - spent };
}

async function createTransaction() {

    hideBudgetPopup();

    const categoryID = Number(document.getElementById("categoryID").value);
    const amount = Number(document.getElementById("amount").value);

    if (!categoryID) {
        showBudgetPopup("Please create a category first.");
        return;
    }

    if (!amount || amount <= 0) {
        showBudgetPopup("Please enter an amount greater than 0.");
        return;
    }

    const status = await getBudgetStatus(categoryID, null);

    if (status.hasBudget && amount > status.remaining) {
        showBudgetPopup(
            "This transaction cannot go through because it would put this category over its budget. " +
            "Please enter an amount less than or equal to $" + Math.max(status.remaining, 0).toFixed(2) + "."
        );
        return;
    }

    const transaction = {
        amount: amount,
        categoryID: categoryID,
        date: document.getElementById("date").value
    };

    const response = await fetch("/api/Transactions", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "Authorization": "Bearer " + token
        },
        body: JSON.stringify(transaction)
    });

    if (response.ok) {
        window.location.href = "/TransactionPage";
    } else {
        const error = await response.text();
        showBudgetPopup(error || "Unable to create transaction.");
    }
}

</script>
}
