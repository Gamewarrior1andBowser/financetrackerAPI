@{
    ViewData["Title"] = "Create Transaction";
}

<div class="transaction-page">

    <div class="transaction-header">

        <div>
            <h1 class="transaction-title">
                <i class="bi bi-plus-circle"></i>
                Add Transaction
            </h1>

            <p class="transaction-description">
                Create a new transaction.
            </p>
        </div>

    </div>

    <div class="transaction-card transaction-form-card">

        <form id="createTransactionForm">

            <div class="transaction-form-group">

                <label>Amount</label>

                <input id="amount"
                       type="number"
                       min="0.01"
                       step="0.01"
                       class="transaction-input"
                       required>

            </div>

            <div class="transaction-form-group">

                <label>Category</label>

                <select id="categoryID"
                        class="transaction-input"
                        required>

                    <option value="">
                        Loading categories...
                    </option>

                </select>

            </div>

            <div class="transaction-form-group">

                <label>Type</label>

                <select id="type"
                        class="transaction-input">

                    <option value="Expense">
                        Expense
                    </option>

                    <option value="Income">
                        Income
                    </option>

                </select>

            </div>

            <div class="transaction-form-group">

                <label>Date</label>

                <input id="date"
                       type="date"
                       class="transaction-input">

            </div>

            <div class="transaction-form-group">

                <label>
                    Notes
                    <span class="transaction-optional">
                        Optional
                    </span>
                </label>

                <textarea id="notes"
                          class="transaction-input transaction-textarea"
                          placeholder="Add a note if you want..."></textarea>

            </div>

            <div id="createError"
                 class="transaction-panel-error"
                 style="display:none;">
            </div>

            <div class="transaction-form-actions">

                <button type="submit"
                        class="transaction-panel-primary">

                    <i class="bi bi-check-circle"></i>
                    Save Transaction

                </button>

                <a asp-controller="TransactionPage"
                   asp-action="Index"
                   class="transaction-panel-cancel">

                    <i class="bi bi-arrow-left"></i>
                    Back

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <script>

        const token = localStorage.getItem("token");


        async function loadCategories() {

            const dropdown =
                document.getElementById("categoryID");


            const response =
                await fetch("/api/Category", {

                    headers: {
                        "Authorization": "Bearer " + token
                    }

                });


            if (!response.ok)
                return;


            const categories =
                await response.json();


            dropdown.innerHTML = `
                <option value="">
                    Select a category
                </option>
            `;


            categories.forEach(category => {

                dropdown.innerHTML += `

                    <option value="${category.categoryID}">
                        ${category.name}
                    </option>

                `;

            });

        }


        document
            .getElementById("createTransactionForm")
            .addEventListener("submit", async function(event) {

                event.preventDefault();


                const amount =
                    Number(
                        document.getElementById("amount").value
                    );


                const categoryID =
                    Number(
                        document.getElementById("categoryID").value
                    );


                const type =
                    document.getElementById("type").value;


                const date =
                    document.getElementById("date").value;


                const notes =
                    document.getElementById("notes")
                        .value
                        .trim();


                const error =
                    document.getElementById("createError");


                if (!amount || amount <= 0) {

                    error.textContent =
                        "Please enter a valid amount.";

                    error.style.display = "block";

                    return;

                }




    const transaction = {


        amount: amount,

        categoryID: categoryID,

        date: date || new Date().toISOString()



    };



                    error.textContent =
                        "Please select a category.";

                    error.style.display = "block";

                    return;

                }


                const response =
                    await fetch("/api/Transactions", {

                        method: "POST",

                        headers: {

                            "Content-Type":
                                "application/json",

                            "Authorization":
                                "Bearer " + token

                        },

                        body: JSON.stringify({

                            amount,
                            categoryID,
                            type,
                            date: date
                                ? date
                                : new Date().toISOString(),
                            notes: notes || null

                        })

                    });


                if (response.ok) {

                    window.location.href =
                        "/TransactionPage";

                } else {

                    error.textContent =
                        "Unable to create transaction.";

                    error.style.display = "block";

                }

            });


        loadCategories();

    </script>

}