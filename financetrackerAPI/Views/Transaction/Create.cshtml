@{
    ViewData["Title"] = "Create Transaction";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 p-4">

                <h2 class="mb-4 fw-bold">
                    <i class="bi bi-plus-circle-fill me-2"></i>
                    Add Transaction
                </h2>

                <div class="mb-3">
                    <label class="form-label">Amount</label>
                    <input id="amount"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control"
                           placeholder="Enter amount" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select id="categoryID" class="form-select">
                        <option value="">Loading categories...</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Type</label>
                    <select id="type" class="form-select">
                        <option value="Expense">Expense</option>
                        <option value="Income">Income</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label">Date</label>
                    <input id="date" type="date" class="form-control" />
                </div>

                <div id="createError"
                     class="alert alert-danger"
                     style="display:none;">
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-success" onclick="createTransaction()">
                        <i class="bi bi-check-circle me-1"></i>
                        Save
                    </button>

                    <a asp-controller="TransactionPage"
                       asp-action="Index"
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle me-1"></i>
                        Back
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/authGuard.js"></script>

    <script>
        const token = localStorage.getItem("token");

        function showError(message) {
            const box = document.getElementById("createError");
            box.innerText = message;
            box.style.display = "block";
        }

        async function loadCategories() {
            const response = await fetch("/api/Category", {
                headers: {
                    "Authorization": "Bearer " + token
                }
            });

            if (!response.ok) {
                showError("Unable to load categories.");
                return;
            }

            const categories = await response.json();
            const dropdown = document.getElementById("categoryID");

            dropdown.innerHTML = `
                        <option value="">Select a category</option>
                    `;

            categories.forEach(category => {
                dropdown.innerHTML += `
                            <option value="${category.categoryID}">
                                ${category.name}
                            </option>
                        `;
            });
        }

        async function createTransaction() {
            const amount = Number(document.getElementById("amount").value);
            const categoryID = Number(document.getElementById("categoryID").value);
            const type = document.getElementById("type").value;
            const date = document.getElementById("date").value;

            if (!amount || amount <= 0) {
                showError("Please enter a valid amount.");
                return;
            }

            if (!categoryID) {
                showError("Please select a category.");
                return;
            }

            const transaction = {
                amount,
                categoryID,
                type,
                date: date || new Date().toISOString()
            };

            const response = await fetch("/api/Transactions", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer " + token
                },
                body: JSON.stringify(transaction)
            });

            if (response.ok) {
                window.location.href = "/TransactionPage";
            } else {
                const error = await response.text();
                showError(error || "Unable to create transaction.");
            }
        }

        loadCategories();
    </script>
}