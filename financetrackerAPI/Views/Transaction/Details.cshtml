@{
    ViewData["Title"] = "Edit Transaction";
    var transactionID = ViewData["transactionID"];
}

<div class="transaction-page">

    <div class="transaction-header">
        <div>
            <h1 class="transaction-title">
                <i class="bi bi-pencil-square me-2"></i>
                Edit Transaction
            </h1>
            <p class="transaction-description">
                Update your transaction information.
            </p>
        </div>
    </div>

    <div class="transaction-content">
        <div class="transaction-form-card">

            <form id="editTransactionForm">

                <div class="transaction-form-group">
                    <label for="amount">Amount</label>
                    <input id="amount"
                           type="number"
                           min="0.01"
                           step="0.01"
                           class="transaction-input"
                           required>
                </div>

                <div class="transaction-form-group">
                    <label for="categoryID">Category</label>
                    <select id="categoryID"
                            class="transaction-input"
                            required>
                    </select>
                </div>

                <div class="transaction-form-group">
                    <label for="type">Type</label>
                    <select id="type" class="transaction-input">
                        <option value="Expense">Expense</option>
                        <option value="Income">Income</option>
                    </select>
                </div>

                <div class="transaction-form-group">
                    <label for="date">Date</label>
                    <input id="date"
                           type="date"
                           class="transaction-input"
                           required>
                </div>

                <div class="transaction-form-group">
                    <label for="notes">
                        Notes
                        <span class="transaction-optional">Optional</span>
                    </label>

                    <textarea id="notes"
                              class="transaction-input transaction-textarea"
                              placeholder="Add a note if you want..."></textarea>
                </div>

                <div id="editError"
                     class="transaction-panel-error"
                     style="display:none;">
                </div>

                <div class="transaction-form-actions">

                    <button type="submit"
                            class="transaction-panel-primary">
                        <i class="bi bi-save"></i>
                        Update Transaction
                    </button>

                    <a asp-controller="TransactionPage"
                       asp-action="Index"
                       class="transaction-panel-cancel">
                        <i class="bi bi-arrow-left"></i>
                        Back
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
<script>
const token = localStorage.getItem("token");
const transactionID = @transactionID;

async function loadCategories(selectedID) {

    const response = await fetch("/api/Category", {
        headers: {
            Authorization: "Bearer " + token
        }
    });

    const dropdown = document.getElementById("categoryID");

    if (!response.ok) {
        dropdown.innerHTML =
            `<option value="">Unable to load categories</option>`;
        return;
    }

    const categories = await response.json();

    dropdown.innerHTML =
        `<option value="">Select a category</option>` +
        categories.map(c => `
            <option value="${c.categoryID}"
                ${Number(c.categoryID) === Number(selectedID)
                    ? "selected"
                    : ""}>
                ${c.name}
            </option>
        `).join("");
}

async function loadTransaction() {

    const response = await fetch(
        "/api/Transactions/" + transactionID,
        {
            headers: {
                Authorization: "Bearer " + token
            }
        }
    );

    if (!response.ok) {
        document.getElementById("editError").textContent =
            "Unable to load transaction.";
        document.getElementById("editError").style.display = "block";
        return;
    }

    const transaction = await response.json();

    document.getElementById("amount").value =
        transaction.amount;

    document.getElementById("type").value =
        transaction.type || "Expense";

    document.getElementById("date").value =
        transaction.date
            ? transaction.date.substring(0, 10)
            : "";

    document.getElementById("notes").value =
        transaction.notes || "";

    await loadCategories(transaction.categoryID);
}

document
    .getElementById("editTransactionForm")
    .addEventListener("submit", async e => {

        e.preventDefault();

        const error = document.getElementById("editError");

        const amount = Number(
            document.getElementById("amount").value
        );

        const categoryID = Number(
            document.getElementById("categoryID").value
        );

        const type =
            document.getElementById("type").value;

        const date =
            document.getElementById("date").value;

        const notes =
            document.getElementById("notes").value.trim();

        error.style.display = "none";

        if (!amount || amount <= 0) {
            error.textContent = "Please enter a valid amount.";
            error.style.display = "block";
            return;
        }

        if (!categoryID) {
            error.textContent = "Please select a category.";
            error.style.display = "block";
            return;
        }

        const response = await fetch(
            "/api/Transactions/" + transactionID,
            {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json",
                    Authorization: "Bearer " + token
                },
                body: JSON.stringify({
                    amount,
                    categoryID,
                    type,
                    date,
                    notes: notes || null
                })
            }
        );

        if (response.ok) {
            window.location.href = "/TransactionPage";
            return;
        }

        error.textContent =
            await response.text() ||
            "Unable to update transaction.";

        error.style.display = "block";
    });

loadTransaction();
</script>
}