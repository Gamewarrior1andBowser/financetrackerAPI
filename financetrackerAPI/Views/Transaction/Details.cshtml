@{
    ViewData["Title"] = "Transaction Details";
    var transactionID = ViewData["transactionID"];
}

<div class="transaction-page">

    <div class="transaction-header">

        <div>

            <h1 class="transaction-title">

                <i class="bi bi-receipt"></i>
                Transaction Details

            </h1>

            <p class="transaction-description">
                View transaction information.
            </p>

        </div>

    </div>


    <div class="transaction-card transaction-form-card">

        <div class="transaction-detail">

            <div class="transaction-detail-icon">

                <i class="bi bi-receipt"></i>

            </div>


            <div class="transaction-detail-block">

                <span>Amount</span>

                <strong id="amount">
                    Loading...
                </strong>

            </div>


            <div class="transaction-detail-block">

                <span>Category</span>

                <strong id="category">
                    Loading...
                </strong>

            </div>


            <div class="transaction-detail-block">

                <span>Type</span>

                <strong id="type">
                    Loading...
                </strong>

            </div>


            <div class="transaction-detail-block">

                <span>Date</span>

                <strong id="date">
                    Loading...
                </strong>

            </div>


            <div class="transaction-detail-block">

                <span>Notes</span>

                <strong id="notes"
                        class="transaction-notes-value">

                    Loading...

                </strong>

            </div>


            <div class="transaction-detail-actions">

                <a asp-controller="TransactionPage"
                   asp-action="Index"
                   class="transaction-panel-cancel">

                    <i class="bi bi-arrow-left"></i>
                    Back

                </a>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        const token = localStorage.getItem("token");

        const transactionID =
            @transactionID;


        async function loadDetails() {

            try {

                const response =
                    await fetch(
                        "/api/Transactions/" + transactionID,
                        {
                            headers: {
                                "Authorization":
                                    "Bearer " + token
                            }
                        }
                    );


                if (!response.ok)
                    throw new Error();


                const transaction =
                    await response.json();


                const amount =
                    Number(transaction.amount) || 0;


                document.getElementById("amount")
                    .textContent =
                    "$" + amount.toFixed(2);


                document.getElementById("category")
                    .textContent =
                    transaction.categoryName ||
                    "No Category";


                document.getElementById("type")
                    .textContent =
                    transaction.type ||
                    "Not Available";


                document.getElementById("date")
                    .textContent =
                    transaction.date
                        ? new Date(transaction.date)
                            .toLocaleDateString()
                        : "Unknown";


                document.getElementById("notes")
                    .textContent =
                    transaction.notes &&
                        transaction.notes.trim()
                        ? transaction.notes
                        : "N/A";


            } catch {

                document.getElementById("amount")
                    .textContent = "Unable to load";

                document.getElementById("category")
                    .textContent = "Unable to load";

                document.getElementById("type")
                    .textContent = "Unable to load";

                document.getElementById("date")
                    .textContent = "Unable to load";

                document.getElementById("notes")
                    .textContent = "N/A";

            }

        }


        loadDetails();

    </script>

}