@{
    ViewData["Title"] = "Transaction Details";
    var transactionID = ViewData["transactionID"];
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow p-4">

                <h2 class="mb-4">
                    <i class="bi bi-receipt me-2"></i>
                    Transaction Details
                </h2>

                <div id="loadError" class="alert alert-danger" style="display:none;"></div>

                <dl class="row" id="detailsBody" style="display:none;">
                    <dt class="col-sm-4">Date</dt>
                    <dd class="col-sm-8" id="txDate"></dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8" id="txCategory"></dd>

                    <dt class="col-sm-4">Amount</dt>
                    <dd class="col-sm-8" id="txAmount"></dd>

                    <dt class="col-sm-4">% of Budget</dt>
                    <dd class="col-sm-8" id="txPercent"></dd>
                </dl>

                <div class="d-flex gap-2" id="actionsRow" style="display:none;">
                    <a asp-controller="TransactionPage" asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle me-1"></i>
                        Back
                    </a>

                    <button class="btn btn-danger" onclick="openDeletePopup()">
                        <i class="bi bi-trash-fill me-1"></i>
                        Delete Transaction
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Delete confirmation popup -->
<div id="deleteOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:2000; align-items:center; justify-content:center;">
    <div class="card shadow p-4" style="max-width:420px;">
        <h4 class="mb-3">
            <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
            Delete Transaction
        </h4>
        <p>Are you sure you want to delete this transaction? This cannot be undone.</p>
        <div class="d-flex gap-2 justify-content-end">
            <button class="btn btn-secondary" onclick="closeDeletePopup()">Cancel</button>
            <button class="btn btn-danger" onclick="confirmDelete()">
                <i class="bi bi-trash-fill me-1"></i>
                Confirm Delete
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>

const token = localStorage.getItem("token");
const transactionID = @transactionID;

loadDetails();

async function loadDetails() {

    const txRes = await fetch("/api/Transactions/" + transactionID, {
        headers: { "Authorization": "Bearer " + token }
    });

    if (!txRes.ok) {
        document.getElementById("loadError").innerText = "Unable to load transaction.";
        document.getElementById("loadError").style.display = "block";
        return;
    }

    const transaction = await txRes.json();

    const budgetsRes = await fetch("/api/Budget", {
        headers: { "Authorization": "Bearer " + token }
    });
    const budgets = budgetsRes.ok ? await budgetsRes.json() : [];
    const budget = budgets.find(b => b.categoryID === transaction.categoryID);

    const percent = budget && budget.limit > 0
        ? Math.round((transaction.amount / budget.limit) * 100)
        : null;

    document.getElementById("txDate").innerText = transaction.date.substring(0, 10);
    document.getElementById("txCategory").innerText = transaction.categoryName ?? "No Category";
    document.getElementById("txAmount").innerText = "$" + transaction.amount.toFixed(2);
    document.getElementById("txPercent").innerText = percent !== null ? percent + "%" : "No budget found";

    document.getElementById("detailsBody").style.display = "flex";
    document.getElementById("actionsRow").style.display = "flex";
}

function openDeletePopup() {
    document.getElementById("deleteOverlay").style.display = "flex";
}

function closeDeletePopup() {
    document.getElementById("deleteOverlay").style.display = "none";
}

async function confirmDelete() {

    const response = await fetch("/api/Transactions/" + transactionID, {
        method: "DELETE",
        headers: { "Authorization": "Bearer " + token }
    });

    if (response.ok) {
        window.location.href = "/TransactionPage";
    } else {
        closeDeletePopup();
        alert("Unable to delete transaction");
    }
}

</script>
}
