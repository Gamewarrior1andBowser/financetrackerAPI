@{
ViewData["Title"] = "Home";
}


<div class="container">


    <!-- Hero Section -->

    <div class="row align-items-center py-5">


        <div class="col-md-6">


            <h1 class="display-4 fw-bold text-primary">

                <i class="bi bi-wallet2 me-2"></i>

                Finance Tracker

            </h1>


            <p class="lead mt-3">

                Manage your income, expenses, budgets, and financial goals easily with one simple platform.

            </p>


            <p class="mt-4 text-muted">

                Explore how Finance Tracker helps users organize their money,
                analyze spending habits, and make better financial decisions.

            </p>


        </div>



        <div class="col-md-6">


            <div class="card shadow border-0 p-4">


                <h3 class="fw-bold">

                    Why use Finance Tracker?

                </h3>


                <p>

                    Track transactions, organize categories, manage budgets,
                    and understand your financial habits through detailed reports.

                </p>


            </div>


        </div>


    </div>





    <!-- Features -->


    <div class="row mt-5">


        <div class="col-md-4 mb-4">


            <div class="card shadow border-0 h-100">


                <div class="card-body text-center">


                    <i class="bi bi-cash-stack text-success"
                       style="font-size:50px;">
                    </i>


                    <h4 class="mt-3">

                        Track Transactions

                    </h4>


                    <p>

                        Record and monitor income and expenses.

                    </p>


                </div>


            </div>


        </div>





        <div class="col-md-4 mb-4">


            <div class="card shadow border-0 h-100">


                <div class="card-body text-center">


                    <i class="bi bi-tags-fill text-primary"
                       style="font-size:50px;">
                    </i>


                    <h4 class="mt-3">

                        Manage Categories

                    </h4>


                    <p>

                        Organize financial activities into meaningful categories.

                    </p>


                </div>


            </div>


        </div>





        <div class="col-md-4 mb-4">


            <div class="card shadow border-0 h-100">


                <div class="card-body text-center">


                    <i class="bi bi-bar-chart-fill text-warning"
                       style="font-size:50px;">
                    </i>


                    <h4 class="mt-3">

                        Financial Reports

                    </h4>


                    <p>

                        Analyze spending patterns and financial progress.

                    </p>


                </div>


            </div>


        </div>


    </div>





    <!-- Demo Preview -->


    <div class="mt-5">


        <h2 class="text-center fw-bold mb-4">

            Finance Tracker Preview

        </h2>


        <p class="text-center text-muted">

            This is an example of how your dashboard will look after creating an account.

        </p>


    </div>





    <!-- Summary Cards -->


    <div class="row g-4 mt-3">


        <div class="col-md-4">


            <div class="card shadow border-0 text-center p-4">


                <h5>

                    Total Income

                </h5>


                <h2 class="text-success"
                    id="income">

                    $0

                </h2>


            </div>


        </div>





        <div class="col-md-4">


            <div class="card shadow border-0 text-center p-4">


                <h5>

                    Total Expenses

                </h5>


                <h2 class="text-danger"
                    id="expenses">

                    $0

                </h2>


            </div>


        </div>





        <div class="col-md-4">


            <div class="card shadow border-0 text-center p-4">


                <h5>

                    Remaining Balance

                </h5>


                <h2 class="text-primary"
                    id="balance">

                    $0

                </h2>


            </div>


        </div>


    </div>

    <!-- Budget and Savings Preview -->


    <div class="row mt-5">


        <div class="col-md-6">


            <div class="card shadow border-0 p-4">


                <h3>

                    <i class="bi bi-wallet2 me-2"></i>

                    Budget Preview

                </h3>


                <hr />


                <p>

                    Monthly Budget:

                    <strong id="budgetLimit">
                        $0
                    </strong>

                </p>



                <p>

                    Amount Used:

                    <strong id="budgetUsed">
                        $0
                    </strong>

                </p>



                <p>

                    Remaining:

                    <strong class="text-success"
                            id="budgetRemaining">
                        $0
                    </strong>

                </p>


            </div>


        </div>





        <div class="col-md-6">


            <div class="card shadow border-0 p-4">


                <h3>

                    <i class="bi bi-piggy-bank-fill me-2"></i>

                    Savings Goal

                </h3>


                <hr />


                <p>

                    Goal Amount:

                    <strong id="savingGoal">
                        $0
                    </strong>

                </p>



                <p>

                    Current Savings:

                    <strong class="text-primary"
                            id="savingCurrent">
                        $0
                    </strong>

                </p>


            </div>


        </div>


    </div>



    <!-- Demo Transactions -->


    <div class="card shadow border-0 mt-5 p-4">


        <h3>

            Recent Transactions Preview

        </h3>


        <table class="table table-hover mt-3">


            <thead>

                <tr>

                    <th>Date</th>

                    <th>Category</th>

                    <th>Type</th>

                    <th>Amount</th>

                </tr>

            </thead>


            <tbody id="demoTransactions">
            </tbody>


        </table>


    </div>


</div>





@section Scripts {


    <script>


        async function loadDemoData() {


            const response = await fetch("/data/demo-data.json");


            const data = await response.json();



            document.getElementById("income").innerHTML =
                "$" + data.income;



            document.getElementById("expenses").innerHTML =
                "$" + data.expenses;



            document.getElementById("balance").innerHTML =
                "$" + data.balance;

            document.getElementById("budgetLimit").innerHTML =
                "$" + data.budget.monthlyLimit;


            document.getElementById("budgetUsed").innerHTML =
                "$" + data.budget.used;


            document.getElementById("budgetRemaining").innerHTML =
                "$" + data.budget.remaining;



            document.getElementById("savingGoal").innerHTML =
                "$" + data.savingsGoal.goal;


            document.getElementById("savingCurrent").innerHTML =
                "$" + data.savingsGoal.current;

            let rows = "";



            data.transactions.forEach(transaction => {


                rows += `

                        <tr>

                            <td>${transaction.date}</td>

                            <td>${transaction.category}</td>

                            <td>${transaction.type}</td>

                            <td>$${transaction.amount}</td>

                        </tr>

                        `;


            });



            document.getElementById("demoTransactions").innerHTML = rows;


        }



        loadDemoData();


    </script>


}