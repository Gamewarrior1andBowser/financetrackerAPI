@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6">

                <h1 class="display-4 fw-bold text-primary">
                    Take Control of Your Finances
                </h1>

                <p class="lead mt-3">
                    Finance Tracker helps you manage income, expenses, budgets,
                    and financial goals in one simple and secure application.
                </p>

                <div class="mt-4">

                    <a asp-controller="AuthPage"
                       asp-action="Login"
                       class="btn btn-primary btn-lg me-2">

                        Login

                    </a>

                    <a asp-controller="AuthPage"
                       asp-action="Register"
                       class="btn btn-outline-primary btn-lg">

                        Register

                    </a>

                </div>

            </div>


            <div class="col-lg-6 text-center">

                <img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png"
                     class="img-fluid"
                     style="max-height:350px;"
                     alt="Finance Illustration" />

            </div>

        </div>
    </div>
</section>


<!-- Features Section -->
<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                Features
            </h2>

            <p class="text-muted">
                Everything you need to manage your money efficiently.
            </p>

        </div>


        <div class="row g-4">

            <div class="col-md-4">

                <div class="card h-100 shadow-sm border-0 text-center p-4">

                    <div class="display-4">💰</div>

                    <h4 class="mt-3">
                        Track Transactions
                    </h4>

                    <p class="text-muted">
                        Record income and expenses to monitor your financial activity.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card h-100 shadow-sm border-0 text-center p-4">

                    <div class="display-4">📂</div>

                    <h4 class="mt-3">
                        Organize Categories
                    </h4>

                    <p class="text-muted">
                        Group transactions into categories for better financial insights.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card h-100 shadow-sm border-0 text-center p-4">

                    <div class="display-4">📊</div>

                    <h4 class="mt-3">
                        Manage Budgets
                    </h4>

                    <p class="text-muted">
                        Set spending limits and track progress toward your goals.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- CTA Section -->
<section class="py-5 bg-primary text-white text-center">

    <div class="container">

        <h2 class="fw-bold">
            Start Managing Your Money Today
        </h2>

        <p class="mt-3">
            Create your account and take the first step toward better financial control.
        </p>

        <a asp-controller="AuthPage"
           asp-action="Register"
           class="btn btn-light btn-lg mt-3">

            Get Started

        </a>

    </div>

</section>