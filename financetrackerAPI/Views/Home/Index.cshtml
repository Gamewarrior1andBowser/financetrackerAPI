@{
    ViewData["Title"] = "Home";
}

<div class="container home-page">

    <!-- HERO -->
    <div class="home-hero">
        <div class="hero-copy">
            <span class="hero-badge"><i class="bi bi-wallet2"></i> Personal Finance, Simplified</span>
            <h1>Finance Tracker</h1>
            <p class="hero-lead">Manage your income, expenses, budgets, and financial goals easily with one simple platform.</p>
            <p class="hero-sub">Track transactions, organize categories, manage budgets, and understand your financial habits through detailed reports.</p>
            <div class="hero-cta">
                <a asp-controller="AuthPage" asp-action="Register" class="btn-hero-primary">
                    Get Started <i class="bi bi-arrow-right"></i>
                </a>
                <a asp-controller="AuthPage" asp-action="Login" class="btn-hero-ghost">
                    Log In
                </a>
            </div>
        </div>
        <div class="hero-visual">
            <i class="bi bi-wallet2"></i>
        </div>
    </div>

    <!-- FEATURES -->
    <div>
        <div class="section-head" style="margin-bottom:32px">
            <span class="section-eyebrow">Why Finance Tracker</span>
            <h2>Everything you need to stay on top of your money</h2>
        </div>
        <div class="feature-grid">
            <div class="feature-card track">
                <div class="feature-icon"><i class="bi bi-cash-stack"></i></div>
                <h4>Track Transactions</h4>
                <p>Record and monitor income and expenses.</p>
            </div>
            <div class="feature-card categorize">
                <div class="feature-icon"><i class="bi bi-tags-fill"></i></div>
                <h4>Manage Categories</h4>
                <p>Organize financial activity into meaningful categories.</p>
            </div>
            <div class="feature-card report">
                <div class="feature-icon"><i class="bi bi-bar-chart-fill"></i></div>
                <h4>Financial Reports</h4>
                <p>Analyze spending patterns and financial progress.</p>
            </div>
        </div>
    </div>

    <!-- PREVIEW -->
    <div>
        <div class="section-head" style="margin-bottom:28px">
            <span class="section-eyebrow">See it in action</span>
            <h2>Finance Tracker Preview</h2>
            <p>This is an example of how your dashboard will look after creating an account.</p>
        </div>

        <div class="preview-summary" style="margin-bottom:20px">
            <div class="preview-card income">
                <span>Total Income</span>
                <strong id="income">$0</strong>
            </div>
            <div class="preview-card expenses">
                <span>Total Expenses</span>
                <strong id="expenses">$0</strong>
            </div>
            <div class="preview-card balance">
                <span>Remaining Balance</span>
                <strong id="balance">$0</strong>
            </div>
        </div>

        <div class="preview-panels" style="margin-bottom:20px">
            <div class="preview-panel">
                <h3><i class="bi bi-wallet2"></i> Budget Preview</h3>
                <div class="preview-row"><span>Monthly Budget</span><strong id="budgetlimits">$0</strong></div>
                <div class="preview-row"><span>Amount Used</span><strong id="budgetUsed">$0</strong></div>
                <div class="preview-row"><span>Remaining</span><strong class="positive" id="budgetRemaining">$0</strong></div>
                <div class="preview-row"><span>Percentage Used</span><strong class="accent" id="budgetPercentage">0%</strong></div>
            </div>

            <div class="preview-panel">
                <h3><i class="bi bi-piggy-bank-fill"></i> Savings Goal</h3>
                <div class="preview-row"><span>Goal Amount</span><strong id="savingGoal">$0</strong></div>
                <div class="preview-row"><span>Current Savings</span><strong class="accent" id="savingCurrent">$0</strong></div>
                <div class="preview-row"><span>Remaining</span><strong id="savingRemaining">$0</strong></div>
                <div class="preview-row"><span>Progress</span><strong class="positive" id="savingProgress">0%</strong></div>
            </div>
        </div>

        <div class="preview-table-card">
            <h3>Recent Transactions Preview</h3>
            <table class="preview-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody id="demoTransactions"></tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {

    <script>

        async function loadDemoData() {

            const response = await fetch("/data/demo-data.json");

            const data = await response.json();

            document.getElementById("income").innerHTML =
                "$" + data.income;

            document.getElementById("expenses").innerHTML =
                "$" + data.expenses;

            document.getElementById("balance").innerHTML =
                "$" + data.balance;

            document.getElementById("budgetlimits").innerHTML =
                "$" + data.budget.monthlylimits;

            document.getElementById("budgetUsed").innerHTML =
                "$" + data.budget.used;

            document.getElementById("budgetRemaining").innerHTML =
                "$" + data.budget.remaining;

            document.getElementById("budgetPercentage").innerHTML =
                data.budget.usagePercentage + "%";

            document.getElementById("savingGoal").innerHTML =
                "$" + data.savingsGoal.goal;

            document.getElementById("savingCurrent").innerHTML =
                "$" + data.savingsGoal.current;

            document.getElementById("savingRemaining").innerHTML =
                "$" + data.savingsGoal.remaining;

            document.getElementById("savingProgress").innerHTML =
                data.savingsGoal.progress + "%";

            let rows = "";

            data.transactions.forEach(transaction => {

                const typeClass =
                    (transaction.type || "").toLowerCase() === "income"
                        ? "income"
                        : "expense";

                rows += `
                            <tr>
                                <td>${transaction.date}</td>
                                <td>${transaction.category}</td>
                                <td><span class="type-chip ${typeClass}">${transaction.type}</span></td>
                                <td>$${transaction.amount}</td>
                            </tr>
                        `;

            });

            document.getElementById("demoTransactions").innerHTML = rows;

        }

        loadDemoData();

    </script>

}
