@{
    ViewData["Title"] = "Home";
}

<div class="home-page">

    <section class="home-hero">
        <div class="home-hero-text">
            <span class="home-badge">
                <i class="bi bi-stars"></i> Built for everyday budgets
            </span>

            <h1>Know exactly where your money goes.</h1>

            <p class="home-hero-lead">
                Finance Tracker turns scattered spending into a clear picture —
                log transactions, set budgets, and watch your savings goals
                move in the right direction.
            </p>

            <div class="home-hero-actions">
                <a asp-controller="AuthPage" asp-action="Register"
                   class="home-btn home-btn-primary">
                    <i class="bi bi-rocket-takeoff-fill me-2"></i> Get Started Free
                </a>

                <a asp-controller="AuthPage" asp-action="Login"
                   class="home-btn home-btn-ghost">
                    Sign In
                </a>
            </div>
        </div>

        <div class="home-hero-card">
            <h3>Why people stick with it</h3>
            <p>
                No spreadsheets, no guesswork — just a running total of what's
                coming in, what's going out, and what's left over.
            </p>

            <ul class="home-hero-points">
                <li><i class="bi bi-check-circle-fill"></i> Every transaction in one place</li>
                <li><i class="bi bi-check-circle-fill"></i> Budgets that warn you before you overspend</li>
                <li><i class="bi bi-check-circle-fill"></i> Savings goals you can actually see progress on</li>
            </ul>
        </div>
    </section>

    <section class="home-feature-grid">

        <a asp-controller="AuthPage" asp-action="Register">
            <div class="home-feature-card">
                <div class="home-feature-icon purple">
                    <i class="bi bi-receipt me-2"></i>
                </div>
                <h4>Track Transactions</h4>
                <p>Add income and expenses as they happen, so nothing slips through the cracks.</p>
            </div>
        </a>

        <a asp-controller="AuthPage" asp-action="Register">
            <div class="home-feature-card">
                <div class="home-feature-icon amber">
                    <i class="bi bi-tags-fill"></i>
                </div>
                <h4>Sort Category</h4>
                <p>Group spending into categories that actually mean something to you.</p>
            </div>
        </a>

        <a asp-controller="AuthPage" asp-action="Register">
            <div class="home-feature-card">
                <div class="home-feature-icon blue">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>
                <h4>Finanace Reports</h4>
                <p>Reports and trends make it easy to spot habits before they become problems.</p>
            </div>
        </a>

    </section>

<!-- PREVIEW INTRO -->
    <section class="home-preview-intro">
        <h2>Take a look inside</h2>
        <p>A sample of what your dashboard looks like once your data is in.</p>
    </section>

    <!-- SUMMARY CARDS -->
    <section class="home-summary-cards">

        <div class="home-summary-card income reveal-left">
            <span>Total Income</span>
            <strong id="income">$0</strong>
        </div>

        <div class="home-summary-card expense reveal-left">
            <span>Total Expenses</span>
            <strong id="expenses">$0</strong>
        </div>

        <div class="home-summary-card balance reveal-left">
            <span>Remaining Balance</span>
            <strong id="balance">$0</strong>
        </div>

    </section>

    <!-- CATEGORY CHART PREVIEW -->
    @* <section class="home-chart-card reveal-left">
        <h3><i class="bi bi-pie-chart-fill me-2"></i>Spend by Category Preview</h3>
        <hr />

        <div class="home-chart-layout">
            <div class="home-chart-container">
                <canvas id="demoCategoryChart"></canvas>
            </div>
            <div id="demoCategoryLegend" class="home-chart-legend"></div>
        </div>
    </section> *@

    <!-- DEMO TRANSACTIONS -->
    <section class="home-table-card reveal-left">
        <h3>Recent Transactions Preview</h3>

        <table class="home-table">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody id="demoTransactions"></tbody>
        </table>
    </section>

</div>
  
@section Scripts {

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        let demoCategoryChartInstance = null;

        async function loadDemoData() {
            const response = await fetch("/data/demo-data.json");
            const data = await response.json();

            document.getElementById("income").innerHTML = "$" + data.income;
            document.getElementById("expenses").innerHTML = "$" + data.expenses;
            document.getElementById("balance").innerHTML = "$" + data.balance;

            let rows = "";

            data.transactions.forEach(transaction => {
                rows += `
                            <tr>
                                <td>${transaction.category}</td>
                                <td>
                                    <span class="home-type-pill ${transaction.type.toLowerCase()}">
                                        ${transaction.type}
                                    </span>
                                </td>
                                <td>$${transaction.amount}</td>
                                <td>${transaction.date}</td>
                            </tr>
                        `;
            });

            document.getElementById("demoTransactions").innerHTML = rows;

            renderDemoCategoryChart(data.transactions);

        }

        function renderDemoCategoryChart(transactions) {

            const categoryTotals = {};

            transactions.forEach(transaction => {

                if (transaction.type.toLowerCase() !== "expense") {
                    return;
                }

                categoryTotals[transaction.category] =
                    (categoryTotals[transaction.category] || 0) + Number(transaction.amount || 0);

            });

            const labels = Object.keys(categoryTotals);
            const values = Object.values(categoryTotals);

            const canvas = document.getElementById("demoCategoryChart");

            if (demoCategoryChartInstance) {
                demoCategoryChartInstance.destroy();
            }

            const palette = [
                "#4f46a5", "#6d5bd0", "#4f86c6",
                "#f59e0b", "#fbbf24", "#9b91df",
                "#7c74d1", "#3f8fd1"
            ];

            demoCategoryChartInstance = new Chart(canvas, {

                type: "doughnut",

                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        backgroundColor: palette,
                        borderWidth: 3,
                        borderColor: "#ffffff"
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "62%",
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return "$" + Number(context.raw).toFixed(2);
                                }
                            }
                        }
                    }
                }

            });

            renderDemoCategoryLegend(labels, values, palette);

        }

        function renderDemoCategoryLegend(labels, values, palette) {

            const legend = document.getElementById("demoCategoryLegend");

            if (labels.length === 0) {
                legend.innerHTML = `<span class="no-chart-data">No expense data</span>`;
                return;
            }

            const total = values.reduce((sum, v) => sum + v, 0);

            legend.innerHTML = labels.map((label, index) => {

                const percentage = total > 0
                    ? (values[index] / total * 100).toFixed(1)
                    : 0;

                return `
                    <div class="legend-item">
                        <span class="legend-dot" style="background:${palette[index % palette.length]}"></span>
                        <span>${label}</span>
                        <strong>$${values[index].toFixed(2)}</strong>
                        (${percentage}%)
                    </div>
                `;

            }).join("");

        }

        loadDemoData();


        function initScrollReveal() {
            const revealEls = document.querySelectorAll(".reveal-left");

            const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (prefersReducedMotion) {
                revealEls.forEach(el => el.classList.add("is-visible"));
                return;
            }

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-visible");
                    } else {
                        entry.target.classList.remove("is-visible");
                    }
                });
            }, {
                threshold: 0.15,
                rootMargin: "0px 0px -50px 0px"
            });

            revealEls.forEach(el => observer.observe(el));
        }

        initScrollReveal();

    </script>
}