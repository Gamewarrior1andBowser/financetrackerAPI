@{
    ViewData["Title"] = "Home";
}

<div class="container">
    <div class="row align-items-center py-5">
        <div class="col-md-6">
            <h1 class="display-4 fw-bold text-primary">
                <i class="bi bi-wallet2 me-2"></i>
                Finance Tracker
            </h1>

            <p class="lead mt-3">
                Manage your income, expenses, budgets, and financial goals easily with one simple platform.
            </p>

            <div class="mt-4">
                <a asp-controller="AuthPage"
                   asp-action="Login"
                   class="btn btn-primary btn-lg me-2">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Login
                </a>

                <a asp-controller="AuthPage"
                   asp-action="Register"
                   class="btn btn-outline-primary btn-lg">

                    <i class="bi bi-person-plus-fill me-2"></i>
                    Register
                </a>
            </div>
        </div>

        <div class="col-md-6 text-center">
            <i class="bi bi-pie-chart-fill text-primary"
               style="font-size: 180px;">
            </i>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 h-100">
                <div class="card-body text-center">
                  
                    <i class="bi bi-cash-stack text-success"
                       style="font-size:50px;">
                    </i>

                    <h4 class="mt-3"> Track Transactions </h4>

                    <p> Record and monitor your income and expenses to understand your spending habits. </p>

                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 h-100">
                <div class="card-body text-center">

                    <i class="bi bi-tags-fill text-primary"
                       style="font-size:50px;">
                    </i>

                    <h4 class="mt-3">  Manage Categories </h4>



                    <p> Organize transactions into categories for better financial tracking. </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 h-100">
                <div class="card-body text-center">

                    <i class="bi bi-wallet-fill text-warning"
                       style="font-size:50px;">
                    </i>


                    <h4 class="mt-3"> Set Budgets </h4>

                    <p> Create budgets and control your monthly spending limits. </p>
                </div>
           </div>
        </div>
    </div>

    <div class="text-center mt-5 mb-5">
        <h3>  <i class="bi bi-bar-chart-fill me-2"></i> Take control of your financial future </h3>

        <p class="text-muted"> Simple tracking, better planning, smarter decisions. </p>
    </div>
</div>