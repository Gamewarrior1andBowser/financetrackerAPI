@{
    ViewData["Title"] = "Register";
}
 
<div class="auth-page">
 
    <div class="auth-card">
 
        <div class="text-center mb-4">
 
            <i class="bi bi-person-plus-fill"
               style="font-size:70px; color:#f59e0b;">
</i>
 
            <h2 class="mt-3">
                Create Account
</h2>
 
            <p class="text-muted">
                Register to start managing your finances
</p>
</div>
 
        <div class="mb-3">
<label class="form-label">
<i class="bi bi-user-fill me-2"></i>
                Username
</label>
<input id="username"
                   type="text"
                   class="form-control"
                   placeholder="Enter your name" />
</div>
 
        <div class="mb-3">
<label class="form-label">
<i class="bi bi-envelope-fill me-2"></i>
                Email
</label>
<input id="email"
                   type="email"
                   class="form-control"
                   placeholder="Enter your email" />
        </div>

        <div class="mb-3 position-relative">
            <label class="form-label">
                <i class="bi bi-lock-fill me-2"></i>
                Password
</label>
<input id="password"
                   type="password"
                   class="form-control"
                   placeholder="Create your password"
                   oninput="checkPasswordStrength(); checkPasswordMatch();" />

            <div id="passwordHint" class="form-text">
                Create a password with a strong mix of figures.
            </div>

            <div id="passwordStrengthError" class="form-text text-danger d-none">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Please choose a stronger password. Try a mix of letters, numbers, and symbols.
            </div>
        </div>

        <div class="mb-4 position-relative">
<label class="form-label">
<i class="bi bi-lock-fill me-2"></i>
                Confirm Password
</label>
<input id="confirmPassword"
                   type="password"
                   class="form-control"
                   placeholder="Re-enter your password"
                   oninput="checkPasswordMatch()" />
 
            <div id="passwordMismatch" class="password-popup">
<i class="bi bi-exclamation-triangle-fill me-2"></i>
                Passwords do not match
</div>
</div>
 
        <button class="btn w-100"
                onclick="register()">
<i class="bi bi-person-check-fill me-2"></i>
            Register
</button>
 
        <hr class="my-4">
 
        <p class="text-center">
            Already have an account?
 
            <a asp-controller="AuthPage"
               asp-action="Login">
 
                <i class="bi bi-box-arrow-in-right"></i>
                Login here
 
            </a>
</p>
 
        <p class="text-center">
<a asp-controller="Home"
               asp-action="Index">
<i class="bi bi-arrow-left-circle"></i>
 
                Back to Home
</a>
</p>
</div>
</div>
 
@section Scripts {

    <script>
        // Returns true if the password fails our strength rules:
        // - must be at least 8 characters
        // - must not consist of a single character repeated throughout
        function isWeakPassword(password) {
            if (password.length < 8) {
                return true;
            }

            const allSameChar = password.split("").every(ch => ch === password[0]);
            if (allSameChar) {
                return true;
            }

            return false;
        }

        // Anchored strictly under #password: toggles between the persistent
        // hint text and the strength error message as the user types.
        function checkPasswordStrength() {
            const password = document.getElementById("password").value;
            const defaultHint = document.getElementById("passwordHint");
            const strengthError = document.getElementById("passwordStrengthError");

            if (password.length === 0) {
                // Nothing typed yet: show the default hint only
                defaultHint.classList.remove("d-none");
                strengthError.classList.add("d-none");
                return;
            }

            if (isWeakPassword(password)) {
                defaultHint.classList.add("d-none");
                strengthError.classList.remove("d-none");
            } else {
                defaultHint.classList.remove("d-none");
                strengthError.classList.add("d-none");
            }
        }

        // Anchored strictly under #confirmPassword: unchanged mismatch popup logic.
        function checkPasswordMatch() {
            const password = document.getElementById("password").value;
            const confirmPassword = document.getElementById("confirmPassword").value;
            const popup = document.getElementById("passwordMismatch");

            if (confirmPassword.length > 0 && password !== confirmPassword) {
                popup.classList.add("show");
            } else {
                popup.classList.remove("show");
            }
        }
 
        async function register() {
            const email = document.getElementById("email").value;
            const username = document.getElementById("username").value;
            const password = document.getElementById("password").value;
            const confirmPassword = document.getElementById("confirmPassword").value;

            // Re-run both validators so any un-triggered state (e.g. user
            // clicked Register without ever typing in a field) still shows.
            checkPasswordStrength();
            checkPasswordMatch();

            if (isWeakPassword(password)) {
                return; // blocked client-side; error already visible under Password
            }

            if (password !== confirmPassword) {
                return; // blocked client-side; mismatch popup already visible
            }
 
            const response = await fetch("/api/Auth/register", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
 
                body: JSON.stringify({
                    email,
                    username,
                    password
                })
            });

            if (response.ok) {
                window.location.href = "/AuthPage/Login";
            } else {
                const message = await response.text();
                alert(message || "Registration failed. Please try again.");
            }
        }
    </script>

}
