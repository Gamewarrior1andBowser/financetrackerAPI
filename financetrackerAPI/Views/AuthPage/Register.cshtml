@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center auth-page mt-5" id="RegisterCard">

    <div class="col-md-5">
        <div class="card shadow border-0 p-4">

            <div class="text-center mb-4">
                <h2 class="fw-bold">
                    <i class="bi bi-person-plus-fill me-2"></i>
                    Create Account
                </h2>
                <p class="text-muted">Register to start managing your finances</p>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    <i class="bi bi-user-fill me-2"></i> Username
                </label>
                <input id="username" type="text" class="form-control"
                       placeholder="Enter your name" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    <i class="bi bi-envelope-fill me-2"></i> Email
                </label>
                <input id="email" type="email" class="form-control"
                       placeholder="Enter your email" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    <i class="bi bi-lock-fill me-2"></i> Password
                </label>

                <input id="password" type="password" class="form-control"
                       placeholder="Create your password"
                       oninput="checkPasswordStrength(); checkPasswordMatch();" />

                <div id="passwordHint" class="form-text">
                    Create a password with a strong mix of figures.
                </div>

                <div id="passwordStrengthError" class="form-text text-danger d-none">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Please choose a stronger password. Try a mix of letters, numbers, and symbols.
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label">
                    <i class="bi bi-lock-fill me-2"></i> Confirm Password
                </label>

                <input id="confirmPassword" type="password" class="form-control"
                       placeholder="Re-enter your password"
                       oninput="checkPasswordMatch()" />

                <div id="passwordMismatch" class="password-popup">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Passwords do not match
                </div>
            </div>

            <button class="btn btn-primary w-100" onclick="register()">
                <i class="bi bi-person-check-fill me-2"></i>
                Register
            </button>

            <hr class="my-4">

            <div class="d-flex justify-content-center align-items-center gap-4">
                <span>
                    Already have an account?
                    <a asp-controller="AuthPage"
                       asp-action="Login" class="btn btn-primary ms-lg-2">

                        <i class="bi bi-box-arrow-in-right"></i>
                        Login here
                    </a>
                </span>

                <a asp-controller="Home"
                   asp-action="Index" class="btn btn-primary ms-lg-1">

                    <i class="bi bi-arrow-left-circle"></i>
                    Back to Home
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function isWeakPassword(password) {
            if (password.length < 8) {
                return true;
            }

            let same = true;

            for (let i = 1; i < password.length; i++) {
                if (password[i] !== password[0]) {
                    same = false;
                    break;
                }
            }

            return same;
        }

        function checkPasswordStrength() {
            const password = document.getElementById("password").value;
            const hint = document.getElementById("passwordHint");
            const error = document.getElementById("passwordStrengthError");

            if (password.length === 0) {
                hint.classList.remove("d-none");
                error.classList.add("d-none");
            } else if (isWeakPassword(password)) {
                hint.classList.add("d-none");
                error.classList.remove("d-none");
            } else {
                hint.classList.remove("d-none");
                error.classList.add("d-none");
            }
        }

        function checkPasswordMatch() {
            const password = document.getElementById("password").value;
            const confirmPassword = document.getElementById("confirmPassword").value;
            const popup = document.getElementById("passwordMismatch");

            if (confirmPassword && password !== confirmPassword) {
                popup.classList.add("show");
            } else {
                popup.classList.remove("show");
            }
        }

        async function register() {
            const username = document.getElementById("username").value;
            const email = document.getElementById("email").value;
            const password = document.getElementById("password").value;
            const confirmPassword = document.getElementById("confirmPassword").value;

            checkPasswordStrength();
            checkPasswordMatch();

            if (isWeakPassword(password)) {
                return;
            }

            if (password !== confirmPassword) {
                return;
            }

            const response = await fetch("/api/Auth/register", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    email: email,
                    username: username,
                    password: password
                })
            });

            if (response.ok) {
                window.location.href = "/AuthPage/Login";
            } else {
                const message = await response.text();
                alert(message || "Registration failed. Please try again.");
            }
        }
    </script>
}